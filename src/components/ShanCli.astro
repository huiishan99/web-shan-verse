---
import type { Locale } from '../i18n/config';
import { defaultLocale, localizePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const cli = t.cli;

const paths = {
  home: localizePath('/', lang),
  about: localizePath('/about', lang),
  projects: localizePath('/projects', lang),
  timeline: localizePath('/timeline', lang),
  blog: localizePath('/blog', lang),
};
---

<div
  class="shan-cli"
  data-shan-cli
  data-lang={lang}
  data-home-path={paths.home}
  data-about-path={paths.about}
  data-projects-path={paths.projects}
  data-timeline-path={paths.timeline}
  data-blog-path={paths.blog}
  data-cli-index-path="/cli-index.json"
  data-cli-labels={JSON.stringify(cli)}
>
  <button type="button" class="cli-trigger" aria-label={cli.open} data-cli-trigger>
    <span>shan&gt;</span>
  </button>

  <div class="cli-overlay" aria-hidden="true" data-cli-overlay>
    <section class="cli-panel" role="dialog" aria-modal="true" aria-label="Shan CLI">
      <div class="cli-topline">
        <span class="cli-dot"></span>
        <span class="cli-title">SHAN CLI</span>
        <button type="button" class="cli-close" aria-label={cli.close} data-cli-close>×</button>
      </div>

      <div class="cli-output" aria-live="polite" data-cli-output>
        <p><span class="cli-muted">{cli.intro}</span></p>
      </div>

      <form class="cli-form" data-cli-form>
        <span class="cli-prompt">shan&gt;</span>
        <input
          type="text"
          autocomplete="off"
          spellcheck="false"
          aria-label={cli.command}
          placeholder={cli.placeholder}
          data-cli-input
        />
      </form>
    </section>
  </div>
</div>

<script>
  import '../scripts/client/shan-cli.js';
</script>

<style>
  .shan-cli {
    position: relative;
    z-index: 180;
  }

  .cli-trigger {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 181;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.78rem;
    border: 1px solid rgba(201, 162, 39, 0.3);
    border-radius: 999px;
    background: rgba(10, 10, 15, 0.68);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.26);
    color: var(--color-brass-light);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0;
    cursor: pointer;
    opacity: 0.72;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease,
      transform 0.2s ease;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .cli-trigger:hover,
  .cli-trigger:focus-visible {
    border-color: rgba(212, 168, 75, 0.7);
    color: var(--color-brass);
    opacity: 1;
    transform: translateY(-1px);
  }

  .cli-overlay {
    position: fixed;
    inset: 0;
    z-index: 182;
    display: grid;
    place-items: start center;
    padding: 12vh var(--space-lg) var(--space-lg);
    background: rgba(0, 0, 0, 0.18);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
  }

  .cli-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .cli-panel {
    width: min(42rem, 100%);
    border: 1px solid rgba(201, 162, 39, 0.28);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(201, 162, 39, 0.1), rgba(201, 162, 39, 0.035)),
      rgba(10, 10, 15, 0.88);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.42), 0 0 30px rgba(201, 162, 39, 0.08);
    color: var(--color-text-secondary);
    overflow: hidden;
    transform: translateY(-0.45rem) scale(0.98);
    transition: transform 0.18s ease;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .cli-overlay.is-open .cli-panel {
    transform: translateY(0) scale(1);
  }

  .cli-topline,
  .cli-form {
    display: flex;
    align-items: center;
  }

  .cli-topline {
    gap: 0.55rem;
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid rgba(201, 162, 39, 0.16);
    font-family: var(--font-mono);
  }

  .cli-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-brass);
    box-shadow: 0 0 14px rgba(201, 162, 39, 0.72);
  }

  .cli-title {
    color: var(--color-text-primary);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }

  .cli-close {
    margin-left: auto;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid rgba(201, 162, 39, 0.22);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.035);
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .cli-output {
    min-height: 8.5rem;
    max-height: 16rem;
    overflow: auto;
    padding: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .cli-output p,
  .cli-output :global(p) {
    margin: 0 0 0.35rem;
  }

  .cli-muted,
  :global(.cli-muted) {
    color: var(--color-text-muted);
  }

  .cli-accent,
  .cli-prompt,
  :global(.cli-accent) {
    color: var(--color-brass-light);
  }

  :global(.cli-help-heading) {
    display: inline-block;
    margin-top: 0.45rem;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  :global(.cli-command) {
    color: var(--color-brass-light);
  }

  :global(.cli-result-link) {
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: 1px solid rgba(201, 162, 39, 0.34);
  }

  :global(.cli-result-link:hover),
  :global(.cli-result-link:focus-visible) {
    color: var(--color-brass-light);
    border-bottom-color: rgba(201, 162, 39, 0.72);
  }

  :global(.cli-result-meta) {
    color: var(--color-text-muted);
    font-size: 0.78em;
  }

  .cli-form {
    gap: 0.55rem;
    padding: 0.75rem 0.9rem;
    border-top: 1px solid rgba(201, 162, 39, 0.16);
    background: rgba(255, 255, 255, 0.025);
    font-family: var(--font-mono);
  }

  .cli-form input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-text-primary);
    font: inherit;
  }

  .cli-form input::placeholder {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .cli-trigger {
      left: 0.75rem;
      bottom: calc(env(safe-area-inset-bottom) + 0.75rem);
      min-height: 2.35rem;
      padding: 0 0.72rem;
      font-size: 0.74rem;
    }

    .shan-cli.is-open .cli-trigger {
      opacity: 0;
      pointer-events: none;
      transform: translateY(0.35rem);
    }

    .cli-overlay {
      align-items: end;
      place-items: end center;
      padding: var(--space-md) var(--space-md) calc(env(safe-area-inset-bottom) + 4.35rem);
      background: rgba(0, 0, 0, 0.28);
    }

    .cli-panel {
      border-radius: 8px;
    }

    .cli-output {
      min-height: 7.5rem;
      max-height: 14rem;
      font-size: 0.8rem;
    }
  }
</style>
