// 获取图标路径，如果不存在则返回 gear 作为默认
const iconPath = icons[name] || icons.gear;

// 确定 fill 属性 - github/linkedin/twitter 需要 fill
const needsFill = ['github', 'linkedin', 'twitter'].includes(name);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={needsFill ? "currentColor" : "none"}
  stroke={needsFill ? "none" : "currentColor"}
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["icon", className]}
  set:html={iconPath}
/>

<style>
  .icon {
    color: var(--color-brass);
    flex-shrink: 0;
  }
</style>
