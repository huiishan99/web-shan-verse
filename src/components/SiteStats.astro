---
interface Props {
  variant?: 'footer' | 'panel';
  eyebrow?: string;
  title?: string;
}

const {
  variant = 'footer',
  eyebrow = 'Site Signal',
  title = 'Live Metrics',
} = Astro.props;

const statsEndpoint = import.meta.env.PUBLIC_SITE_STATS_ENDPOINT
  || (import.meta.env.DEV
    ? 'https://shan-verse-site-stats.huiishan99.workers.dev/api/site-stats'
    : '/api/site-stats');
---

<div class:list={['site-stats', `site-stats--${variant}`]} data-site-stats data-endpoint={statsEndpoint} aria-live="polite">
  {variant === 'panel' && (
    <div class="site-stats-header">
      <span>{eyebrow}</span>
      <strong>{title}</strong>
    </div>
  )}
  <div class="site-stats-grid">
    <span class="site-stat">
      <span class="site-stat-value" data-site-stat="views">--</span>
      <span class="site-stat-label">Views</span>
    </span>
    <span class="site-stat">
      <span class="site-stat-value" data-site-stat="visitors">--</span>
      <span class="site-stat-label">Visitors</span>
    </span>
    <span class="site-stat site-stat--online">
      <span class="site-stat-value" data-site-stat="online">--</span>
      <span class="site-stat-label">Online</span>
    </span>
  </div>
</div>

<script>
  const globalWindow = window as typeof window & {
    __shanSiteStatsReady?: boolean;
    __shanSiteStatsLastPath?: string;
  };

  if (!globalWindow.__shanSiteStatsReady) {
    globalWindow.__shanSiteStatsReady = true;

    const heartbeatMs = 120000;
    let heartbeatTimer = 0;
    let unavailableLogged = false;

    function formatCount(value: unknown): string {
      const numberValue = Number(value);
      if (!Number.isFinite(numberValue) || numberValue < 0) return '--';

      return new Intl.NumberFormat('en-US', {
        notation: numberValue >= 10000 ? 'compact' : 'standard',
        maximumFractionDigits: 1,
      }).format(Math.round(numberValue));
    }

    function updateStats(data: Record<string, unknown>) {
      document.querySelectorAll<HTMLElement>('[data-site-stats]').forEach((root) => {
        root.classList.remove('is-unavailable');

        root.querySelector<HTMLElement>('[data-site-stat="views"]')!.textContent = formatCount(data.views);
        root.querySelector<HTMLElement>('[data-site-stat="visitors"]')!.textContent = formatCount(data.visitors);
        root.querySelector<HTMLElement>('[data-site-stat="online"]')!.textContent = formatCount(data.online);
      });
    }

    function markUnavailable(error: unknown) {
      document.querySelectorAll<HTMLElement>('[data-site-stats]').forEach((root) => {
        root.classList.add('is-unavailable');
      });

      window.clearInterval(heartbeatTimer);
      heartbeatTimer = 0;

      if (!unavailableLogged) {
        console.warn('Site stats unavailable:', error);
        unavailableLogged = true;
      }
    }

    async function sendStatsEvent(eventType: 'pageview' | 'heartbeat') {
      const root = document.querySelector<HTMLElement>('[data-site-stats]');
      const endpoint = root?.dataset.endpoint;
      if (!endpoint) return;

      const path = `${window.location.pathname}${window.location.search}`;
      if (eventType === 'pageview' && globalWindow.__shanSiteStatsLastPath === path) {
        return;
      }

      if (eventType === 'pageview') {
        globalWindow.__shanSiteStatsLastPath = path;
      }

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event: eventType,
            path,
            title: document.title,
          }),
          keepalive: eventType === 'heartbeat',
        });

        if (!response.ok) throw new Error(`Stats request failed with ${response.status}`);
        updateStats(await response.json());
        startHeartbeat();
      } catch (error) {
        markUnavailable(error);
      }
    }

    function trackPageview() {
      sendStatsEvent('pageview');
    }

    function startHeartbeat() {
      if (heartbeatTimer) return;
      window.clearInterval(heartbeatTimer);
      heartbeatTimer = window.setInterval(() => {
        sendStatsEvent('heartbeat');
      }, heartbeatMs);
    }

    trackPageview();
    document.addEventListener('astro:page-load', trackPageview);
  }
</script>

<style>
  .site-stats {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .site-stats--footer {
    margin-top: 0.9rem;
  }

  .site-stats-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem 1rem;
  }

  .site-stats--panel {
    position: relative;
    padding: var(--space-md);
    background:
      linear-gradient(135deg, rgba(106, 171, 255, 0.08), transparent 44%),
      rgba(13, 13, 18, 0.58);
    border: 1px solid rgba(106, 171, 255, 0.2);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .site-stats--panel::before {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid rgba(201, 162, 39, 0.16);
    pointer-events: none;
    transform: translate(0.28rem, 0.28rem);
  }

  .site-stats-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .site-stats-header span {
    color: var(--color-brass);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .site-stats-header strong {
    color: var(--color-text-secondary);
    font-size: 0.72rem;
    font-weight: 500;
  }

  .site-stats--panel .site-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .site-stat {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    min-width: 0;
  }

  .site-stats--panel .site-stat {
    display: grid;
    gap: 0.16rem;
    align-items: start;
    padding: 0.4rem 0.45rem;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .site-stat-value {
    color: var(--color-brass-light);
    font-weight: 500;
    min-width: 2ch;
    text-align: right;
  }

  .site-stats--panel .site-stat-value {
    color: rgba(198, 221, 255, 0.95);
    font-size: clamp(1rem, 2vw, 1.28rem);
    text-align: left;
  }

  .site-stat-label {
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .site-stats--panel .site-stat-label {
    font-size: 0.58rem;
    letter-spacing: 0.1em;
  }

  .site-stat--online .site-stat-value::before {
    content: '';
    display: inline-block;
    width: 0.36rem;
    height: 0.36rem;
    margin-right: 0.35rem;
    border-radius: 50%;
    background: rgba(106, 171, 255, 0.85);
    box-shadow: 0 0 8px rgba(106, 171, 255, 0.35);
    vertical-align: 0.06rem;
  }

  .site-stats.is-unavailable .site-stat-value {
    color: var(--color-text-muted);
  }

  .site-stats.is-unavailable .site-stat--online .site-stat-value::before {
    background: rgba(136, 136, 136, 0.55);
    box-shadow: none;
  }

  @media (max-width: 900px) {
    .site-stats--panel .site-stats-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .site-stats {
      font-size: 0.68rem;
    }

    .site-stats-grid {
      gap: 0.5rem 0.85rem;
    }

    .site-stats--panel {
      padding: var(--space-sm);
    }

    .site-stats-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.18rem;
    }

    .site-stats--panel .site-stats-grid {
      grid-template-columns: 1fr;
    }

    .site-stats--panel .site-stat {
      grid-template-columns: auto 1fr;
      align-items: baseline;
    }
  }
</style>
