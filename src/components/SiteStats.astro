---
interface Props {
  variant?: 'footer' | 'panel';
  eyebrow?: string;
  title?: string;
  labels?: {
    views?: string;
    visitors?: string;
    online?: string;
  };
}

const {
  variant = 'footer',
  eyebrow = 'Site Signal',
  title = 'Live Metrics',
  labels = {},
} = Astro.props;

const statsEndpoint = import.meta.env.PROD
  ? (import.meta.env.PUBLIC_SITE_STATS_ENDPOINT || '')
  : '';
---

<div class:list={['site-stats', `site-stats--${variant}`]} data-site-stats data-endpoint={statsEndpoint} aria-live="polite">
  {variant === 'panel' && (
    <div class="site-stats-header">
      <span>{eyebrow}</span>
      <strong>{title}</strong>
    </div>
  )}
  <div class="site-stats-grid">
    <span class="site-stat">
      <span class="site-stat-value" data-site-stat="views">--</span>
      <span class="site-stat-label">{labels.views || 'Views'}</span>
    </span>
    <span class="site-stat">
      <span class="site-stat-value" data-site-stat="visitors">--</span>
      <span class="site-stat-label">{labels.visitors || 'Visitors'}</span>
    </span>
    <span class="site-stat site-stat--online">
      <span class="site-stat-value" data-site-stat="online">--</span>
      <span class="site-stat-label">{labels.online || 'Online'}</span>
    </span>
  </div>
</div>

<script>
  const globalWindow = window as typeof window & {
    __shanSiteStatsReady?: boolean;
    __shanSiteStatsLastPath?: string;
  };

  if (!globalWindow.__shanSiteStatsReady) {
    globalWindow.__shanSiteStatsReady = true;

    const heartbeatMs = 240000;
    let heartbeatTimer = 0;
    let unavailableLogged = false;

    function formatCount(value: unknown): string {
      const numberValue = Number(value);
      if (!Number.isFinite(numberValue) || numberValue < 0) return '--';

      return new Intl.NumberFormat('en-US', {
        notation: numberValue >= 10000 ? 'compact' : 'standard',
        maximumFractionDigits: 1,
      }).format(Math.round(numberValue));
    }

    function updateStats(data: Record<string, unknown>) {
      document.querySelectorAll<HTMLElement>('[data-site-stats]').forEach((root) => {
        root.classList.remove('is-unavailable');

        root.querySelector<HTMLElement>('[data-site-stat="views"]')!.textContent = formatCount(data.views);
        root.querySelector<HTMLElement>('[data-site-stat="visitors"]')!.textContent = formatCount(data.visitors);
        root.querySelector<HTMLElement>('[data-site-stat="online"]')!.textContent = formatCount(data.online);
      });
    }

    function markUnavailable(error: unknown) {
      document.querySelectorAll<HTMLElement>('[data-site-stats]').forEach((root) => {
        root.classList.add('is-unavailable');
      });

      window.clearInterval(heartbeatTimer);
      heartbeatTimer = 0;

      if (!unavailableLogged) {
        console.warn('Site stats unavailable:', error);
        unavailableLogged = true;
      }
    }

    async function sendStatsEvent(eventType: 'pageview' | 'heartbeat') {
      const root = document.querySelector<HTMLElement>('[data-site-stats]');
      const endpoint = root?.dataset.endpoint;
      if (!endpoint) return;
      if (document.visibilityState === 'hidden') return;

      const path = `${window.location.pathname}${window.location.search}`;
      if (eventType === 'pageview' && globalWindow.__shanSiteStatsLastPath === path) {
        return;
      }

      if (eventType === 'pageview') {
        globalWindow.__shanSiteStatsLastPath = path;
      }

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event: eventType,
            path,
            title: document.title,
          }),
          keepalive: eventType === 'heartbeat',
        });

        if (!response.ok) throw new Error(`Stats request failed with ${response.status}`);
        updateStats(await response.json());
        startHeartbeat();
      } catch (error) {
        markUnavailable(error);
      }
    }

    function trackPageview() {
      sendStatsEvent('pageview');
    }

    function startHeartbeat() {
      if (heartbeatTimer) return;
      window.clearInterval(heartbeatTimer);
      heartbeatTimer = window.setInterval(() => {
        sendStatsEvent('heartbeat');
      }, heartbeatMs);
    }

    trackPageview();
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        sendStatsEvent('heartbeat');
      }
    });
    document.addEventListener('astro:page-load', trackPageview);
  }
</script>

<style>
  .site-stats {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .site-stats--footer {
    margin-top: 0.9rem;
  }

  .site-stats-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem 1rem;
  }

  .site-stats--panel {
    position: relative;
    overflow: hidden;
    padding: 0.95rem 1rem;
    background:
      radial-gradient(circle at 100% 0%, rgba(201, 162, 39, 0.08), transparent 36%),
      linear-gradient(180deg, rgba(22, 22, 30, 0.62), rgba(13, 13, 18, 0.5));
    border: 1px solid var(--color-border);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .site-stats--panel::before {
    content: '';
    position: absolute;
    inset: 0;
    border-left: 2px solid rgba(201, 162, 39, 0.42);
    pointer-events: none;
  }

  .site-stats--panel::after {
    content: '✦';
    position: absolute;
    top: 0.78rem;
    right: 0.85rem;
    color: rgba(201, 162, 39, 0.38);
    font-size: 0.66rem;
    line-height: 1;
    pointer-events: none;
  }

  .site-stats-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: 0.7rem;
    padding-bottom: 0.6rem;
    padding-right: 1.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .site-stats-header span {
    color: var(--color-brass);
    font-family: var(--font-display);
    font-size: 0.76rem;
    letter-spacing: 0;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .site-stats-header strong {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    color: var(--color-text-muted);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
    text-transform: uppercase;
  }

  .site-stats-header strong::before {
    content: '';
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: rgba(201, 162, 39, 0.86);
    box-shadow: 0 0 10px rgba(201, 162, 39, 0.34);
  }

  .site-stats--panel .site-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
  }

  .site-stat {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    min-width: 0;
  }

  .site-stats--panel .site-stat {
    display: grid;
    gap: 0.18rem;
    align-items: start;
    padding-right: 0.7rem;
    background: transparent;
    border: 0;
  }

  .site-stats--panel .site-stat + .site-stat {
    padding-left: 0.75rem;
    border-left: 1px solid rgba(255, 255, 255, 0.07);
  }

  .site-stat-value {
    color: var(--color-brass-light);
    font-weight: 500;
    min-width: 2ch;
    text-align: right;
  }

  .site-stats--panel .site-stat-value {
    color: var(--color-brass-light);
    font-family: var(--font-display);
    font-size: 1.12rem;
    letter-spacing: 0;
    line-height: 1;
    text-align: left;
  }

  .site-stat-label {
    color: var(--color-text-muted);
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .site-stats--panel .site-stat-label {
    color: rgba(200, 200, 200, 0.62);
    font-size: 0.56rem;
    letter-spacing: 0;
  }

  .site-stat--online .site-stat-value::before {
    content: '';
    display: inline-block;
    width: 0.36rem;
    height: 0.36rem;
    margin-right: 0.35rem;
    border-radius: 50%;
    background: rgba(201, 162, 39, 0.86);
    box-shadow: 0 0 8px rgba(201, 162, 39, 0.32);
    vertical-align: 0.06rem;
  }

  .site-stats--panel .site-stat--online .site-stat-value::before {
    width: 0.32rem;
    height: 0.32rem;
    margin-right: 0.34rem;
  }

  .site-stats.is-unavailable .site-stat-value {
    color: var(--color-text-muted);
  }

  .site-stats.is-unavailable .site-stat--online .site-stat-value::before {
    background: rgba(136, 136, 136, 0.55);
    box-shadow: none;
  }

  @media (max-width: 900px) {
    .site-stats--panel .site-stats-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .site-stats {
      font-size: 0.68rem;
    }

    .site-stats-grid {
      gap: 0.5rem 0.85rem;
    }

    .site-stats--panel {
      padding: 0.85rem;
    }

    .site-stats-header {
      gap: 0.5rem;
      margin-bottom: 0.62rem;
      padding-bottom: 0.55rem;
    }

    .site-stats--panel .site-stats-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .site-stats--panel .site-stat {
      padding-right: 0.42rem;
    }

    .site-stats--panel .site-stat + .site-stat {
      padding-left: 0.5rem;
    }

    .site-stats--panel .site-stat-value {
      font-size: 0.95rem;
    }

    .site-stats--panel .site-stat-label {
      font-size: 0.51rem;
    }
  }
</style>
