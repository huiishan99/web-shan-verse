---
type AspectRatio = '16:9' | '4:3' | '1:1' | '9:16';

type Props = {
  src: string;
  title: string;
  caption?: string;
  aspectRatio?: AspectRatio;
  poster?: string;
  controls?: boolean;
};

const {
  src,
  title,
  caption,
  aspectRatio = '16:9',
  poster,
  controls = true,
} = Astro.props;

const aspectRatios: Record<AspectRatio, string> = {
  '16:9': '16 / 9',
  '4:3': '4 / 3',
  '1:1': '1 / 1',
  '9:16': '9 / 16',
};

function toEmbedUrl(value: string) {
  try {
    const url = new URL(value);
    const hostname = url.hostname.replace(/^www\./, '');

    if (hostname === 'youtube.com' || hostname === 'm.youtube.com') {
      const videoId = url.searchParams.get('v') || url.pathname.match(/^\/shorts\/([^/]+)/)?.[1];
      return videoId ? `https://www.youtube-nocookie.com/embed/${videoId}` : value;
    }

    if (hostname === 'youtu.be') {
      const videoId = url.pathname.split('/').filter(Boolean)[0];
      return videoId ? `https://www.youtube-nocookie.com/embed/${videoId}` : value;
    }

    if (hostname === 'vimeo.com') {
      const videoId = url.pathname.split('/').filter(Boolean)[0];
      return videoId ? `https://player.vimeo.com/video/${videoId}` : value;
    }
  } catch {
    return value;
  }

  return value;
}

const isVideoFile = /\.(mp4|webm|ogg)(\?.*)?$/i.test(src);
const embedSrc = toEmbedUrl(src);
const frameStyle = `--video-aspect-ratio: ${aspectRatios[aspectRatio]};`;
---

<figure class="blog-video">
  <div class="blog-video__frame" style={frameStyle}>
    {
      isVideoFile ? (
        <video src={src} title={title} poster={poster} controls={controls} preload="metadata" playsinline />
      ) : (
        <iframe
          src={embedSrc}
          title={title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        />
      )
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .blog-video {
    margin: 2rem auto;
  }

  .blog-video__frame {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: var(--video-aspect-ratio);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: #050507;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.2);
  }

  iframe,
  video {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  figcaption {
    margin-top: 0.65rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-style: italic;
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 768px) {
    .blog-video {
      width: calc(100% + 1rem);
      margin: 1.5rem -0.5rem;
    }

    .blog-video__frame {
      border-radius: 0;
    }

    figcaption {
      padding: 0 0.5rem;
      font-size: 0.85rem;
    }
  }
</style>
