---
// Interactive starfield background.
---

<div class="starfield-interactive">
  <canvas id="starCanvas"></canvas>
</div>

<script>
  interface Star {
    x: number;
    y: number;
    baseX: number;
    baseY: number;
    size: number;
    opacity: number;
    twinkleSpeed: number;
    twinkleOffset: number;
    depth: number;
    color: string;
    glowColor: string;
  }

  interface StarFieldState {
    frameId?: number;
    fillFrameId?: number;
    cleanup?: () => void;
    bootstrapped?: boolean;
  }

  const globalWindow = window as typeof window & { __shanStarField?: StarFieldState };
  const state = globalWindow.__shanStarField ??= {};

  function setupStarField() {
    state.cleanup?.();

    const canvasElement = document.getElementById('starCanvas') as HTMLCanvasElement | null;
    const drawingContext = canvasElement?.getContext('2d');
    if (!canvasElement || !drawingContext) return;

    const canvas = canvasElement;
    const ctx = drawingContext;

    let active = true;
    let width = window.innerWidth;
    let height = window.innerHeight;
    let renderScale = 1;
    let glowScale = 1;
    let minFrameInterval = 0;
    let lastDrawTime = 0;
    let mouseX = width / 2;
    let mouseY = height / 2;
    let paused = document.visibilityState === 'hidden';

    const stars: Star[] = [];
    const BASE_STAR_COUNT = 150;
    const MOBILE_STAR_COUNT = 82;
    const NARROW_MOBILE_STAR_COUNT = 68;
    const REDUCED_MOTION_STAR_COUNT = 52;
    let starCount = BASE_STAR_COUNT;
    const starTypes = [
      { color: 'rgba(255, 255, 255,', glow: 'rgba(200, 220, 255,' },
      { color: 'rgba(255, 250, 240,', glow: 'rgba(255, 250, 240,' },
      { color: 'rgba(180, 200, 255,', glow: 'rgba(150, 180, 255,' },
      { color: 'rgba(255, 220, 180,', glow: 'rgba(255, 200, 150,' },
      { color: 'rgba(220, 180, 255,', glow: 'rgba(200, 150, 255,' },
      { color: 'rgba(255, 215, 100,', glow: 'rgba(255, 200, 80,' },
    ];

    function createStar() {
        const starType = starTypes[Math.floor(Math.random() * starTypes.length)];
        const isBrightStar = Math.random() < 0.13;

      stars.push({
          x: Math.random() * width,
          y: Math.random() * height,
          baseX: Math.random() * width,
          baseY: Math.random() * height,
          size: isBrightStar ? Math.random() * 1.8 + 1.2 : Math.random() * 1 + 0.25,
          opacity: isBrightStar ? Math.random() * 0.35 + 0.5 : Math.random() * 0.4 + 0.2,
          twinkleSpeed: Math.random() * 0.03 + 0.01,
          twinkleOffset: Math.random() * Math.PI * 2,
          depth: Math.random() * 0.5 + 0.1,
          color: starType.color,
          glowColor: starType.glow,
        });
    }

    function fillStarsToTarget() {
      if (!active || stars.length >= starCount) return;

      const nextTarget = Math.min(starCount, stars.length + 15);
      while (stars.length < nextTarget) {
        createStar();
      }

      if (stars.length < starCount) {
        state.fillFrameId = requestAnimationFrame(fillStarsToTarget);
      }
    }

    function initStars() {
      stars.length = 0;
      const initialCount = Math.min(90, starCount);

      for (let i = 0; i < initialCount; i++) {
        createStar();
      }

      state.fillFrameId = requestAnimationFrame(fillStarsToTarget);
    }

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      const viewportArea = width * height;
      const isLargeCanvas = viewportArea > 3_500_000;
      const isMobileCanvas = width <= 700 || window.matchMedia('(pointer: coarse)').matches;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      renderScale = isLargeCanvas ? Math.max(0.62, Math.sqrt(3_500_000 / viewportArea)) : 1;
      glowScale = isLargeCanvas ? 0.78 : 1;
      minFrameInterval = isLargeCanvas ? 1000 / 45 : 0;
      starCount = isLargeCanvas ? 130 : BASE_STAR_COUNT;

      if (isMobileCanvas) {
        renderScale = Math.min(renderScale, 0.84);
        glowScale = Math.min(glowScale, 0.84);
        minFrameInterval = Math.max(minFrameInterval, 1000 / 42);
        starCount = width <= 430 ? NARROW_MOBILE_STAR_COUNT : MOBILE_STAR_COUNT;
      }

      if (prefersReducedMotion) {
        minFrameInterval = Math.max(minFrameInterval, 1000 / 30);
        starCount = Math.min(starCount, REDUCED_MOTION_STAR_COUNT);
      }

      canvas.width = Math.max(1, Math.floor(width * renderScale));
      canvas.height = Math.max(1, Math.floor(height * renderScale));
      canvas.dataset.starCount = String(starCount);
      canvas.dataset.renderScale = renderScale.toFixed(2);
      canvas.dataset.minFrameInterval = String(Math.round(minFrameInterval));
      ctx.setTransform(renderScale, 0, 0, renderScale, 0, 0);

      stars.forEach((star) => {
        star.baseX = Math.random() * width;
        star.baseY = Math.random() * height;
      });

      if (stars.length > starCount) {
        stars.length = starCount;
      } else if (stars.length < starCount) {
        state.fillFrameId = requestAnimationFrame(fillStarsToTarget);
      }
    }

    function drawStar(x: number, y: number, size: number, opacity: number, color: string, glowColor: string) {
      const outerGlow = ctx.createRadialGradient(x, y, 0, x, y, size * 7 * glowScale);
      outerGlow.addColorStop(0, `${glowColor}${opacity * 0.25})`);
      outerGlow.addColorStop(0.5, `${glowColor}${opacity * 0.08})`);
      outerGlow.addColorStop(1, `${glowColor}0)`);

      ctx.beginPath();
      ctx.arc(x, y, size * 7 * glowScale, 0, Math.PI * 2);
      ctx.fillStyle = outerGlow;
      ctx.fill();

      const innerGlow = ctx.createRadialGradient(x, y, 0, x, y, size * 2.8 * glowScale);
      innerGlow.addColorStop(0, `${color}${opacity * 0.75})`);
      innerGlow.addColorStop(0.5, `${glowColor}${opacity * 0.25})`);
      innerGlow.addColorStop(1, `${glowColor}0)`);

      ctx.beginPath();
      ctx.arc(x, y, size * 2.8 * glowScale, 0, Math.PI * 2);
      ctx.fillStyle = innerGlow;
      ctx.fill();

      ctx.beginPath();
      ctx.arc(x, y, size, 0, Math.PI * 2);
      ctx.fillStyle = `${color}${Math.min(opacity * 1.1, 0.95)})`;
      ctx.fill();

      if (size > 1.5) {
        ctx.strokeStyle = `${color}${opacity * 0.6})`;
        ctx.lineWidth = 0.5;
        ctx.beginPath();
        ctx.moveTo(x - size * 4, y);
        ctx.lineTo(x + size * 4, y);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(x, y - size * 4);
        ctx.lineTo(x, y + size * 4);
        ctx.stroke();
      }
    }

    function animate(timestamp = 0) {
      if (!active) return;
      if (paused) {
        state.frameId = requestAnimationFrame(animate);
        return;
      }

      if (minFrameInterval > 0 && timestamp - lastDrawTime < minFrameInterval) {
        state.frameId = requestAnimationFrame(animate);
        return;
      }

      lastDrawTime = timestamp;

      ctx.clearRect(0, 0, width, height);

      const time = Date.now() * 0.001;
      const centerX = width / 2;
      const centerY = height / 2;
      const offsetX = (mouseX - centerX) / centerX;
      const offsetY = (mouseY - centerY) / centerY;

      stars.forEach((star) => {
        const parallaxX = offsetX * 40 * star.depth;
        const parallaxY = offsetY * 40 * star.depth;

        star.x += (star.baseX + parallaxX - star.x) * 0.03;
        star.y += (star.baseY + parallaxY - star.y) * 0.03;

        const twinkle = Math.sin(time * star.twinkleSpeed * 15 + star.twinkleOffset);
        const twinkle2 = Math.sin(time * star.twinkleSpeed * 7 + star.twinkleOffset * 2);
        const currentOpacity = star.opacity * (0.6 + ((twinkle + twinkle2) / 2) * 0.4);

        drawStar(star.x, star.y, star.size, currentOpacity, star.color, star.glowColor);
      });

      state.frameId = requestAnimationFrame(animate);
    }

    const handleMouseMove = (event: MouseEvent) => {
      mouseX = event.clientX;
      mouseY = event.clientY;
    };

    const handleTouchMove = (event: TouchEvent) => {
      if (event.touches.length > 0) {
        mouseX = event.touches[0].clientX;
        mouseY = event.touches[0].clientY;
      }
    };

    const handleVisibilityChange = () => {
      paused = document.visibilityState === 'hidden';
      if (!paused) {
        lastDrawTime = 0;
      }
    };

    document.addEventListener('mousemove', handleMouseMove);
    document.addEventListener('touchmove', handleTouchMove);
    document.addEventListener('visibilitychange', handleVisibilityChange);
    window.addEventListener('resize', resize);

    resize();
    initStars();
    animate();

    state.cleanup = () => {
      active = false;
      if (state.frameId) cancelAnimationFrame(state.frameId);
      if (state.fillFrameId) cancelAnimationFrame(state.fillFrameId);
      document.removeEventListener('mousemove', handleMouseMove);
      document.removeEventListener('touchmove', handleTouchMove);
      document.removeEventListener('visibilitychange', handleVisibilityChange);
      window.removeEventListener('resize', resize);
    };
  }

  setupStarField();

  if (!state.bootstrapped) {
    state.bootstrapped = true;
    document.addEventListener('astro:page-load', setupStarField);
  }
</script>

<style>
  .starfield-interactive {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
  }

  #starCanvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
