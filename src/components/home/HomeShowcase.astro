---
import Icon from '../Icon.astro';
import { localizePath, type Locale } from '../../i18n/config';
import type { useTranslations } from '../../i18n/ui';
import {
  getBlogPostDisplayTitle,
  getBlogPostKind,
  getBlogPostPath,
  getPlainTextExcerpt,
  type BlogPost,
} from '../../utils/blog';

type HomeLabels = ReturnType<typeof useTranslations>['home'];

interface Props {
  lang: Locale;
  labels: HomeLabels;
  latestPosts: BlogPost[];
  buyMeACoffeeUrl: string;
}

const { lang, labels, latestPosts, buyMeACoffeeUrl } = Astro.props;
const dateLocale: Record<Locale, string> = {
  en: 'en-US',
  zh: 'zh-CN',
  ja: 'ja-JP',
};
---

<!-- Featured Section -->
<section class="featured">
  <div class="divider">
    <span class="divider-icon">◈</span>
  </div>

  <h2>{labels.featuredWorks}</h2>

  <div class="featured-grid">
    <a href={`${localizePath('/projects', lang)}#publications`} class="featured-card">
      <div class="featured-icon"><Icon name="publication" size={28} /></div>
      <h3>{labels.publicationsTitle}</h3>
      <p>{labels.publicationsDesc}</p>
    </a>

    <a href={`${localizePath('/projects', lang)}#web`} class="featured-card">
      <div class="featured-icon"><Icon name="globe" size={28} /></div>
      <h3>{labels.webTitle}</h3>
      <p>{labels.webDesc}</p>
    </a>

    <a href={localizePath('/blog', lang)} class="featured-card">
      <div class="featured-icon"><Icon name="pen" size={28} /></div>
      <h3>{labels.blogTitle}</h3>
      <p>{labels.blogDesc}</p>
    </a>
  </div>
</section>

<!-- Latest Posts Preview -->
<section class="latest">
  <div class="divider">
    <Icon name="gear" size={20} class="divider-icon" />
  </div>

  <h2>{labels.latestPosts}</h2>

  <div class="posts-grid">
    {latestPosts.map((post) => {
      const postKind = getBlogPostKind(post);
      const showPostTitle = postKind === 'article';

      return (
        <a href={getBlogPostPath(post, lang)} class:list={['post-card', `post-card--${postKind}`]}>
          <div class="post-date">
            {new Date(post.data.date).toLocaleDateString(dateLocale[lang], {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            })}
          </div>
          {showPostTitle && (
            <h3 class="post-title">{getBlogPostDisplayTitle(post, lang)}</h3>
          )}
          <p class="post-excerpt">{getPlainTextExcerpt(post.body ?? '', 100)}</p>
        </a>
      );
    })}
  </div>

  <div class="posts-action">
    <a href={localizePath('/blog', lang)} class="btn">
      <span>→</span> {labels.viewAllPosts}
    </a>
  </div>
</section>

<div class="coffee-support">
  <a href={buyMeACoffeeUrl} class="coffee-support-link" target="_blank" rel="noopener noreferrer">
    <!-- Official logo: https://cdn.buymeacoffee.com/buttons/bmc-new-btn-logo.svg -->
    <img src="/images/buy-me-a-coffee-logo.svg" alt="" width="35" height="50" class="coffee-support-logo" loading="lazy" />
    <span>{labels.supportCoffee}</span>
  </a>
</div>

<style>
  .featured,
  .latest {
    padding: var(--space-lg) 0;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  .featured-card {
    background: var(--surface-glass);
    border: 1px solid var(--surface-border);
    border-radius: var(--surface-radius);
    padding: var(--space-lg);
    text-align: center;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: var(--surface-shadow);
    backdrop-filter: blur(var(--surface-blur));
    -webkit-backdrop-filter: blur(var(--surface-blur));
  }

  .featured-card:hover {
    background: var(--surface-glass-hover);
    border-color: var(--surface-border-hover);
    transform: translateY(-3px);
    box-shadow: var(--surface-shadow-hover);
  }

  .featured-icon {
    margin-bottom: var(--space-md);
    display: flex;
    justify-content: center;
  }

  .featured-card h3 {
    color: var(--color-text-primary);
    font-size: 1.2rem;
    margin-bottom: var(--space-sm);
  }

  .featured-card p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .post-card {
    display: block;
    padding: var(--space-lg);
    background: var(--surface-glass);
    border: 1px solid var(--surface-border);
    border-radius: var(--surface-radius);
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: var(--surface-shadow);
    backdrop-filter: blur(var(--surface-blur));
    -webkit-backdrop-filter: blur(var(--surface-blur));
  }

  .post-card:hover {
    background: var(--surface-glass-hover);
    border-color: var(--surface-border-hover);
    transform: translateY(-2px);
    box-shadow: var(--surface-shadow-hover);
  }

  .post-date {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .post-title {
    font-size: 1.1rem;
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
    line-height: 1.4;
  }

  .post-card:hover .post-title {
    color: var(--color-brass-light);
  }

  .post-excerpt {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card--note .post-excerpt {
    color: rgba(245, 245, 245, 0.82);
    font-size: 0.95rem;
    line-height: 1.6;
    -webkit-line-clamp: 3;
  }

  .posts-action {
    text-align: center;
    padding-top: var(--space-md);
  }

  .posts-action .btn {
    background: transparent;
    border: 1px solid var(--color-brass);
    border-radius: 0;
    color: var(--color-brass);
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transform: none;
  }

  .posts-action .btn:hover {
    background: var(--color-brass);
    border-color: var(--color-brass);
    color: var(--color-bg-primary);
    box-shadow: none;
    transform: none;
  }

  .coffee-support {
    display: flex;
    justify-content: center;
    margin: var(--space-lg) 0 0;
    padding: var(--space-sm) 0;
  }

  .coffee-support-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    max-width: 100%;
    min-height: 3.5rem;
    padding: 0.65rem 1.15rem;
    color: #0d0c22;
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    background: #ffdd00;
    border: 1px solid #ffdd00;
    border-radius: 7px;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .coffee-support-link:hover {
    color: #0d0c22;
    background: #ffe64d;
    border-color: #ffe64d;
  }

  .coffee-support-link:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 5px;
  }

  .coffee-support-logo {
    display: block;
    flex-shrink: 0;
    width: 1.5rem;
    height: auto;
  }

  @media (max-width: 900px) {
    .featured-grid,
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .posts-action .btn {
      background:
        linear-gradient(180deg, rgba(201, 162, 39, 0.11), rgba(201, 162, 39, 0.045)),
        var(--surface-glass);
      border: 1px solid rgba(201, 162, 39, 0.34);
      border-radius: 4px;
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.14);
      backdrop-filter: blur(var(--surface-blur));
      -webkit-backdrop-filter: blur(var(--surface-blur));
    }

    .posts-action .btn:hover {
      background:
        linear-gradient(180deg, rgba(201, 162, 39, 0.18), rgba(201, 162, 39, 0.08)),
        var(--surface-glass-hover);
      border-color: rgba(212, 168, 75, 0.68);
      color: var(--color-brass-light);
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.2), 0 0 16px rgba(201, 162, 39, 0.1);
      transform: translateY(-1px);
    }

    .featured,
    .latest {
      padding: var(--space-md) 0;
    }

    .featured-grid,
    .posts-grid {
      gap: var(--space-md);
      margin-top: var(--space-md);
    }

    .featured-card,
    .post-card {
      padding: var(--space-md);
    }
  }
</style>
