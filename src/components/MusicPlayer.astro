---
import Icon from './Icon.astro';

const audioSrc = '/audio/bgm.mp3';
---

<div class="music-player" transition:persist="site-music-player">
  <audio
    id="site-bgm"
    src={audioSrc}
    preload="metadata"
    loop
    data-music-audio
  ></audio>

  <button
    type="button"
    class="music-toggle"
    aria-label="Play background music"
    aria-pressed="false"
    data-music-toggle
  >
    <Icon name="music" size={18} />
  </button>

  <label class="volume-control" aria-label="Background music volume">
    <input
      type="range"
      min="0"
      max="1"
      step="0.01"
      value="0.35"
      data-music-volume
    />
  </label>
</div>

<script is:inline>
  (() => {
    if (window.__shanMusicPlayerReady) return;
    window.__shanMusicPlayerReady = true;

    const STORAGE_KEY = 'shan-verse:bgm';

    function readState() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      } catch {
        return {};
      }
    }

    function writeState(audio, extra = {}) {
      const previous = readState();
      const next = {
        ...previous,
        currentTime: audio.currentTime || 0,
        volume: audio.volume,
        playing: !audio.paused,
        ...extra,
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
    }

    function setupMusicPlayer() {
      const player = document.querySelector('[data-music-audio]')?.closest('.music-player');
      if (!player || player.dataset.ready === 'true') return;

      const audio = player.querySelector('[data-music-audio]');
      const toggle = player.querySelector('[data-music-toggle]');
      const volume = player.querySelector('[data-music-volume]');
      if (!(audio instanceof HTMLAudioElement) || !(toggle instanceof HTMLButtonElement) || !(volume instanceof HTMLInputElement)) return;

      player.dataset.ready = 'true';

      const saved = readState();
      const savedVolume = typeof saved.volume === 'number' ? saved.volume : 0.35;
      audio.volume = Math.min(1, Math.max(0, savedVolume));
      volume.value = String(audio.volume);

      function syncButton() {
        const isPlaying = !audio.paused;
        toggle.classList.toggle('is-playing', isPlaying);
        toggle.setAttribute('aria-pressed', String(isPlaying));
        toggle.setAttribute('aria-label', isPlaying ? 'Pause background music' : 'Play background music');
      }

      audio.addEventListener('loadedmetadata', () => {
        if (typeof saved.currentTime === 'number' && Number.isFinite(saved.currentTime)) {
          audio.currentTime = Math.min(saved.currentTime, Math.max(0, audio.duration - 0.5));
        }
      }, { once: true });

      toggle.addEventListener('click', async () => {
        if (audio.paused) {
          try {
            await audio.play();
            writeState(audio, { playing: true });
          } catch {
            toggle.classList.add('has-error');
            window.setTimeout(() => toggle.classList.remove('has-error'), 900);
          }
        } else {
          audio.pause();
          writeState(audio, { playing: false });
        }
        syncButton();
      });

      volume.addEventListener('input', () => {
        audio.volume = Number(volume.value);
        writeState(audio);
      });

      audio.addEventListener('play', syncButton);
      audio.addEventListener('pause', syncButton);
      audio.addEventListener('timeupdate', () => {
        if (!audio.paused) writeState(audio);
      });

      syncButton();
    }

    setupMusicPlayer();
    document.addEventListener('astro:page-load', setupMusicPlayer);
  })();
</script>

<style>
  .music-player {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 140;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.75rem 0.45rem 0.45rem;
    border: 1px solid var(--color-border-accent);
    border-radius: 999px;
    background: rgba(10, 10, 15, 0.72);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(12px);
  }

  .music-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgba(201, 162, 39, 0.45);
    border-radius: 50%;
    background: rgba(201, 162, 39, 0.08);
    color: var(--color-brass-light);
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .music-toggle:hover,
  .music-toggle.is-playing {
    border-color: var(--color-brass);
    background: var(--color-brass);
    color: var(--color-text-primary);
  }

  .music-toggle.has-error {
    transform: translateX(-1px);
    border-color: #d08b73;
  }

  .music-toggle :global(.icon) {
    color: inherit;
    transform: translateX(-0.06rem);
  }

  .volume-control {
    display: inline-flex;
    align-items: center;
    width: 5.5rem;
  }

  .volume-control input {
    width: 100%;
    accent-color: var(--color-brass);
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .music-player {
      right: 0.75rem;
      bottom: calc(env(safe-area-inset-bottom) + 0.75rem);
      gap: 0;
      padding: 0.4rem;
    }

    .volume-control {
      display: none;
    }
  }
</style>
