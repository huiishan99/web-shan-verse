---
import Icon from './Icon.astro';

const audioSrc = '/audio/bgm.mp3';
interface Props {
  locale?: string;
  labels?: {
    play?: string;
    pause?: string;
    volume?: string;
    lowerVolume?: string;
    mute?: string;
    unmute?: string;
    restart?: string;
    raiseVolume?: string;
    quickControls?: string;
  };
}

const defaultLabels = {
  play: 'Play background music',
  pause: 'Pause background music',
  volume: 'Background music volume',
  lowerVolume: 'Lower background music volume',
  mute: 'Mute background music',
  unmute: 'Unmute background music',
  restart: 'Restart background music',
  raiseVolume: 'Raise background music volume',
  quickControls: 'Quick music controls',
};
const {
  locale = 'en',
  labels: labelOverrides = {},
} = Astro.props;
const labels = { ...defaultLabels, ...labelOverrides };
const persistKey = `site-music-player-${locale}`;
---

<div class="music-player" transition:persist={persistKey} data-music-labels={JSON.stringify(labels)}>
  <audio
    id="site-bgm"
    src={audioSrc}
    preload="metadata"
    loop
    data-music-audio
  ></audio>

  <button
    type="button"
    class="music-toggle"
    aria-label={labels.play}
    aria-pressed="false"
    aria-expanded="false"
    aria-controls="music-mobile-panel"
    data-music-toggle
  >
    <Icon name="music" size={18} />
  </button>

  <label class="volume-control" aria-label={labels.volume}>
    <input
      type="range"
      min="0"
      max="1"
      step="0.01"
      value="0.35"
      data-music-volume
    />
  </label>

  <div class="music-mobile-panel" id="music-mobile-panel" aria-hidden="true" data-music-panel>
    <div class="music-equalizer" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div class="mobile-music-actions" aria-label={labels.quickControls}>
      <button type="button" class="music-panel-button" aria-label={labels.lowerVolume} data-music-action="volume-down">
        <Icon name="minus" size={15} />
      </button>
      <button type="button" class="music-panel-button" aria-label={labels.mute} aria-pressed="false" data-music-action="mute">
        <Icon name="volumeX" size={15} />
      </button>
      <button type="button" class="music-panel-button" aria-label={labels.restart} data-music-action="restart">
        <Icon name="rotateCcw" size={15} />
      </button>
      <button type="button" class="music-panel-button" aria-label={labels.raiseVolume} data-music-action="volume-up">
        <Icon name="plus" size={15} />
      </button>
    </div>
  </div>
</div>

<script>
  import '../scripts/client/music-player.js';
</script>

<style>
  .music-player {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 140;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.75rem 0.45rem 0.45rem;
    border: 1px solid var(--color-border-accent);
    border-radius: 999px;
    background: rgba(10, 10, 15, 0.72);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .music-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgba(201, 162, 39, 0.45);
    border-radius: 50%;
    background: rgba(201, 162, 39, 0.08);
    color: var(--color-brass-light);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: none;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .music-toggle.is-playing {
    border-color: var(--color-brass);
    background: var(--color-brass);
    color: var(--color-text-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .music-toggle:hover {
      border-color: var(--color-brass);
      background: var(--color-brass);
      color: var(--color-text-primary);
    }
  }

  .music-toggle.has-error {
    transform: translateX(-1px);
    border-color: #d08b73;
  }

  .music-toggle :global(.icon) {
    color: inherit;
    transform: translateX(-0.06rem);
  }

  .volume-control {
    display: inline-flex;
    align-items: center;
    width: 5.5rem;
  }

  .volume-control input {
    width: 100%;
    accent-color: var(--color-brass);
    cursor: pointer;
  }

  .music-mobile-panel {
    display: none;
  }

  @media (max-width: 640px) {
    .music-player,
    .music-player * {
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      user-select: none;
    }

    .music-player {
      right: 0.75rem;
      bottom: calc(env(safe-area-inset-bottom) + 0.75rem);
      gap: 0;
      justify-content: center;
      width: 3.35rem;
      height: 3.35rem;
      padding: 0;
      touch-action: none;
      border-color: transparent;
      background: transparent;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      overflow: visible;
      isolation: isolate;
    }

    .music-player::before,
    .music-player::after {
      position: absolute;
      content: "";
      border-radius: inherit;
      pointer-events: none;
    }

    .music-player::before {
      inset: 0.38rem;
      z-index: -1;
      background: rgba(201, 162, 39, 0.1);
      filter: blur(13px);
      opacity: 0.22;
    }

    .music-player::after {
      display: none;
    }

    .music-player.is-playing {
      border-color: transparent;
      box-shadow: none;
    }

    .music-player.is-playing::before {
      background: rgba(201, 162, 39, 0.16);
      opacity: 0.52;
    }

    .music-toggle {
      position: relative;
      z-index: 1;
      width: 3.15rem;
      height: 3.15rem;
      border-color: rgba(255, 255, 255, 0.26);
      background:
        radial-gradient(circle at 28% 18%, rgba(255, 255, 255, 0.18), transparent 32%),
        linear-gradient(145deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.012) 48%, rgba(255, 255, 255, 0.045)),
        rgba(255, 255, 255, 0.035);
      color: rgba(244, 224, 154, 0.95);
      box-shadow:
        0 12px 24px rgba(0, 0, 0, 0.24),
        0 2px 10px rgba(201, 162, 39, 0.012),
        inset 0 1px 0 rgba(255, 255, 255, 0.48),
        inset 0 -10px 16px rgba(0, 0, 0, 0.08);
      backdrop-filter: blur(22px) saturate(190%) brightness(1.08);
      -webkit-backdrop-filter: blur(22px) saturate(190%) brightness(1.08);
      isolation: isolate;
      transition:
        transform 0.16s cubic-bezier(0.2, 0.8, 0.2, 1),
        background 0.18s ease,
        border-color 0.18s ease,
        color 0.18s ease,
        box-shadow 0.18s ease;
    }

    .music-toggle::before,
    .music-toggle::after {
      position: absolute;
      content: "";
      border-radius: inherit;
      pointer-events: none;
    }

    .music-toggle::before {
      inset: 0;
      z-index: -1;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.13), transparent 42%, rgba(255, 255, 255, 0.045));
      mask-image: linear-gradient(#000, transparent 72%);
      -webkit-mask-image: linear-gradient(#000, transparent 72%);
    }

    .music-toggle::after {
      top: 0.42rem;
      left: 0.62rem;
      z-index: -1;
      width: 1.05rem;
      height: 0.45rem;
      background: rgba(255, 255, 255, 0.22);
      filter: blur(0.14rem);
      transform: rotate(-24deg);
    }

    .music-toggle:active,
    .music-player.is-panel-open .music-toggle {
      transform: scale(0.94);
      border-color: rgba(255, 255, 255, 0.24);
      background:
        radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.12), transparent 32%),
        linear-gradient(145deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.01) 48%, rgba(255, 255, 255, 0.032)),
        rgba(255, 255, 255, 0.026);
      box-shadow:
        0 8px 18px rgba(0, 0, 0, 0.2),
        inset 0 2px 8px rgba(0, 0, 0, 0.16),
        inset 0 1px 0 rgba(255, 255, 255, 0.18);
    }

    .music-toggle.is-playing {
      border-color: rgba(255, 255, 255, 0.24);
      background:
        radial-gradient(circle at 28% 18%, rgba(255, 255, 255, 0.2), transparent 32%),
        linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(201, 162, 39, 0.035) 52%, rgba(255, 255, 255, 0.045)),
        rgba(255, 255, 255, 0.044);
      color: var(--color-text-primary);
      box-shadow:
        0 12px 24px rgba(0, 0, 0, 0.26),
        0 0 12px rgba(201, 162, 39, 0.035),
        inset 0 1px 0 rgba(255, 255, 255, 0.48),
        inset 0 -10px 16px rgba(139, 105, 20, 0.06);
    }

    .music-toggle:active.is-playing,
    .music-player.is-panel-open .music-toggle.is-playing {
      box-shadow:
        0 10px 22px rgba(0, 0, 0, 0.34),
        0 0 14px rgba(201, 162, 39, 0.12),
        inset 0 2px 8px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.22);
    }

    .music-toggle :global(.icon) {
      position: relative;
      z-index: 1;
    }

    .volume-control {
      display: none;
    }

    .music-mobile-panel {
      position: absolute;
      right: 0;
      bottom: calc(100% + 0.65rem);
      display: grid;
      grid-template-columns: auto auto;
      align-items: center;
      gap: 0.55rem;
      min-width: 13.75rem;
      padding: 0.55rem 0.6rem;
      border: 1px solid rgba(201, 162, 39, 0.28);
      border-radius: 999px;
      background:
        linear-gradient(180deg, rgba(201, 162, 39, 0.12), rgba(201, 162, 39, 0.045)),
        rgba(10, 10, 15, 0.84);
      box-shadow: 0 16px 34px rgba(0, 0, 0, 0.34), 0 0 22px rgba(201, 162, 39, 0.08);
      opacity: 0;
      pointer-events: none;
      transform: translateY(0.45rem) scale(0.97);
      transform-origin: 90% 100%;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .music-mobile-panel.is-open,
    .music-player.is-panel-open .music-mobile-panel {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0) scale(1);
    }

    .music-equalizer {
      display: inline-flex;
      align-items: end;
      justify-content: center;
      gap: 0.14rem;
      width: 1.5rem;
      height: 1.25rem;
      color: var(--color-brass);
    }

    .music-equalizer span {
      width: 0.18rem;
      height: 0.45rem;
      border-radius: 999px;
      background: currentColor;
      opacity: 0.58;
      transform-origin: center bottom;
    }

    .music-player.is-playing .music-equalizer span {
      animation: musicBar 0.9s ease-in-out infinite;
    }

    .music-player.is-playing .music-equalizer span:nth-child(2) {
      animation-delay: 0.15s;
    }

    .music-player.is-playing .music-equalizer span:nth-child(3) {
      animation-delay: 0.3s;
    }

    .mobile-music-actions {
      display: inline-flex;
      gap: 0.4rem;
    }

    .music-panel-button {
      display: inline-grid;
      place-items: center;
      width: 2rem;
      height: 2rem;
      border: 1px solid rgba(201, 162, 39, 0.28);
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.04);
      color: var(--color-brass-light);
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      touch-action: none;
      transition:
        background 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
    }

    .music-panel-button:active,
    .music-panel-button.is-selected,
    .music-panel-button.is-muted {
      border-color: var(--color-brass);
      background: rgba(201, 162, 39, 0.18);
      color: var(--color-brass);
      transform: translateY(1px);
    }

    .music-panel-button :global(.icon) {
      color: inherit;
    }
  }

  @keyframes musicBar {
    0%,
    100% {
      opacity: 0.48;
      transform: scaleY(0.7);
    }

    50% {
      opacity: 1;
      transform: scaleY(1.75);
    }
  }
</style>
