    overflow-x: auto;
    overflow-y: visible;
    overscroll-behavior-x: contain;
    padding: 0.15rem 0 var(--space-xs);
    scrollbar-color: rgba(201, 162, 39, 0.46) rgba(255, 255, 255, 0.05);
    scrollbar-width: thin;
  }

  .activity-map-frame.activity-map-frame--compact {
    display: none;
  }

  .activity-map-frame::-webkit-scrollbar,
  .github-activity-frame::-webkit-scrollbar {
    height: 8px;
  }

  .activity-map-frame::-webkit-scrollbar-track,
  .github-activity-frame::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.04);
  }

  .activity-map-frame::-webkit-scrollbar-thumb,
  .github-activity-frame::-webkit-scrollbar-thumb {
    background: rgba(201, 162, 39, 0.42);
    border-radius: 999px;
  }

  .activity-map {
    width: max-content;
  }

  .activity-years,
  .activity-months {
    display: grid;
    grid-template-columns: repeat(52, var(--activity-cell));
    gap: var(--activity-gap);
    width: max-content;
    padding-left: 1.9rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    line-height: 1;
  }

  .activity-years {
    margin-bottom: 0.3rem;
    font-size: 0.7rem;
    font-weight: 600;
  }

  .activity-months {
    margin-bottom: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.68rem;
  }

  .activity-months span {
    min-height: 0.7rem;
  }

  .activity-calendar {
    display: grid;
    grid-template-columns: 1.45rem max-content;
    gap: 0.45rem;
    align-items: start;
  }

  .activity-weekdays {
    display: grid;
    grid-template-rows: repeat(7, var(--activity-cell));
    gap: var(--activity-gap);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: var(--activity-cell);
  }

  .activity-grid {
    display: grid;
    grid-template-columns: repeat(52, var(--activity-cell));
    gap: var(--activity-gap);
    width: max-content;
    padding: 0 0 var(--space-xs);
  }

  .activity-map--compact .activity-years,
  .activity-map--compact .activity-months,
  .activity-map--compact .activity-grid {
    grid-template-columns: repeat(26, var(--activity-cell));
  }

  .activity-week {
    display: grid;
    grid-template-rows: repeat(7, var(--activity-cell));
    gap: var(--activity-gap);
  }

  .activity-dot {
    display: block;
    width: var(--activity-cell, 9px);
    height: var(--activity-cell, 9px);
    box-sizing: border-box;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.035);
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .activity-dot--blog {
    background: rgba(106, 171, 255, 0.72);
    border-color: rgba(160, 200, 255, 0.34);
    box-shadow: 0 0 8px rgba(106, 171, 255, 0.2);
  }

  .activity-dot--activity {
    background: rgba(148, 196, 179, 0.68);
    border-color: rgba(176, 220, 205, 0.3);
    box-shadow: 0 0 8px rgba(148, 196, 179, 0.18);
  }

  .activity-dot--milestone {
    background: rgba(201, 162, 39, 0.78);
    border-color: rgba(212, 168, 75, 0.36);
    box-shadow: 0 0 8px rgba(201, 162, 39, 0.22);
  }

  .activity-dot--mixed {
    background: conic-gradient(from 90deg, rgba(106, 171, 255, 0.85), rgba(148, 196, 179, 0.82), rgba(241, 213, 122, 0.95), rgba(106, 171, 255, 0.85));
    border-color: rgba(245, 245, 245, 0.22);
    box-shadow: 0 0 10px rgba(212, 168, 75, 0.4);
  }

  .activity-dot--2,
  .activity-dot--3,
  .activity-dot--4 {
    border-color: rgba(245, 245, 245, 0.28);
  }

  .activity-dot:hover {
    transform: scale(1.35);
    border-color: var(--color-brass-light);
  }

  .activity-legend {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .activity-legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .github-activity {
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .github-activity-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .github-activity-header span,
  .github-activity-header a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .github-activity-header a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .github-activity-header a:hover {
    color: var(--color-link-hover);
  }

  .github-activity-frame {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding: 0.35rem 0 0.15rem;
    scrollbar-color: rgba(201, 162, 39, 0.46) rgba(255, 255, 255, 0.05);
    scrollbar-width: thin;
    text-decoration: none;
  }

  .github-calendar {
    --github-cell: 9px;
    --github-gap: 3px;
    display: none;
    width: max-content;
    min-width: 560px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .github-activity.is-enhanced .github-calendar--full {
    display: block;
  }

  .github-activity-frame .github-activity-fallback {
    display: none;
  }

  .github-activity.is-fallback .github-activity-fallback {
    display: block;
  }

  .github-activity.is-enhanced .github-activity-fallback {
    display: none;
  }

  :global(.github-calendar-years),
  :global(.github-calendar-months) {
    display: grid;
    grid-template-columns: repeat(52, var(--github-cell));
    gap: var(--github-gap);
    width: max-content;
    padding-left: 1.9rem;
    line-height: 1;
  }

  :global(.github-calendar-years) {
    margin-bottom: 0.3rem;
    font-size: 0.7rem;
    font-weight: 600;
  }

  :global(.github-calendar-months) {
    margin-bottom: 0.5rem;
    font-size: 0.68rem;
  }

  :global(.github-calendar-body) {
    display: grid;
    grid-template-columns: 1.45rem max-content;
    gap: 0.45rem;
    align-items: start;
  }

  :global(.github-calendar-weekdays) {
    display: grid;
    grid-template-rows: repeat(7, var(--github-cell));
    gap: var(--github-gap);
    line-height: var(--github-cell);
  }

  :global(.github-calendar-grid) {
    display: grid;
    grid-template-columns: repeat(52, var(--github-cell));
    gap: var(--github-gap);
    width: max-content;
    padding-bottom: var(--space-xs);
  }

  .github-calendar--compact :global(.github-calendar-years),
  .github-calendar--compact :global(.github-calendar-months),
  .github-calendar--compact :global(.github-calendar-grid) {
    grid-template-columns: repeat(26, var(--github-cell));
  }

  :global(.github-calendar-week) {
    display: grid;
    grid-template-rows: repeat(7, var(--github-cell));
    gap: var(--github-gap);
  }

  :global(.github-calendar-day) {
    display: block;
    width: var(--github-cell);
    height: var(--github-cell);
    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.035);
  }

  :global(.github-calendar-day--1) {
    background: rgba(201, 162, 39, 0.24);
    border-color: rgba(201, 162, 39, 0.18);
  }

  :global(.github-calendar-day--2) {
    background: rgba(201, 162, 39, 0.42);
    border-color: rgba(201, 162, 39, 0.24);
  }

  :global(.github-calendar-day--3) {
    background: rgba(212, 168, 75, 0.68);
    border-color: rgba(212, 168, 75, 0.32);
  }

  :global(.github-calendar-day--4) {
    background: rgba(212, 168, 75, 0.9);
    border-color: rgba(245, 225, 162, 0.45);
    box-shadow: 0 0 8px rgba(201, 162, 39, 0.24);
  }

  .github-activity-frame img {
    display: block;
    width: 100%;
    min-width: 560px;
    max-width: none;
    min-height: 90px;
    opacity: 0.9;
    border-radius: 4px;
    filter: sepia(0.48) saturate(0.9) brightness(0.58) contrast(1.25);
  }

  .activity-log {
    min-width: 0;
    padding-left: var(--space-lg);
    border-left: 1px solid var(--color-border);
  }

  .activity-log-title {
    margin: 0 0 var(--space-sm);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .activity-log ol {
    list-style: none;
    display: grid;
    gap: 0.65rem;
  }

  .activity-log a {
    display: grid;
    grid-template-columns: 5.8rem minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: start;
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .activity-log a:hover strong {
    color: var(--color-brass-light);
  }

  .activity-type {
    padding-top: 0.1rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .activity-type--blog {
    color: var(--color-link-hover);
  }

  .activity-type--activity {
    color: rgb(148, 196, 179);
  }

  .activity-type--milestone {
    color: var(--color-signal-milestone, rgb(158, 188, 230));
  }

  .activity-log-main {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .activity-log time {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .activity-log strong {
    color: var(--color-text-secondary);
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.35;
    transition: color 0.2s ease;
  }
  
  /* Featured Section */
  .featured, .latest {
    padding: var(--space-lg) 0;
  }
  
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }
  
  .featured-card {
    background: var(--surface-glass);
    border: 1px solid var(--surface-border);
    border-radius: var(--surface-radius);
    padding: var(--space-lg);
    text-align: center;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: var(--surface-shadow);
    backdrop-filter: blur(var(--surface-blur));
    -webkit-backdrop-filter: blur(var(--surface-blur));
  }
  
  .featured-card:hover {
    background: var(--surface-glass-hover);
    border-color: var(--surface-border-hover);
    transform: translateY(-3px);
    box-shadow: var(--surface-shadow-hover);
  }
  
  .featured-icon {
    margin-bottom: var(--space-md);
    display: flex;
    justify-content: center;
  }
  
  .featured-card h3 {
    color: var(--color-text-primary);
    font-size: 1.2rem;
    margin-bottom: var(--space-sm);
  }
  
  .featured-card p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }
  
  /* Latest Posts */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  
  .post-card {
    display: block;
    padding: var(--space-lg);
    background: var(--surface-glass);
    border: 1px solid var(--surface-border);
    border-radius: var(--surface-radius);
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: var(--surface-shadow);
    backdrop-filter: blur(var(--surface-blur));
    -webkit-backdrop-filter: blur(var(--surface-blur));
  }
  
  .post-card:hover {
    background: var(--surface-glass-hover);
    border-color: var(--surface-border-hover);
    transform: translateY(-2px);
    box-shadow: var(--surface-shadow-hover);
  }
  
  .post-date {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }
  
  .post-title {
    font-size: 1.1rem;
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
    line-height: 1.4;
  }
  
  .post-card:hover .post-title {
    color: var(--color-brass-light);
  }
  
  .post-excerpt {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .posts-action {
    text-align: center;
    padding-top: var(--space-md);
  }

  .support-note {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-lg);
    align-items: center;
    margin: var(--space-lg) 0 0;
    padding: var(--space-lg);
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(106, 171, 255, 0.07), transparent 38%),
      linear-gradient(180deg, rgba(201, 162, 39, 0.07), rgba(255, 255, 255, 0.025)),
      rgba(13, 13, 18, 0.58);
    border: 1px solid rgba(255, 255, 255, 0.085);
    border-radius: var(--surface-radius);
    box-shadow: var(--surface-shadow);
    backdrop-filter: blur(var(--surface-blur));
    -webkit-backdrop-filter: blur(var(--surface-blur));
  }

  .support-note::before,
  .support-note::after {
    content: '◈';
    position: absolute;
    color: var(--color-brass);
    font-size: 0.7rem;
    opacity: 0.48;
  }

  .support-note::before {
    top: 0.7rem;
    left: 0.8rem;
  }

  .support-note::after {
    right: 0.8rem;
    bottom: 0.7rem;
  }

  .support-note-copy {
    min-width: 0;
    padding-left: 0.15rem;
  }

  .support-note-copy h2 {
    margin: 0 0 0.55rem;
    padding: 0;
    border: 0;
    color: var(--color-text-primary);
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    letter-spacing: 0.04em;
  }

  .support-note-copy p {
    max-width: 42rem;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.96rem;
    line-height: 1.65;
  }

  .support-note-copy span {
    display: block;
    margin-top: 0.55rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.5;
  }

  .support-note-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-sm);
  }

  .support-note-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.35rem;
    padding: 0.48rem 0.8rem;
    color: var(--color-text-secondary);
    font-family: var(--font-body);
    font-size: 0.94rem;
    line-height: 1.1;
    text-decoration: none;
    white-space: nowrap;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.085);
    border-radius: 4px;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .support-note-link:hover,
  .support-note-link:focus-visible {
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(201, 162, 39, 0.26);
    transform: translateY(-1px);
  }

  .support-note-link--primary {
    color: var(--color-brass-light);
    background: rgba(201, 162, 39, 0.1);
    border-color: rgba(201, 162, 39, 0.26);
  }

  .support-note-link--primary:hover,
  .support-note-link--primary:focus-visible {
    color: var(--color-bg-primary);
    background: var(--color-brass);
    border-color: var(--color-brass);
  }
  
  .coming-soon {
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: var(--space-lg);
  }
  
  /* Responsive */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    
    .hero-status {
      width: 100%;
    }
    
    .title-line {
      font-size: 2.5rem;
    }
    
    .featured-grid,
    .posts-grid {
      grid-template-columns: 1fr;
    }

    .support-note {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .support-note-actions {
      justify-content: flex-start;
    }

    .activity-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .activity-stats {
      flex-wrap: wrap;
      white-space: normal;
    }

    .activity-panel {
      grid-template-columns: 1fr;
      padding: var(--space-md);
    }

    .activity-log {
      padding-left: 0;
      padding-top: var(--space-md);
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }
  }

  @media (max-width: 600px) {
    .hero {
      gap: var(--space-lg);
      padding: 0.75rem 0 var(--space-lg);
    }

    .hero-actions {
      flex-direction: column;
      gap: 0.75rem;
    }

    .hero-actions .btn {
      justify-content: center;
    }

    .hero-actions .btn,
    .posts-action .btn {
      background:
        linear-gradient(180deg, rgba(201, 162, 39, 0.11), rgba(201, 162, 39, 0.045)),
        var(--surface-glass);
      border: 1px solid rgba(201, 162, 39, 0.34);
      border-radius: 4px;
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.14);
      backdrop-filter: blur(var(--surface-blur));
      -webkit-backdrop-filter: blur(var(--surface-blur));
    }

    .hero-actions .btn:hover,
    .posts-action .btn:hover {
      background:
        linear-gradient(180deg, rgba(201, 162, 39, 0.18), rgba(201, 162, 39, 0.08)),
        var(--surface-glass-hover);
      border-color: rgba(212, 168, 75, 0.68);
      color: var(--color-brass-light);
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.2), 0 0 16px rgba(201, 162, 39, 0.1);
      transform: translateY(-1px);
    }

    .hero-actions .btn:hover :global(.icon) {
      color: currentColor;
    }

    .featured,
    .latest {
      padding: var(--space-md) 0;
    }

    .featured-grid,
    .posts-grid {
      gap: var(--space-md);
      margin-top: var(--space-md);
    }

    .featured-card,
    .post-card {
      padding: var(--space-md);
    }

    .support-note {
      gap: var(--space-md);
      padding: var(--space-md);
    }

    .support-note-copy p {
      font-size: 0.92rem;
    }

    .support-note-actions {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
    }

    .support-note-link {
      width: 100%;
      white-space: normal;
    }

    .activity {
      padding: var(--space-md) 0 var(--space-lg);
    }

    .activity-stats {
      gap: var(--space-sm);
      font-size: 0.72rem;
    }

    .activity-range-full,
    .activity-stats--full,
    .activity-map-frame--full {
      display: none;
    }

    .activity-range-compact {
      display: inline;
    }

    .activity-stats--compact {
      display: flex;
    }

    .activity-map-frame.activity-map-frame--compact {
      display: block;
    }

    .activity-chart {
      --activity-cell: 8px;
      --activity-gap: 3px;
    }

    .activity-map-frame,
    .github-activity-frame {
      width: 100%;
      margin-inline: 0;
      padding-inline: 0;
      scrollbar-width: none;
    }

    .activity-map--compact,
    .github-calendar--compact {
      margin-inline: auto;
      transform: translateX(calc((1rem + 0.35rem) / -4));
    }

    .activity-map-frame::-webkit-scrollbar,
    .github-activity-frame::-webkit-scrollbar {
      display: none;
    }

    .activity-years,
    .activity-months {
      padding-left: 1.35rem;
    }

    .activity-calendar {
      grid-template-columns: 1rem max-content;
      gap: 0.35rem;
    }

    .activity-years {
      font-size: 0.58rem;
    }

    .activity-months {
      font-size: 0.56rem;
    }

    .activity-weekdays {
      font-size: 0.48rem;
    }

    .activity-dot {
      border-radius: 2px;
    }

    .github-activity-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .github-activity-frame img {
      min-width: 0;
    }

    .github-calendar {
      --github-cell: 8px;
      --github-gap: 3px;
      min-width: 0;
      font-size: 0.5rem;
    }

    .github-activity.is-enhanced .github-calendar--full {
      display: none;
    }

    .github-activity.is-enhanced .github-calendar--compact {
      display: block;
    }

    :global(.github-calendar-years),
    :global(.github-calendar-months) {
      padding-left: 1.35rem;
    }

    :global(.github-calendar-body) {
      grid-template-columns: 1rem max-content;
      gap: 0.35rem;
    }

    :global(.github-calendar-years) {
      font-size: 0.58rem;
    }

    :global(.github-calendar-months) {
      font-size: 0.56rem;
    }

    :global(.github-calendar-weekdays) {
      font-size: 0.48rem;
    }

    :global(.github-calendar-day) {
      border-radius: 2px;
    }

