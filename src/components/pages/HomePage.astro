---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import SiteStats from '../SiteStats.astro';
import TrustedInlineHtml from '../TrustedInlineHtml.astro';
import HomeInteractions from '../home/HomeInteractions.astro';
import HomeShowcase from '../home/HomeShowcase.astro';
import { currentStatus } from '../../data/status';
import { timelineData } from '../../data/timeline';
import { defaultLocale, localizePath, localizeString, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import {
  getBlogPosts,
  getBlogPostsForLocale,
  sortBlogPosts,
} from '../../utils/blog';
import { buildHomepageActivityModel, toDateKey } from '../../utils/home-activity';
import { asTrustedInlineHtml, escapeHtml } from '../../utils/html';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const aboutPath = localizePath('/about', lang);
const introHtml = asTrustedInlineHtml(
  t.home.intro.replace(
    '{aboutLink}',
    `<a class="highlight intro-link" href="${escapeHtml(aboutPath)}">${escapeHtml(t.home.aboutButton)}</a>`
  )
);
// 获取最新3篇博客文章
const allPosts = getBlogPostsForLocale(
  (await getBlogPosts()).filter((post) => !post.data.draft),
  lang
);
const latestPosts = sortBlogPosts(allPosts).slice(0, 3);
const {
  activeDays,
  activityLabel,
  activityMonthLabels,
  activityRangeLabel,
  activitySignalCount,
  activityWeekdayLabels,
  activityWeeks,
  activityYearLabels,
  blogSignalCount,
  compactActiveDays,
  compactActivityLabel,
  compactActivityMonthLabels,
  compactActivityRangeLabel,
  compactActivitySignalCount,
  compactActivityWeeks,
  compactActivityYearLabels,
  compactBlogSignalCount,
  compactGridStart,
  compactMilestoneSignalCount,
  gridEnd,
  gridStart,
  milestoneSignalCount,
  recentSignals,
} = buildHomepageActivityModel({
  labels: t.home,
  lang,
  posts: allPosts,
  timelineData,
});

const githubUsername = 'huiishan99';
const githubProfileUrl = `https://github.com/${githubUsername}`;
const githubContributionChartUrl = `https://ghchart.rshah.org/C9A227/${githubUsername}`;
const sponsorContactUrl = 'https://linkedin.com/in/laihuishan/';

---

<BaseLayout title={t.home.title} lang={lang}>
  <div class="container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <p class="hero-greeting">{t.home.greeting}</p>
        <h1 class="hero-title">
          <span class="title-line">SHAN</span>
          <span class="title-decoration" aria-hidden="true">
            <span class="title-rule"></span>
            <svg class="title-star" viewBox="0 0 64 64" focusable="false">
              <path
                class="title-star-core"
                d="M32 2C35.2 19.6 44.4 28.8 62 32C44.4 35.2 35.2 44.4 32 62C28.8 44.4 19.6 35.2 2 32C19.6 28.8 28.8 19.6 32 2Z"
              />
            </svg>
            <span class="title-rule"></span>
          </span>
          <span class="title-line">VERSE</span>
        </h1>
        <p class="hero-tagline">{t.home.tagline}</p>
        
        <div class="hero-intro">
          <p><TrustedInlineHtml html={introHtml} /></p>
        </div>
        
        <div class="hero-actions">
          <a href={aboutPath} class="btn">
            <Icon name="gear" size={16} /> {t.home.aboutButton}
          </a>
          <a href={localizePath('/journey', lang)} class="btn" data-journey-preload data-astro-prefetch="hover">
            <Icon name="earthAtlas" size={16} /> {t.home.projectsButton}
          </a>
        </div>
      </div>
      
      <aside class="hero-status">
        <div class="status-card">
          <h3 class="status-title">{localizeString(currentStatus.title, lang)}</h3>
          <div class="status-badge">{localizeString(currentStatus.badge, lang)}</div>
          <ul class="status-list">
            {currentStatus.items.map((item) => (
              <li>
                <Icon name={item.icon} size={16} />
                {item.url ? (
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    {localizeString(item.text, lang)}
                  </a>
                ) : (
                  <span>{localizeString(item.text, lang)}</span>
                )}
              </li>
            ))}
          </ul>
        </div>

        <SiteStats
          variant="panel"
          eyebrow={t.siteStats.eyebrow}
          title={t.siteStats.title}
          labels={t.siteStats}
        />

      </aside>
    </section>

    <!-- Activity Constellation -->
    <section class="activity">
      <div class="activity-header">
        <div>
          <p class="section-kicker">{t.home.activityKicker}</p>
          <h2>{t.home.signalMap}</h2>
          <p class="activity-range">
            <span class="activity-range-full">{activityRangeLabel}</span>
            <span class="activity-range-compact">{compactActivityRangeLabel}</span>
          </p>
        </div>
        <div class="activity-stats activity-stats--full">
          <span>{blogSignalCount} {t.home.blogUpdates}</span>
          <span>{activitySignalCount} {t.home.activities}</span>
          <span>{milestoneSignalCount} {t.home.milestones}</span>
          <span>{activeDays} {t.home.activeDays}</span>
        </div>
        <div class="activity-stats activity-stats--compact">
          <span>{compactBlogSignalCount} {t.home.blogUpdates}</span>
          <span>{compactActivitySignalCount} {t.home.activities}</span>
          <span>{compactMilestoneSignalCount} {t.home.milestones}</span>
          <span>{compactActiveDays} {t.home.activeDays}</span>
        </div>
      </div>

      <div class="activity-panel">
        <div class="activity-chart">
          <div class="activity-map-frame activity-map-frame--full">
            <div class="activity-map">
              <div class="activity-years" aria-hidden="true">
                {activityYearLabels.map((year) => (
                  <span>{year}</span>
                ))}
              </div>

              <div class="activity-months" aria-hidden="true">
                {activityMonthLabels.map((month) => (
                  <span>{month}</span>
                ))}
              </div>

              <div class="activity-calendar">
                <div class="activity-weekdays" aria-hidden="true">
                  {activityWeekdayLabels.map((day) => (
                    <span>{day}</span>
                  ))}
                </div>

                <div class="activity-grid" role="img" aria-label={activityLabel}>
                  {activityWeeks.map((week) => (
                    <div class="activity-week">
                      {week.map((day) => {
                        const titles = day.signals
                          .map((signal) => `${signal.displayDate} (${signal.dateSource}): ${signal.title}`)
                          .join(' / ');
                        const signalTypes = new Set(day.signals.map((signal) => signal.type));
                        const typeClass = signalTypes.size > 1
                          ? 'mixed'
                          : signalTypes.has('blog')
                            ? 'blog'
                            : signalTypes.has('activity')
                            ? 'activity'
                            : signalTypes.has('milestone')
                              ? 'milestone'
                              : 'quiet';
                        const label = day.signals.length > 0
                          ? titles
                          : `${day.displayDate}: ${t.home.noSignal}`;

                        return (
                          <span
                            class={`activity-dot activity-dot--${day.intensity} activity-dot--${typeClass}`}
                            title={label}
                            aria-label={label}
                          />
                        );
                      })}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div class="activity-map-frame activity-map-frame--compact">
            <div class="activity-map activity-map--compact">
              <div class="activity-years" aria-hidden="true">
                {compactActivityYearLabels.map((year) => (
                  <span>{year}</span>
                ))}
              </div>

              <div class="activity-months" aria-hidden="true">
                {compactActivityMonthLabels.map((month) => (
                  <span>{month}</span>
                ))}
              </div>

              <div class="activity-calendar">
                <div class="activity-weekdays" aria-hidden="true">
                  {activityWeekdayLabels.map((day) => (
                    <span>{day}</span>
                  ))}
                </div>

                <div class="activity-grid" role="img" aria-label={compactActivityLabel}>
                  {compactActivityWeeks.map((week) => (
                    <div class="activity-week">
                      {week.map((day) => {
                        const titles = day.signals
                          .map((signal) => `${signal.displayDate} (${signal.dateSource}): ${signal.title}`)
                          .join(' / ');
                        const signalTypes = new Set(day.signals.map((signal) => signal.type));
                        const typeClass = signalTypes.size > 1
                          ? 'mixed'
                          : signalTypes.has('blog')
                            ? 'blog'
                            : signalTypes.has('activity')
                            ? 'activity'
                            : signalTypes.has('milestone')
                              ? 'milestone'
                              : 'quiet';
                        const label = day.signals.length > 0
                          ? titles
                          : `${day.displayDate}: ${t.home.noSignal}`;

                        return (
                          <span
                            class={`activity-dot activity-dot--${day.intensity} activity-dot--${typeClass}`}
                            title={label}
                            aria-label={label}
                          />
                        );
                      })}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div class="activity-legend" aria-label={t.home.activityLegend}>
            <span><i class="activity-dot activity-dot--1 activity-dot--blog"></i> {t.home.signalTypeBlog}</span>
            <span><i class="activity-dot activity-dot--1 activity-dot--activity"></i> {t.home.signalTypeActivity}</span>
            <span><i class="activity-dot activity-dot--1 activity-dot--milestone"></i> {t.home.signalTypeMilestone}</span>
            <span><i class="activity-dot activity-dot--2 activity-dot--mixed"></i> {t.home.signalTypeMixed}</span>
          </div>

          <div class="github-activity is-fallback" aria-label={t.home.githubContributions} data-github-activity>
            <div class="github-activity-header">
              <span><Icon name="github" size={14} /> {t.home.githubContributions}</span>
              <a href={githubProfileUrl} target="_blank" rel="noopener noreferrer">@{githubUsername}</a>
            </div>
            <a
              class="github-activity-frame"
              href={githubProfileUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div
                class="github-calendar github-calendar--full"
                data-github-calendar
                data-username={githubUsername}
                data-start={toDateKey(gridStart)}
                data-end={toDateKey(gridEnd)}
                role="img"
                aria-label={`${githubUsername} ${t.home.githubCalendarLabel}`}
              ></div>
              <div
                class="github-calendar github-calendar--compact"
                data-github-calendar
                data-username={githubUsername}
                data-start={toDateKey(compactGridStart)}
                data-end={toDateKey(gridEnd)}
                role="img"
                aria-label={`${githubUsername} ${t.home.githubCalendarLabel}`}
              ></div>
              <img
                class="github-activity-fallback"
                src={githubContributionChartUrl}
                alt={`${githubUsername} ${t.home.githubCalendarLabel}`}
                width="663"
                height="104"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            </a>
          </div>
        </div>

        <aside class="activity-log" aria-label={t.home.latestSignals}>
          <p class="activity-log-title">{t.home.latestSignals}</p>
          <ol>
            {recentSignals.map((signal) => (
              <li>
                <a href={signal.href}>
                  <span class={`activity-type activity-type--${signal.type}`}>
                    {signal.type === 'milestone'
                      ? t.home.signalTypeMilestone
                      : signal.type === 'activity'
                        ? t.home.signalTypeActivity
                        : t.home.signalTypeBlog}
                  </span>
                  <span class="activity-log-main">
                    <time datetime={signal.datetime}>{signal.displayDate}</time>
                    <strong>{signal.title}</strong>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </aside>
      </div>
    </section>
    
    <HomeShowcase
      lang={lang}
      labels={t.home}
      latestPosts={latestPosts}
      githubProfileUrl={githubProfileUrl}
      sponsorContactUrl={sponsorContactUrl}
    />
  </div>
</BaseLayout>

<HomeInteractions />

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-xl);
    align-items: start;
    padding: var(--space-xl) 0;
  }
  
  .hero-greeting {
    color: var(--color-text-secondary);
    font-size: 1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
  }
  
  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: var(--space-md);
  }
  
  .title-line {
    font-size: 4rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    line-height: 1.1;
  }
  
  .title-decoration {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    margin: var(--space-xs) 0;
    color: var(--color-brass);
  }

  .title-rule {
    width: 1.55rem;
    height: 2px;
    background: linear-gradient(90deg, var(--color-brass), rgba(201, 162, 39, 0.38));
  }

  .title-rule:last-child {
    background: linear-gradient(90deg, rgba(201, 162, 39, 0.38), var(--color-brass));
  }

  .title-star {
    display: block;
    width: 1.18rem;
    height: 1.18rem;
    overflow: visible;
    filter: drop-shadow(0 0 6px rgba(201, 162, 39, 0.32));
  }

  .title-star-core {
    fill: currentColor;
  }
  
  .hero-tagline {
    font-style: italic;
    color: var(--color-text-secondary);
    font-size: 1.15rem;
    margin-bottom: var(--space-lg);
    padding-left: var(--space-md);
    border-left: 2px solid var(--color-brass-dark);
  }
  
  .hero-intro {
    max-width: 500px;
    margin-bottom: var(--space-lg);
  }
  
  .hero-intro p {
    color: var(--color-text-secondary);
    line-height: 1.8;
  }
  
  .highlight,
  .hero-intro :global(.highlight) {
    color: var(--color-brass-light);
    font-weight: 500;
  }

  .hero-intro :global(.intro-link) {
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .hero-intro :global(.intro-link:hover),
  .hero-intro :global(.intro-link:focus-visible) {
    color: var(--color-brass);
  }
  
  .hero-actions {
    display: flex;
    gap: var(--space-md);
  }

  .hero-actions .btn {
    background: transparent;
    border: 1px solid var(--color-brass);
    border-radius: 0;
    color: var(--color-brass);
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transform: none;
  }

  .hero-actions .btn :global(.icon) {
    transition: color 0.3s ease;
  }

  .hero-actions .btn:hover {
    background: var(--color-brass);
    border-color: var(--color-brass);
    color: var(--color-bg-primary);
    box-shadow: none;
    transform: none;
  }

  .hero-actions .btn:hover :global(.icon) {
    color: var(--color-bg-primary);
  }
  
  .hero-status {
    width: auto;
    min-width: 200px;
    display: grid;
    gap: var(--space-md);
  }
  
  .status-card {
    position: relative;
    padding: var(--space-lg);
    background: rgba(13, 13, 18, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid var(--color-border);
  }
  
  /* 星星装饰 */
  .status-card::before,
  .status-card::after {
    content: '◈';
    position: absolute;
    color: var(--color-brass);
    font-size: 0.75rem;
    opacity: 0.6;
  }
  
  .status-card::before {
    top: -0.4rem;
    left: -0.4rem;
  }
  
  .status-card::after {
    bottom: -0.4rem;
    right: -0.4rem;
  }
  
  .status-title {
    font-size: 0.85rem;
    color: var(--color-brass);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: var(--space-md);
  }
  
  .status-badge {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-brass-light);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }
  
  .status-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  
  .status-list li {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }
  
  .status-list li svg {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .status-list li a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .status-list li a:hover {
    color: #d4af37;
  }

  .activity {
    padding: var(--space-lg) 0 var(--space-xl);
    overflow-x: hidden;
    overflow-x: clip;
  }

  .activity-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  .section-kicker {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .activity-header h2 {
    margin-bottom: 0;
  }

  .activity-range {
    margin: 0.35rem 0 0;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .activity-stats {
    display: flex;
    gap: var(--space-md);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .activity-range-compact,
  .activity-stats--compact,
  .activity-map-frame--compact {
    display: none;
  }

  .activity-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(240px, 300px);
    gap: var(--space-md);
    align-items: start;
    padding: var(--space-lg);
    background:
      linear-gradient(135deg, rgba(201, 162, 39, 0.08), transparent 36%),
      rgba(13, 13, 18, 0.64);
    border: 1px solid var(--color-border);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
    min-width: 0;
  }

  .activity-chart {
    --activity-cell: 9px;
    --activity-gap: 3px;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    padding-bottom: var(--space-xs);
  }

  .activity-map-frame {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: visible;
    overscroll-behavior-x: contain;
    padding: 0.15rem 0 var(--space-xs);
    scrollbar-color: rgba(201, 162, 39, 0.46) rgba(255, 255, 255, 0.05);
    scrollbar-width: thin;
  }

  .activity-map-frame.activity-map-frame--compact {
    display: none;
  }

  .activity-map-frame::-webkit-scrollbar,
  .github-activity-frame::-webkit-scrollbar {
    height: 8px;
  }

  .activity-map-frame::-webkit-scrollbar-track,
  .github-activity-frame::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.04);
  }

  .activity-map-frame::-webkit-scrollbar-thumb,
  .github-activity-frame::-webkit-scrollbar-thumb {
    background: rgba(201, 162, 39, 0.42);
    border-radius: 999px;
  }

  .activity-map {
    width: max-content;
  }

  .activity-years,
  .activity-months {
    display: grid;
    grid-template-columns: repeat(52, var(--activity-cell));
    gap: var(--activity-gap);
    width: max-content;
    padding-left: 1.9rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    line-height: 1;
  }

  .activity-years {
    margin-bottom: 0.3rem;
    font-size: 0.7rem;
    font-weight: 600;
  }

  .activity-months {
    margin-bottom: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.68rem;
  }

  .activity-months span {
    min-height: 0.7rem;
  }

  .activity-calendar {
    display: grid;
    grid-template-columns: 1.45rem max-content;
    gap: 0.45rem;
    align-items: start;
  }

  .activity-weekdays {
    display: grid;
    grid-template-rows: repeat(7, var(--activity-cell));
    gap: var(--activity-gap);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: var(--activity-cell);
  }

  .activity-grid {
    display: grid;
    grid-template-columns: repeat(52, var(--activity-cell));
    gap: var(--activity-gap);
    width: max-content;
    padding: 0 0 var(--space-xs);
  }

  .activity-map--compact .activity-years,
  .activity-map--compact .activity-months,
  .activity-map--compact .activity-grid {
    grid-template-columns: repeat(26, var(--activity-cell));
  }

  .activity-week {
    display: grid;
    grid-template-rows: repeat(7, var(--activity-cell));
    gap: var(--activity-gap);
  }

  .activity-dot {
    display: block;
    width: var(--activity-cell, 9px);
    height: var(--activity-cell, 9px);
    box-sizing: border-box;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.035);
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .activity-dot--blog {
    background: rgba(106, 171, 255, 0.72);
    border-color: rgba(160, 200, 255, 0.34);
    box-shadow: 0 0 8px rgba(106, 171, 255, 0.2);
  }

  .activity-dot--activity {
    background: rgba(148, 196, 179, 0.68);
    border-color: rgba(176, 220, 205, 0.3);
    box-shadow: 0 0 8px rgba(148, 196, 179, 0.18);
  }

  .activity-dot--milestone {
    background: rgba(201, 162, 39, 0.78);
    border-color: rgba(212, 168, 75, 0.36);
    box-shadow: 0 0 8px rgba(201, 162, 39, 0.22);
  }

  .activity-dot--mixed {
    background: conic-gradient(from 90deg, rgba(106, 171, 255, 0.85), rgba(148, 196, 179, 0.82), rgba(241, 213, 122, 0.95), rgba(106, 171, 255, 0.85));
    border-color: rgba(245, 245, 245, 0.22);
    box-shadow: 0 0 10px rgba(212, 168, 75, 0.4);
  }

  .activity-dot--2,
  .activity-dot--3,
  .activity-dot--4 {
    border-color: rgba(245, 245, 245, 0.28);
  }

  .activity-dot:hover {
    transform: scale(1.35);
    border-color: var(--color-brass-light);
  }

  .activity-legend {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-sm);
