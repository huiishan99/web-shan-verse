---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import SiteStats from '../SiteStats.astro';
import { currentStatus } from '../../data/status';
import { timelineData } from '../../data/timeline';
import { getCollection } from 'astro:content';
import { defaultLocale, localizeMonth, localizePath, localizeString, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getBlogPostPath, isPostVisibleInLocale } from '../../utils/blog';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const aboutPath = localizePath('/about', lang);
const introHtml = t.home.intro.replace(
  '{aboutLink}',
  `<a class="highlight intro-link" href="${aboutPath}">${t.home.aboutButton}</a>`
);
const dateLocale: Record<Locale, string> = {
  en: 'en-US',
  zh: 'zh-CN',
  ja: 'ja-JP',
};
const activityLabelLocale = 'en-US';
const activityTimeZone = 'Asia/Tokyo';
const activityWeekdayLabels = ['', 'Mon', '', 'Wed', '', 'Fri', ''];

// 获取最新3篇博客文章
const collectedPosts = await getCollection('blog', ({ data }) => !data.draft);
const allPosts = collectedPosts.filter((post) => isPostVisibleInLocale(post, lang));
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

type HomepagePetMood = 'idle' | 'waving' | 'failed';

// Keep the homepage pet available for later without rendering it now.
const showHomepagePet = false;

// Change this to 'waving' or 'failed' when you want the homepage pet to react.
// The pet uses a stable frame from each row; full-row playback flashes on some Codex Pet atlases.
const homepagePetMood: HomepagePetMood = 'idle';
const homepagePetRows: Record<HomepagePetMood, number> = {
  idle: 0,
  waving: 1,
  failed: 8,
};
const homepagePetRowOffset = `${homepagePetRows[homepagePetMood] * 12.5}%`;

const monthIndex: Record<string, number> = {
  January: 0,
  February: 1,
  March: 2,
  April: 3,
  May: 4,
  June: 5,
  July: 6,
  August: 7,
  September: 8,
  October: 9,
  November: 10,
  December: 11,
};

type ActivitySignal = {
  date: Date;
  datetime: string;
  displayDate: string;
  dateSource: 'blog date' | 'timeline date' | 'timeline month';
  href: string;
  title: string;
  type: 'blog' | 'activity' | 'milestone';
};

const postSignals: ActivitySignal[] = allPosts.map((post) => ({
  date: post.data.date,
  datetime: toDateKey(post.data.date),
  displayDate: formatActivityDate(post.data.date),
  dateSource: 'blog date',
  href: getBlogPostPath(post, lang),
  title: post.data.title,
  type: 'blog',
}));

const timelineSignals: ActivitySignal[] = timelineData.flatMap((yearData) =>
  yearData.events.map((event) => {
    const englishMonth = localizeString(event.month, 'en');
    const eventMonthIndex = monthIndex[englishMonth] ?? 0;
    const eventMonth = localizeMonth(event.month, lang);
    const preciseEventDate = event.date && event.datePrecision !== 'month'
      ? new Date(`${event.date}T00:00:00Z`)
      : undefined;
    const eventDate = preciseEventDate ?? new Date(Date.UTC(yearData.year, eventMonthIndex, 15));

    return {
      // Month-level entries are placed at mid-month; exact dates can opt in with `event.date`.
      date: eventDate,
      datetime: preciseEventDate
        ? toDateKey(preciseEventDate)
        : `${yearData.year}-${String(eventMonthIndex + 1).padStart(2, '0')}`,
      displayDate: `${eventMonth} ${yearData.year}`,
      dateSource: preciseEventDate ? 'timeline date' as const : 'timeline month' as const,
      href: localizePath('/timeline', lang),
      title: localizeString(event.title, lang),
      type: event.weight === 'major' ? 'milestone' as const : 'activity' as const,
    };
  })
);

const activitySignals = [...postSignals, ...timelineSignals];

function toDateKey(date: Date): string {
  return date.toISOString().slice(0, 10);
}

function startOfDay(date: Date): Date {
  return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
}

function addDays(date: Date, days: number): Date {
  const nextDate = new Date(date);
  nextDate.setUTCDate(nextDate.getUTCDate() + days);
  return nextDate;
}

function formatActivityDate(date: Date): string {
  return date.toLocaleDateString(dateLocale[lang], {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

function formatActivityMonthYear(date: Date): string {
  return date.toLocaleDateString(activityLabelLocale, {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

function filterCrowdedMonthLabels(labels: string[], minGap: number = 3): string[] {
  const filteredLabels = [...labels];
  let previousLabelIndex = -1;

  labels.forEach((label, index) => {
    if (!label) return;

    if (previousLabelIndex >= 0 && index - previousLabelIndex < minGap) {
      filteredLabels[previousLabelIndex] = '';
    }

    previousLabelIndex = index;
  });

  return filteredLabels;
}

function startOfTodayInTimeZone(timeZone: string): Date {
  const parts = new Intl.DateTimeFormat('en-US', {
    day: '2-digit',
    month: '2-digit',
    timeZone,
    year: 'numeric',
  }).formatToParts(new Date());
  const getPart = (type: Intl.DateTimeFormatPartTypes): number =>
    Number(parts.find((part) => part.type === type)?.value);

  return new Date(Date.UTC(getPart('year'), getPart('month') - 1, getPart('day')));
}

const today = startOfTodayInTimeZone(activityTimeZone);
const fullWeekCount = 52;
const compactWeekCount = 26;
const gridEnd = addDays(today, 6 - today.getUTCDay());
const gridStart = addDays(gridEnd, -(fullWeekCount * 7 - 1));
const compactGridStart = addDays(gridEnd, -(compactWeekCount * 7 - 1));
const activityRangeLabel = `${formatActivityMonthYear(gridStart)} - ${formatActivityMonthYear(gridEnd)}`;
const compactActivityRangeLabel = `${formatActivityMonthYear(compactGridStart)} - ${formatActivityMonthYear(gridEnd)}`;

const signalsByDay = activitySignals.reduce<Record<string, ActivitySignal[]>>((acc, signal) => {
  const key = toDateKey(startOfDay(signal.date));
  acc[key] = [...(acc[key] || []), signal];
  return acc;
}, {});

function buildActivityWeeks(startDate: Date, weekCount: number) {
  return Array.from({ length: weekCount }, (_, weekIndex) =>
    Array.from({ length: 7 }, (_, dayIndex) => {
      const date = addDays(startDate, weekIndex * 7 + dayIndex);
      const signals = signalsByDay[toDateKey(date)] || [];
      const intensity = Math.min(signals.length, 4);

      return {
        date,
        key: toDateKey(date),
        signals,
        intensity,
      };
    })
  );
}

function getActivityMonthLabels(
  weeks: ReturnType<typeof buildActivityWeeks>
): string[] {
  return filterCrowdedMonthLabels(weeks.map((week, weekIndex) => {
    const firstOfMonth = week.find((day) => day.date.getUTCDate() === 1);
    const labelDate = firstOfMonth?.date || (weekIndex === 0 ? week[0].date : null);

    return labelDate
      ? labelDate.toLocaleDateString(activityLabelLocale, { month: 'short', timeZone: 'UTC' })
      : '';
  }));
}

function getActivityYearLabels(
  weeks: ReturnType<typeof buildActivityWeeks>
): string[] {
  return weeks.map((week, weekIndex) => {
    const firstOfYear = week.find((day) => day.date.getUTCMonth() === 0 && day.date.getUTCDate() === 1);
    const labelDate = firstOfYear?.date || (weekIndex === 0 ? week[0].date : null);

    return labelDate ? String(labelDate.getUTCFullYear()) : '';
  });
}

function getVisibleSignals(startDate: Date): ActivitySignal[] {
  return activitySignals
    .filter((signal) => {
      const signalDate = startOfDay(signal.date);
      return signalDate >= startDate && signalDate <= gridEnd;
    })
    .sort((a, b) => b.date.getTime() - a.date.getTime());
}

function getActiveDayCount(signals: ActivitySignal[]): number {
  return new Set(signals.map((signal) => toDateKey(startOfDay(signal.date)))).size;
}

const activityWeeks = buildActivityWeeks(gridStart, fullWeekCount);
const compactActivityWeeks = buildActivityWeeks(compactGridStart, compactWeekCount);

const activityMonthLabels = getActivityMonthLabels(activityWeeks);
const compactActivityMonthLabels = getActivityMonthLabels(compactActivityWeeks);
const activityYearLabels = getActivityYearLabels(activityWeeks);
const compactActivityYearLabels = getActivityYearLabels(compactActivityWeeks);

const visibleSignals = getVisibleSignals(gridStart);
const compactVisibleSignals = getVisibleSignals(compactGridStart);
const activeDays = getActiveDayCount(visibleSignals);
const compactActiveDays = getActiveDayCount(compactVisibleSignals);
const totalSignals = visibleSignals.length;
const compactTotalSignals = compactVisibleSignals.length;
const activityLabel = `${t.home.signalMap} ${activityRangeLabel}: ${totalSignals} ${t.home.totalSignals}, ${activeDays} ${t.home.activeDays}.`;
const compactActivityLabel = `${t.home.signalMap} ${compactActivityRangeLabel}: ${compactTotalSignals} ${t.home.totalSignals}, ${compactActiveDays} ${t.home.activeDays}.`;
const recentSignals = visibleSignals.slice(0, 6);
const blogSignalCount = visibleSignals.filter((signal) => signal.type === 'blog').length;
const activitySignalCount = visibleSignals.filter((signal) => signal.type === 'activity').length;
const milestoneSignalCount = visibleSignals.filter((signal) => signal.type === 'milestone').length;
const compactBlogSignalCount = compactVisibleSignals.filter((signal) => signal.type === 'blog').length;
const compactActivitySignalCount = compactVisibleSignals.filter((signal) => signal.type === 'activity').length;
const compactMilestoneSignalCount = compactVisibleSignals.filter((signal) => signal.type === 'milestone').length;
const githubUsername = 'huiishan99';
const githubProfileUrl = `https://github.com/${githubUsername}`;
const githubContributionChartUrl = `https://ghchart.rshah.org/C9A227/${githubUsername}`;
const sponsorContactUrl = 'https://linkedin.com/in/laihuishan/';

// 提取文章第一段内容
function getExcerpt(body: string, maxLength: number = 100): string {
  // 移除 markdown 语法，提取纯文本
  const cleanText = body
    .replace(/^---[\s\S]*?---/m, '')  // 移除 frontmatter
    .replace(/!\[.*?\]\(.*?\)/g, '')  // 移除图片
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')  // 链接只保留文字
    .replace(/[#*`>\-]/g, '')  // 移除 markdown 符号
    .replace(/\n+/g, ' ')  // 换行变空格
    .trim();
  
  if (cleanText.length <= maxLength) return cleanText;
  return cleanText.slice(0, maxLength).trim() + '...';
}
---

<BaseLayout title={t.home.title} lang={lang}>
  <div class="container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <p class="hero-greeting">{t.home.greeting}</p>
        <h1 class="hero-title">
          <span class="title-line">SHAN</span>
          <span class="title-decoration" aria-hidden="true">
            <span class="title-rule"></span>
            <svg class="title-star" viewBox="0 0 64 64" focusable="false">
              <path
                class="title-star-core"
                d="M32 2C35.2 19.6 44.4 28.8 62 32C44.4 35.2 35.2 44.4 32 62C28.8 44.4 19.6 35.2 2 32C19.6 28.8 28.8 19.6 32 2Z"
              />
            </svg>
            <span class="title-rule"></span>
          </span>
          <span class="title-line">VERSE</span>
        </h1>
        <p class="hero-tagline">{t.home.tagline}</p>
        
        <div class="hero-intro">
          <p set:html={introHtml}></p>
        </div>
        
        <div class="hero-actions">
          <a href={aboutPath} class="btn">
            <Icon name="gear" size={16} /> {t.home.aboutButton}
          </a>
          <a href={localizePath('/journey', lang)} class="btn" data-journey-preload data-astro-prefetch="hover">
            <Icon name="earthAtlas" size={16} /> {t.home.projectsButton}
          </a>
        </div>
      </div>
      
      <aside class="hero-status">
        <div class="status-card">
          <h3 class="status-title">{localizeString(currentStatus.title, lang)}</h3>
          <div class="status-badge">{localizeString(currentStatus.badge, lang)}</div>
          <ul class="status-list">
            {currentStatus.items.map((item) => (
              <li>
                <Icon name={item.icon} size={16} />
                {item.url ? (
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    {localizeString(item.text, lang)}
                  </a>
                ) : (
                  <span>{localizeString(item.text, lang)}</span>
                )}
              </li>
            ))}
          </ul>
        </div>

        <SiteStats
          variant="panel"
          eyebrow={t.siteStats.eyebrow}
          title={t.siteStats.title}
          labels={t.siteStats}
        />

        {showHomepagePet && (
          <div
            class="observatory-companion"
            aria-label={`YoRHa companion pet, ${homepagePetMood}`}
            role="button"
            tabindex="0"
            data-pet-mood={homepagePetMood}
            data-pet-default-mood={homepagePetMood}
            style={`--pet-row-offset: ${homepagePetRowOffset};`}
          >
            <div class="companion-pet" aria-hidden="true">
              <span class="companion-sprite companion-sprite--yorha"></span>
            </div>
          </div>
        )}
      </aside>
    </section>

    <!-- Activity Constellation -->
    <section class="activity">
      <div class="activity-header">
        <div>
          <p class="section-kicker">{t.home.activityKicker}</p>
          <h2>{t.home.signalMap}</h2>
          <p class="activity-range">
            <span class="activity-range-full">{activityRangeLabel}</span>
            <span class="activity-range-compact">{compactActivityRangeLabel}</span>
          </p>
        </div>
        <div class="activity-stats activity-stats--full">
          <span>{blogSignalCount} {t.home.blogUpdates}</span>
          <span>{activitySignalCount} {t.home.activities}</span>
          <span>{milestoneSignalCount} {t.home.milestones}</span>
          <span>{activeDays} {t.home.activeDays}</span>
        </div>
        <div class="activity-stats activity-stats--compact">
          <span>{compactBlogSignalCount} {t.home.blogUpdates}</span>
          <span>{compactActivitySignalCount} {t.home.activities}</span>
          <span>{compactMilestoneSignalCount} {t.home.milestones}</span>
          <span>{compactActiveDays} {t.home.activeDays}</span>
        </div>
      </div>

      <div class="activity-panel">
        <div class="activity-chart">
          <div class="activity-map-frame activity-map-frame--full">
            <div class="activity-map">
              <div class="activity-years" aria-hidden="true">
                {activityYearLabels.map((year) => (
                  <span>{year}</span>
                ))}
              </div>

              <div class="activity-months" aria-hidden="true">
                {activityMonthLabels.map((month) => (
                  <span>{month}</span>
                ))}
              </div>

              <div class="activity-calendar">
                <div class="activity-weekdays" aria-hidden="true">
                  {activityWeekdayLabels.map((day) => (
                    <span>{day}</span>
                  ))}
                </div>

                <div class="activity-grid" role="img" aria-label={activityLabel}>
                  {activityWeeks.map((week) => (
                    <div class="activity-week">
                      {week.map((day) => {
                        const titles = day.signals
                          .map((signal) => `${signal.displayDate} (${signal.dateSource}): ${signal.title}`)
                          .join(' / ');
                        const signalTypes = new Set(day.signals.map((signal) => signal.type));
                        const typeClass = signalTypes.size > 1
                          ? 'mixed'
                          : signalTypes.has('blog')
                            ? 'blog'
                            : signalTypes.has('activity')
                            ? 'activity'
                            : signalTypes.has('milestone')
                              ? 'milestone'
                              : 'quiet';
                        const label = day.signals.length > 0
                          ? titles
                          : `${formatActivityDate(day.date)}: ${t.home.noSignal}`;

                        return (
                          <span
                            class={`activity-dot activity-dot--${day.intensity} activity-dot--${typeClass}`}
                            title={label}
                            aria-label={label}
                          />
                        );
                      })}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div class="activity-map-frame activity-map-frame--compact">
            <div class="activity-map activity-map--compact">
              <div class="activity-years" aria-hidden="true">
                {compactActivityYearLabels.map((year) => (
                  <span>{year}</span>
                ))}
              </div>

              <div class="activity-months" aria-hidden="true">
                {compactActivityMonthLabels.map((month) => (
                  <span>{month}</span>
                ))}
              </div>

              <div class="activity-calendar">
                <div class="activity-weekdays" aria-hidden="true">
                  {activityWeekdayLabels.map((day) => (
                    <span>{day}</span>
                  ))}
                </div>

                <div class="activity-grid" role="img" aria-label={compactActivityLabel}>
                  {compactActivityWeeks.map((week) => (
                    <div class="activity-week">
                      {week.map((day) => {
                        const titles = day.signals
                          .map((signal) => `${signal.displayDate} (${signal.dateSource}): ${signal.title}`)
                          .join(' / ');
                        const signalTypes = new Set(day.signals.map((signal) => signal.type));
                        const typeClass = signalTypes.size > 1
                          ? 'mixed'
                          : signalTypes.has('blog')
                            ? 'blog'
                            : signalTypes.has('activity')
                            ? 'activity'
                            : signalTypes.has('milestone')
                              ? 'milestone'
                              : 'quiet';
                        const label = day.signals.length > 0
                          ? titles
                          : `${formatActivityDate(day.date)}: ${t.home.noSignal}`;

                        return (
                          <span
                            class={`activity-dot activity-dot--${day.intensity} activity-dot--${typeClass}`}
                            title={label}
                            aria-label={label}
                          />
                        );
                      })}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div class="activity-legend" aria-label={t.home.activityLegend}>
            <span><i class="activity-dot activity-dot--1 activity-dot--blog"></i> {t.home.signalTypeBlog}</span>
            <span><i class="activity-dot activity-dot--1 activity-dot--activity"></i> {t.home.signalTypeActivity}</span>
            <span><i class="activity-dot activity-dot--1 activity-dot--milestone"></i> {t.home.signalTypeMilestone}</span>
            <span><i class="activity-dot activity-dot--2 activity-dot--mixed"></i> {t.home.signalTypeMixed}</span>
          </div>

          <div class="github-activity is-fallback" aria-label={t.home.githubContributions} data-github-activity>
            <div class="github-activity-header">
              <span><Icon name="github" size={14} /> {t.home.githubContributions}</span>
              <a href={githubProfileUrl} target="_blank" rel="noopener noreferrer">@{githubUsername}</a>
            </div>
            <a
              class="github-activity-frame"
              href={githubProfileUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div
                class="github-calendar github-calendar--full"
                data-github-calendar
                data-username={githubUsername}
                data-start={toDateKey(gridStart)}
                data-end={toDateKey(gridEnd)}
                role="img"
                aria-label={`${githubUsername} ${t.home.githubCalendarLabel}`}
              ></div>
              <div
                class="github-calendar github-calendar--compact"
                data-github-calendar
                data-username={githubUsername}
                data-start={toDateKey(compactGridStart)}
                data-end={toDateKey(gridEnd)}
                role="img"
                aria-label={`${githubUsername} ${t.home.githubCalendarLabel}`}
              ></div>
              <img
                class="github-activity-fallback"
                src={githubContributionChartUrl}
                alt={`${githubUsername} ${t.home.githubCalendarLabel}`}
                width="663"
                height="104"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            </a>
          </div>
        </div>

        <aside class="activity-log" aria-label={t.home.latestSignals}>
          <p class="activity-log-title">{t.home.latestSignals}</p>
          <ol>
            {recentSignals.map((signal) => (
              <li>
                <a href={signal.href}>
                  <span class={`activity-type activity-type--${signal.type}`}>
                    {signal.type === 'milestone'
                      ? t.home.signalTypeMilestone
                      : signal.type === 'activity'
                        ? t.home.signalTypeActivity
                        : t.home.signalTypeBlog}
                  </span>
                  <span class="activity-log-main">
                    <time datetime={signal.datetime}>{signal.displayDate}</time>
                    <strong>{signal.title}</strong>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </aside>
      </div>
    </section>
    
    <!-- Featured Section -->
    <section class="featured">
      <div class="divider">
        <span class="divider-icon">◈</span>
      </div>
      
      <h2>{t.home.featuredWorks}</h2>
      
      <div class="featured-grid">
        <a href={`${localizePath('/projects', lang)}#unity`} class="featured-card">
          <div class="featured-icon"><Icon name="gamepad" size={28} /></div>
          <h3>{t.home.unityTitle}</h3>
          <p>{t.home.unityDesc}</p>
        </a>
        
        <a href={`${localizePath('/projects', lang)}#web`} class="featured-card">
          <div class="featured-icon"><Icon name="globe" size={28} /></div>
          <h3>{t.home.webTitle}</h3>
          <p>{t.home.webDesc}</p>
        </a>
        
        <a href={localizePath('/blog', lang)} class="featured-card">
          <div class="featured-icon"><Icon name="pen" size={28} /></div>
          <h3>{t.home.blogTitle}</h3>
          <p>{t.home.blogDesc}</p>
        </a>
      </div>
    </section>
    
    <!-- Latest Posts Preview -->
    <section class="latest">
      <div class="divider">
        <Icon name="gear" size={20} class="divider-icon" />
      </div>
      
      <h2>{t.home.latestPosts}</h2>
      
      <div class="posts-grid">
        {latestPosts.map((post) => (
          <a href={getBlogPostPath(post, lang)} class="post-card">
            <div class="post-date">
              {new Date(post.data.date).toLocaleDateString(dateLocale[lang], { 
                year: 'numeric', 
                month: 'short', 
                day: 'numeric' 
              })}
            </div>
            <h3 class="post-title">{post.data.title}</h3>
            <p class="post-excerpt">{getExcerpt(post.body)}</p>
          </a>
        ))}
      </div>
      
      <div class="posts-action">
        <a href={localizePath('/blog', lang)} class="btn">
          <span>→</span> {t.home.viewAllPosts}
        </a>
      </div>
    </section>

    <section class="support-note" aria-labelledby="support-note-title">
      <div class="support-note-copy">
        <p class="section-kicker">{t.home.supportKicker}</p>
        <h2 id="support-note-title">{t.home.supportTitle}</h2>
        <p>{t.home.supportBody}</p>
        <span>{t.home.supportFinePrint}</span>
      </div>

      <div class="support-note-actions">
        <a href={githubProfileUrl} class="support-note-link" target="_blank" rel="noopener noreferrer">
          <Icon name="github" size={16} /> {t.home.supportGithub}
        </a>
        <a href={sponsorContactUrl} class="support-note-link support-note-link--primary" target="_blank" rel="noopener noreferrer">
          <Icon name="heart" size={16} /> {t.home.supportContact}
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const API_ROOT = 'https://github-contributions-api.jogruber.de/v4/';
    const WEEKDAYS = ['', 'Mon', '', 'Wed', '', 'Fri', ''];
    const githubCalendarState = window.__shanGithubCalendarState || {
      contributionRequests: new Map(),
      isListening: false,
    };
    window.__shanGithubCalendarState = githubCalendarState;
    const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });
    const dateFormatter = new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC',
    });

    function parseUTCDate(dateKey) {
      const [year, month, day] = dateKey.split('-').map(Number);
      return new Date(Date.UTC(year, month - 1, day));
    }

    function addDays(date, days) {
      const nextDate = new Date(date);
      nextDate.setUTCDate(nextDate.getUTCDate() + days);
      return nextDate;
    }

    function toDateKey(date) {
      return date.toISOString().slice(0, 10);
    }

    function buildWeeks(startKey, endKey, contributions) {
      const start = parseUTCDate(startKey);
      const end = parseUTCDate(endKey);
      const contributionByDate = new Map(
        contributions.map((item) => [item.date, item])
      );
      const days = [];

      for (let date = start; date <= end; date = addDays(date, 1)) {
        const key = toDateKey(date);
        days.push({
          date: new Date(date),
          key,
          contribution: contributionByDate.get(key) || { count: 0, level: 0 },
        });
      }

      const weeks = [];
      for (let index = 0; index < days.length; index += 7) {
        weeks.push(days.slice(index, index + 7));
      }

      return weeks;
    }

    function filterCrowdedLabels(labels, minGap = 3) {
      const filteredLabels = [...labels];
      let previousLabelIndex = -1;

      labels.forEach((label, index) => {
        if (!label) return;

        if (previousLabelIndex >= 0 && index - previousLabelIndex < minGap) {
          filteredLabels[previousLabelIndex] = '';
        }

        previousLabelIndex = index;
      });

      return filteredLabels;
    }

    function createLabelRow(className, weeks, getLabelDate, options = {}) {
      const row = document.createElement('div');
      row.className = className;
      row.setAttribute('aria-hidden', 'true');

      const labels = weeks.map((week, weekIndex) => {
        const labelDate = getLabelDate(week, weekIndex);
        return labelDate ? labelDate : '';
      });
      const visibleLabels = options.filterCrowded ? filterCrowdedLabels(labels) : labels;

      visibleLabels.forEach((labelText) => {
        const label = document.createElement('span');
        label.textContent = labelText;
        row.append(label);
      });

      return row;
    }

    function renderCalendar(root, weeks) {
      const years = createLabelRow('github-calendar-years', weeks, (week, weekIndex) => {
        const firstOfYear = week.find((day) => (
          day.date.getUTCMonth() === 0 && day.date.getUTCDate() === 1
        ));
        const labelDate = firstOfYear?.date || (weekIndex === 0 ? week[0]?.date : null);
        return labelDate ? String(labelDate.getUTCFullYear()) : '';
      });

      const months = createLabelRow('github-calendar-months', weeks, (week, weekIndex) => {
        const firstOfMonth = week.find((day) => day.date.getUTCDate() === 1);
        const labelDate = firstOfMonth?.date || (weekIndex === 0 ? week[0]?.date : null);
        return labelDate ? monthFormatter.format(labelDate) : '';
      }, { filterCrowded: true });

      const weekdays = document.createElement('div');
      weekdays.className = 'github-calendar-weekdays';
      weekdays.setAttribute('aria-hidden', 'true');
      WEEKDAYS.forEach((weekday) => {
        const label = document.createElement('span');
        label.textContent = weekday;
        weekdays.append(label);
      });

      const grid = document.createElement('div');
      grid.className = 'github-calendar-grid';
      weeks.forEach((week) => {
        const weekEl = document.createElement('div');
        weekEl.className = 'github-calendar-week';

        week.forEach((day) => {
          const count = Number(day.contribution.count) || 0;
          const level = Math.max(0, Math.min(4, Number(day.contribution.level) || 0));
          const cell = document.createElement('span');
          cell.className = `github-calendar-day github-calendar-day--${level}`;
          cell.title = `${dateFormatter.format(day.date)}: ${count} GitHub contribution${count === 1 ? '' : 's'}`;
          cell.setAttribute('aria-label', cell.title);
          weekEl.append(cell);
        });

        grid.append(weekEl);
      });

      const body = document.createElement('div');
      body.className = 'github-calendar-body';
      body.append(weekdays, grid);

      root.replaceChildren(years, months, body);
    }

    function loadContributionData(username) {
      const { contributionRequests } = githubCalendarState;

      if (!contributionRequests.has(username)) {
        contributionRequests.set(
          username,
          fetch(`${API_ROOT}${encodeURIComponent(username)}?y=last`).then(async (response) => {
            if (!response.ok) throw new Error(`GitHub contribution API returned ${response.status}`);
            const data = await response.json();
            if (!Array.isArray(data.contributions)) throw new Error('Invalid contribution payload');
            return data.contributions;
          })
        );
      }

      return contributionRequests.get(username);
    }

    async function setupGithubCalendar(root) {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const username = root.dataset.username;
      const start = root.dataset.start;
      const end = root.dataset.end;
      const activity = root.closest('[data-github-activity]');
      if (!username || !start || !end || !activity) return;

      try {
        const contributions = await loadContributionData(username);
        const weeks = buildWeeks(start, end, contributions);
        renderCalendar(root, weeks);
        activity.classList.add('is-enhanced');
        activity.classList.remove('is-fallback');
      } catch (error) {
        console.warn('GitHub contribution calendar fallback:', error);
        root.dataset.ready = 'false';
        activity.classList.remove('is-enhanced');
        activity.classList.add('is-fallback');
      }
    }

    function setupGithubCalendars() {
      document
        .querySelectorAll('[data-github-calendar]')
        .forEach((root) => setupGithubCalendar(root));
    }

    window.__shanSetupGithubCalendars = setupGithubCalendars;
    setupGithubCalendars();

    if (!githubCalendarState.isListening) {
      document.addEventListener('astro:page-load', () => {
        window.__shanSetupGithubCalendars?.();
      });
      githubCalendarState.isListening = true;
    }
  })();

  (() => {
    if (window.__shanJourneyTextureWarmupReady) return;
    window.__shanJourneyTextureWarmupReady = true;

    const warmup = window.__shanJourneyTextureWarmup || {
      urls: new Set(),
      images: [],
    };
    window.__shanJourneyTextureWarmup = warmup;

    function canUseHighResTexture() {
      const isMobileLayout = window.matchMedia('(max-width: 719px)').matches;
      const deviceMemory = 'deviceMemory' in navigator ? Number(navigator.deviceMemory) : Infinity;
      const lowMemoryDevice = Number.isFinite(deviceMemory) && deviceMemory <= 4;
      if (isMobileLayout || lowMemoryDevice) return false;

      const canvas = document.createElement('canvas');
      const gl = canvas.getContext('webgl2') || canvas.getContext('webgl');
      return !!gl && gl.getParameter(gl.MAX_TEXTURE_SIZE) >= 8192;
    }

    const usesMobileTexture = window.matchMedia('(max-width: 719px)').matches
      || ('deviceMemory' in navigator && Number(navigator.deviceMemory) <= 4);
    const textureUrls = [
      usesMobileTexture
        ? '/images/earth-natural-muted-2048.jpg'
        : '/images/earth-natural-muted-4096.jpg',
      ...(canUseHighResTexture() ? ['/images/earth-natural-muted-8192.jpg'] : []),
    ];

    function warmImage(url) {
      if (warmup.urls.has(url)) return;
      warmup.urls.add(url);

      const link = document.createElement('link');
      link.rel = 'prefetch';
      link.as = 'image';
      link.href = url;
      link.fetchPriority = 'low';
      document.head.append(link);

      const image = new Image();
      image.decoding = 'async';
      image.src = url;
      warmup.images.push(image);
      if (typeof image.decode === 'function') {
        image.decode().catch(() => {});
      }
    }

    function warmJourneyTextures() {
      textureUrls.forEach(warmImage);
    }

    function maybeWarmFromEvent(event) {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('[data-journey-preload]')) warmJourneyTextures();
    }

    document.addEventListener('pointerover', maybeWarmFromEvent, { passive: true });
    document.addEventListener('touchstart', maybeWarmFromEvent, { passive: true });
    document.addEventListener('focusin', maybeWarmFromEvent);

    const scheduleWarmup = () => warmJourneyTextures();
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(scheduleWarmup, { timeout: 3200 });
    } else {
      window.setTimeout(scheduleWarmup, 1800);
    }
  })();
</script>

<script is:inline>
  (() => {
    if (window.__shanHomepagePetReady) return;
    window.__shanHomepagePetReady = true;

    const rowOffsets = {
      idle: '0%',
      waving: '12.5%',
      failed: '100%',
    };

    function setupHomepagePet(root) {
      if (!(root instanceof HTMLElement) || root.dataset.petReady === 'true') return;
      root.dataset.petReady = 'true';

      const defaultMood = root.dataset.petDefaultMood || 'idle';
      let restoreTimer = 0;
      let clickTimer = 0;
      let dragStartX = 0;
      let dragStartY = 0;
      let dragX = 0;
      let dragY = 0;
      let moved = false;
      let ignoredClick = false;

      function setMood(mood, options = {}) {
        const offset = rowOffsets[mood] || rowOffsets.idle;
        root.dataset.petMood = mood;
        root.style.setProperty('--pet-row-offset', offset);

        window.clearTimeout(restoreTimer);
        if (options.restoreAfter) {
          restoreTimer = window.setTimeout(() => {
            root.classList.remove('is-waving', 'is-failed');
            setMood(defaultMood);
          }, options.restoreAfter);
        }
      }

      function wave() {
        root.classList.remove('is-failed');
        root.classList.add('is-waving');
        setMood('waving', { restoreAfter: 1200 });
      }

      function fail() {
        root.classList.remove('is-waving');
        root.classList.add('is-failed');
        setMood('failed', { restoreAfter: 1600 });
      }

      function updateDrag() {
        root.style.setProperty('--pet-drag-x', `${dragX}px`);
        root.style.setProperty('--pet-drag-y', `${dragY}px`);
      }

      root.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        moved = false;
        dragStartX = event.clientX - dragX;
        dragStartY = event.clientY - dragY;
        root.classList.add('is-dragging');
        root.setPointerCapture?.(event.pointerId);
      });

      root.addEventListener('pointermove', (event) => {
        if (!root.classList.contains('is-dragging')) return;

        const nextX = event.clientX - dragStartX;
        const nextY = event.clientY - dragStartY;
        if (Math.abs(nextX - dragX) > 2 || Math.abs(nextY - dragY) > 2) {
          moved = true;
        }

        dragX = nextX;
        dragY = nextY;
        updateDrag();
      });

      function endDrag(event) {
        if (!root.classList.contains('is-dragging')) return;
        root.classList.remove('is-dragging');
        root.releasePointerCapture?.(event.pointerId);
        ignoredClick = moved;
      }

      root.addEventListener('pointerup', endDrag);
      root.addEventListener('pointercancel', endDrag);

      root.addEventListener('click', () => {
        if (ignoredClick) {
          ignoredClick = false;
          return;
        }

        window.clearTimeout(clickTimer);
        clickTimer = window.setTimeout(wave, 180);
      });

      root.addEventListener('dblclick', () => {
        window.clearTimeout(clickTimer);
        fail();
      });

      root.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          wave();
        }
      });

      setMood(defaultMood);
    }

    function setupHomepagePets() {
      document
        .querySelectorAll('.observatory-companion[data-pet-mood]')
        .forEach(setupHomepagePet);
    }

    setupHomepagePets();
    document.addEventListener('astro:page-load', setupHomepagePets);
  })();
</script>

