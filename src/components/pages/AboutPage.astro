---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import AboutNavigation from '../about/AboutNavigation.astro';
import TrustedInlineHtml from '../TrustedInlineHtml.astro';
import {
  pageHeader,
  intro,
  profile,
  education,
  experience,
  awards,
  skills,
  languages,
} from '../../data/about';
import { defaultLocale, localizeString, localizePath, type Locale, type LocalizedString } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { asTrustedInlineHtml } from '../../utils/html';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const pageSections = [
  { id: 'education', label: t.about.education },
  { id: 'experience', label: t.about.experience },
  { id: 'awards', label: t.about.awards },
  { id: 'skills', label: t.about.skills },
  { id: 'languages', label: t.about.languages },
  { id: 'beyond-code', label: t.about.myWorld },
];

const institutionMonograms: Record<string, string> = {
  'ABK College': 'ABK',
  Hamazushi: 'HAMA',
  'CoCo Ichibanya Curry House': 'CoCo',
};

function getInstitutionMonogram(name: LocalizedString) {
  const englishName = localizeString(name, 'en');
  const mappedMonogram = institutionMonograms[englishName];
  if (mappedMonogram) return mappedMonogram;

  return englishName
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 3)
    .map((word) => word[0])
    .join('')
    .toUpperCase();
}
---

<BaseLayout title={t.about.title} lang={lang}>
  <div class="container">
    <header class="page-header">
      <h1>{localizeString(pageHeader.title, lang)}</h1>
      <p class="subtitle">{localizeString(pageHeader.subtitle, lang)}</p>
    </header>
    
    <div class="about-layout">
      <section class="about-main">
        <!-- Intro -->
        <div class="intro-section">
          {intro.map((paragraph) => (
            <p class="intro-text">
              <TrustedInlineHtml html={asTrustedInlineHtml(localizeString(paragraph, lang))} />
            </p>
          ))}
        </div>
        
        <!-- Education -->
        <div class="section">
          <h2 id="education" tabindex="-1">
            <Icon name="graduation" size={22} />
            {t.about.education}
          </h2>
          
          <div class="timeline-list" data-resume-section="education">
            {education.map((item) => {
              const schoolName = localizeString(item.school, lang);

              return (
                <div class="timeline-item">
                  <div class="timeline-marker"></div>
                  <div class="timeline-content card">
                    <div class="timeline-entry">
                      <span
                        class:list={['institution-mark', { 'institution-mark--fallback': !item.logo }]}
                        aria-hidden="true"
                      >
                        {item.logo ? (
                          <img src={item.logo} alt="" loading="lazy" decoding="async" />
                        ) : (
                          <span>{getInstitutionMonogram(item.school)}</span>
                        )}
                      </span>
                      <div class="timeline-entry-body">
                        <div class="timeline-header">
                          <h3>
                            <a
                              href={item.website}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="timeline-organization-link"
                            >
                              {schoolName}
                            </a>
                          </h3>
                          <span class="timeline-location">{localizeString(item.location, lang)}</span>
                        </div>
                        <p class="timeline-role">{localizeString(item.degree, lang)}</p>
                      </div>
                      {item.description && (
                        <p class="timeline-desc timeline-entry-wide">{localizeString(item.description, lang)}</p>
                      )}
                      <p class="timeline-date timeline-entry-wide">{localizeString(item.period, lang)}</p>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
        
        <!-- Experience -->
        <div class="section">
          <h2 id="experience" tabindex="-1">
            <Icon name="briefcase" size={22} />
            {t.about.experience}
          </h2>
          
          <div class="timeline-list" data-resume-section="experience">
            {experience.map((item) => {
              const companyName = localizeString(item.company, lang);

              return (
                <div class="timeline-item">
                  <div class="timeline-marker"></div>
                  <div class="timeline-content card">
                    <div class="timeline-entry">
                      <span
                        class:list={['institution-mark', { 'institution-mark--fallback': !item.logo }]}
                        aria-hidden="true"
                      >
                        {item.logo ? (
                          <img src={item.logo} alt="" loading="lazy" decoding="async" />
                        ) : (
                          <span>{getInstitutionMonogram(item.company)}</span>
                        )}
                      </span>
                      <div class="timeline-entry-body">
                        <div class="timeline-header">
                          <h3>
                            <a
                              href={item.website}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="timeline-organization-link"
                            >
                              {companyName}
                            </a>
                          </h3>
                        </div>
                        <p class="timeline-role">{localizeString(item.role, lang)}</p>
                      </div>
                      {item.description && (
                        <p class="timeline-desc timeline-entry-wide">{localizeString(item.description, lang)}</p>
                      )}
                      <p class="timeline-date timeline-entry-wide">{localizeString(item.period, lang)}</p>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Awards -->
        <div class="section">
          <h2 id="awards" tabindex="-1">
            <Icon name="award" size={22} />
            {t.about.awards}
          </h2>
          
          <div class="timeline-list">
            {awards.map((item) => (
              <div class="timeline-item">
                <div class="timeline-marker"></div>
                <div class="timeline-content card">
                  <div class="timeline-header">
                    <h3>{localizeString(item.title, lang)}</h3>
                  </div>
                  <p class="timeline-role">{localizeString(item.issuer, lang)}</p>
                  {item.description && <p class="timeline-desc">{localizeString(item.description, lang)}</p>}
                  <p class="timeline-date">{localizeString(item.period, lang)}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Skills -->
        <div class="section">
          <h2 id="skills" tabindex="-1">
            <Icon name="gear" size={22} />
            {t.about.skills}
          </h2>
          
          <div class="skills-grid">
            {skills.map((category) => (
              <div class="skill-category">
                <h3>{localizeString(category.name, lang)}</h3>
                <div class="skill-tags">
                  {category.skills.map((skill) => (
                    <span class="tag">{localizeString(skill, lang)}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Languages -->
        <div class="section">
          <h2 id="languages" tabindex="-1">
            <Icon name="globe" size={22} />
            {t.about.languages}
          </h2>
          
          <div class="languages-list">
            {languages.map((language) => (
              <div class="language-item">
                <span class="language-name">{localizeString(language.name, lang)}</span>
                <span class="language-level">{localizeString(language.level, lang)}</span>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Invitation to the personal constellation -->
        <div class="section world-entry">
          <h2 id="beyond-code" tabindex="-1">
            <Icon name="heart" size={22} />
            {t.about.worldTitle}
          </h2>
          <p id="world-entry-description" class="world-entry-description">{t.about.worldDescription}</p>
          <a
            href={localizePath('/beyond-code', lang)}
            class="world-entry-link"
            aria-describedby="world-entry-description"
            data-world-entry
          >
            <span>{t.about.worldCta}</span>
            <span class="world-entry-arrow" aria-hidden="true"><Icon name="arrowRight" size={17} /></span>
          </a>
        </div>
      </section>
      
      <!-- Sidebar -->
      <aside class="about-sidebar">
        <div class="profile-card gear-border">
          <div class="profile-avatar">
            {profile.avatar ? (
              <img src={profile.avatar} alt={profile.name} class="avatar-image" />
            ) : (
              <div class="avatar-placeholder">{profile.initials}</div>
            )}
          </div>
          <h3 class="profile-name">{profile.name}</h3>
          <p class="profile-title">{localizeString(profile.title, lang)}</p>
          
          <div class="profile-links">
            {profile.links.map((link) => (
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="profile-link">
                <Icon name={link.icon} size={link.icon === 'linkedin' ? 20 : 18} />
                <span>{link.name}</span>
              </a>
            ))}
          </div>
        </div>
        <AboutNavigation title={t.about.onThisPage} toggleLabel={t.about.sections} sections={pageSections} />
      </aside>
    </div>
  </div>
</BaseLayout>




<style>
  @font-face {
    font-family: 'Zhuque Fangsong About Supplement';
    src: url('/fonts/ZhuqueFangsong-About-Supplement.939f0e01716fffb7.woff2') format('woff2');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    unicode-range: U+53CA, U+5411, U+559C, U+5916, U+5C5E, U+5E02, U+6309, U+63A8, U+6545, U+6B22, U+6D89, U+7167, U+7EC4, U+85CF, U+8BC1, U+8F7D, U+96B6, U+97F3;
  }

  :global(html[lang='zh']) .about-layout {
    --font-about-copy: 'Crimson Pro', 'Zhuque Fangsong About', 'Zhuque Fangsong About Supplement', 'Noto Serif SC', 'Songti SC', SimSun;
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  
  .subtitle {
    color: var(--color-text-secondary);
    font-style: italic;
    margin-top: var(--space-sm);
  }

  :global(.main-content:has(.about-layout)) {
    padding-bottom: 0;
  }
  
  .about-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-xl);
    align-items: start;
  }

  .about-sidebar {
    position: sticky;
    top: calc(100px - 0.5rem);
    align-self: start;
    height: fit-content;
    max-height: calc(100dvh - 108px);
    margin: -0.5rem;
    padding: 0.5rem;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-brass-dark) transparent;
  }
  
  .intro-section {
    margin-bottom: var(--space-xl);
    padding: var(--space-lg);
    background:
      linear-gradient(90deg, rgba(201, 162, 39, 0.085), transparent 34%),
      var(--surface-glass);
    border-left: 3px solid var(--color-brass);
    border-radius: var(--surface-radius);
    box-shadow: var(--surface-shadow);
    backdrop-filter: blur(var(--surface-blur));
    -webkit-backdrop-filter: blur(var(--surface-blur));
  }
  
  .intro-text {
    color: var(--color-text-secondary);
    font-family: var(--font-about-copy);
    line-height: 1.9;
    margin-bottom: var(--space-md);
  }
  
  .intro-text:last-child {
    margin-bottom: 0;
  }
  
  .highlight {
    color: var(--color-brass-light);
  }
  
  .section {
    margin-bottom: var(--space-xl);
  }

  .about-main > .section:last-child {
    margin-bottom: 0;
  }
  
  .section h2 {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    scroll-margin-top: 8rem;
  }

  .section h2:focus-visible {
    outline: 2px solid var(--color-brass-light);
    outline-offset: 4px;
  }
  
  /* Timeline */
  .timeline-list {
    position: relative;
    padding-left: var(--space-lg);
  }
  
  .timeline-list::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-border);
  }
  
  .timeline-item {
    position: relative;
    margin-bottom: var(--space-md);
  }
  
  .timeline-marker {
    position: absolute;
    left: calc(-1 * var(--space-lg) + 2px);
    top: var(--space-lg);
    width: 9px;
    height: 9px;
    background: var(--color-brass);
    border-radius: 50%;
  }
  
  .timeline-content {
    padding: var(--space-md);
  }

  .timeline-entry {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: start;
    column-gap: 0.9rem;
  }

  .timeline-entry-body {
    min-width: 0;
  }

  .timeline-entry-wide {
    grid-column: 1 / -1;
  }

  .institution-mark {
    position: relative;
    display: grid;
    place-items: center;
    align-self: center;
    width: 48px;
    height: 48px;
    padding: 3px;
    overflow: hidden;
    border: 1px solid rgba(201, 162, 39, 0.26);
    border-radius: 9px;
    background: rgba(247, 245, 239, 0.94);
    box-shadow:
      inset 0 0 0 1px rgba(10, 10, 15, 0.08),
      0 7px 18px rgba(0, 0, 0, 0.2);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .institution-mark img {
    position: absolute;
    inset: 4px;
    display: block;
    width: calc(100% - 8px);
    height: calc(100% - 8px);
    object-fit: contain;
  }

  .institution-mark img[src$='logo-coco-ichibanya.png'] {
    transform: translateX(1px);
  }

  .institution-mark img[src$='logo-abk.png'] {
    transform: scale(1.08);
  }

  .institution-mark--fallback {
    padding: 0;
    color: var(--color-brass-light);
    background:
      radial-gradient(circle at 50% 35%, rgba(201, 162, 39, 0.16), transparent 58%),
      rgba(15, 15, 23, 0.96);
  }

  .institution-mark--fallback::before,
  .institution-mark--fallback::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .institution-mark--fallback::before {
    inset: 5px;
    border: 1px solid rgba(201, 162, 39, 0.18);
    border-radius: 5px;
  }

  .institution-mark--fallback::after {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-brass);
    box-shadow: 0 0 8px rgba(201, 162, 39, 0.7);
    transform: translateY(14px);
  }

  .institution-mark--fallback span {
    position: relative;
    z-index: 1;
    max-width: 100%;
    font-family: var(--font-about-date);
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .timeline-content:hover .institution-mark {
    border-color: rgba(212, 168, 75, 0.5);
    box-shadow:
      inset 0 0 0 1px rgba(10, 10, 15, 0.08),
      0 9px 22px rgba(0, 0, 0, 0.24),
      0 0 14px rgba(201, 162, 39, 0.09);
    transform: translateY(-1px);
  }
  
  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
  }
  
  .timeline-header h3 {
    font-size: 1.1rem;
    color: var(--color-text-primary);
  }

  .timeline-organization-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .timeline-organization-link:hover,
  .timeline-organization-link:focus-visible {
    color: var(--color-brass-light);
    text-shadow: 0 0 12px rgba(212, 168, 75, 0.18);
  }

  .timeline-organization-link:focus-visible {
    border-radius: 2px;
    outline: 1px solid var(--color-brass-light);
    outline-offset: 4px;
  }
  
  .timeline-location {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-family: var(--font-about-copy);
  }
  
  .timeline-role {
    color: var(--color-brass-light);
    font-size: 1rem;
  }
  
  .timeline-desc {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    font-family: var(--font-about-copy);
    margin-top: var(--space-xs);
  }
  
  .timeline-date {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-family: var(--font-about-date);
    margin-top: var(--space-xs);
  }
  
  /* Skills */
  .skills-grid {
    display: grid;
    gap: var(--space-lg);
  }
  
  .skill-category h3 {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }
  
  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  
  /* Languages */
  .languages-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
  
  .language-item {
    display: flex;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-md);
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 4px;
  }
  
  .language-name {
    color: var(--color-text-primary);
  }
  
  .language-level {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    font-family: var(--font-about-copy);
  }
  
  /* A quiet invitation into the personal constellation. */
  .world-entry-description {
    max-width: 34rem;
    color: var(--color-text-secondary);
    font-family: var(--font-about-copy);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .world-entry-link {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    min-height: 50px;
    margin-top: 0.8rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid rgba(201, 162, 39, 0.48);
    color: var(--color-text-primary);
    font-family: var(--font-about-copy);
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .world-entry-arrow {
    display: inline-flex;
    align-items: center;
    opacity: 0.8;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .world-entry-link:hover {
    border-color: var(--color-brass-light);
    color: #ead5a1;
  }

  .world-entry-link:hover .world-entry-arrow,
  .world-entry-link:focus-visible .world-entry-arrow {
    opacity: 1;
    transform: translateX(3px);
  }

  .world-entry-link:focus-visible {
    outline: 2px solid var(--color-brass-light);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .world-entry-link, .world-entry-arrow { transition: none; }
    .world-entry-link:hover .world-entry-arrow,
    .world-entry-link:focus-visible .world-entry-arrow { transform: none; }
  }

  /* Sidebar */
  .profile-card {
    padding: var(--space-lg);
    text-align: center;
  }
  
  .profile-avatar {
    margin-bottom: var(--space-md);
  }
  
  .avatar-placeholder {
    width: 80px;
    height: 80px;
    margin: 0 auto;
    background: var(--color-bg-secondary);
    border: 2px solid var(--color-brass);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-brass);
  }
  
  .avatar-image {
    width: 80px;
    height: 80px;
    margin: 0 auto;
    border: 2px solid var(--color-brass);
    border-radius: 50%;
    object-fit: cover;
  }
  
  .profile-name {
    font-size: 1.2rem;
    margin-bottom: var(--space-xs);
  }
  
  .profile-title {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin-bottom: var(--space-lg);
  }
  
  .profile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  
  .profile-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.03);
    font-size: 0.95rem;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: all 0.3s ease;
  }
  
  .profile-link:hover {
    border-color: var(--color-brass);
    color: var(--color-brass);
    background: rgba(201, 162, 39, 0.08);
  }
  
  .profile-link svg {
    flex-shrink: 0;
    color: var(--color-brass-light);
  }
  
  /* Responsive */
  @media (max-width: 900px) {
    .about-layout {
      grid-template-columns: 1fr;
    }
    
    .about-sidebar {
      order: -1;
      position: static;
      height: auto;
      max-height: none;
      margin: 0;
      padding: 0;
      overflow: visible;
    }

    .section h2 {
      scroll-margin-top: 9rem;
    }
    
    .languages-list {
      grid-template-columns: 1fr;
    }
    
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html:has(.about-layout)) {
      scroll-behavior: auto;
    }
  }


  @media (max-width: 768px) {
    .page-header {
      margin-bottom: 1.35rem;
    }

    .profile-card {
      max-width: 21rem;
      margin: 0 auto;
      padding: 1.05rem 0.95rem;
    }

    .profile-avatar {
      margin-bottom: 0.7rem;
    }

    .avatar-placeholder,
    .avatar-image {
      width: 64px;
      height: 64px;
    }

    .avatar-placeholder {
      font-size: 1.2rem;
    }

    .profile-name {
      font-size: 1.05rem;
      margin-bottom: 0.15rem;
    }

    .profile-title {
      font-size: 0.84rem;
      margin-bottom: 0.9rem;
    }

    .profile-links {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.42rem;
    }

    .profile-link {
      flex-direction: column;
      justify-content: center;
      gap: 0.2rem;
      min-height: 2.65rem;
      padding: 0.38rem 0.25rem;
      font-size: 0.74rem;
      line-height: 1.1 !important;
    }

    .profile-link svg {
      width: 16px;
      height: 16px;
    }

