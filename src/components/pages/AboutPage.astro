---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import { pageHeader, intro, profile, education, experience, awards, skills, languages, interests } from '../../data/about';
import { defaultLocale, localizeString, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout title={t.about.title} lang={lang}>
  <div class="container">
    <header class="page-header">
      <h1>{localizeString(pageHeader.title, lang)}</h1>
      <p class="subtitle">{localizeString(pageHeader.subtitle, lang)}</p>
    </header>
    
    <div class="about-layout">
      <section class="about-main">
        <!-- Intro -->
        <div class="intro-section">
          {intro.map((paragraph) => (
            <p class="intro-text" set:html={localizeString(paragraph, lang)}></p>
          ))}
        </div>
        
        <!-- Education -->
        <div class="section">
          <h2>
            <Icon name="graduation" size={22} />
            {t.about.education}
          </h2>
          
          <div class="timeline-list">
            {education.map((item) => (
              <div class="timeline-item">
                <div class="timeline-marker"></div>
                <div class="timeline-content card">
                  <div class="timeline-header">
                    <h3>{localizeString(item.school, lang)}</h3>
                    <span class="timeline-location">{localizeString(item.location, lang)}</span>
                  </div>
                  <p class="timeline-role">{localizeString(item.degree, lang)}</p>
                  {item.description && <p class="timeline-desc">{localizeString(item.description, lang)}</p>}
                  <p class="timeline-date">{localizeString(item.period, lang)}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Experience -->
        <div class="section">
          <h2>
            <Icon name="briefcase" size={22} />
            {t.about.experience}
          </h2>
          
          <div class="timeline-list">
            {experience.map((item) => (
              <div class="timeline-item">
                <div class="timeline-marker"></div>
                <div class="timeline-content card">
                  <div class="timeline-header">
                    <h3>{localizeString(item.company, lang)}</h3>
                  </div>
                  <p class="timeline-role">{localizeString(item.role, lang)}</p>
                  {item.description && <p class="timeline-desc">{localizeString(item.description, lang)}</p>}
                  <p class="timeline-date">{localizeString(item.period, lang)}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Awards -->
        <div class="section">
          <h2>
            <Icon name="award" size={22} />
            {t.about.awards}
          </h2>
          
          <div class="timeline-list">
            {awards.map((item) => (
              <div class="timeline-item">
                <div class="timeline-marker"></div>
                <div class="timeline-content card">
                  <div class="timeline-header">
                    <h3>{localizeString(item.title, lang)}</h3>
                  </div>
                  <p class="timeline-role">{localizeString(item.issuer, lang)}</p>
                  {item.description && <p class="timeline-desc">{localizeString(item.description, lang)}</p>}
                  <p class="timeline-date">{localizeString(item.period, lang)}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Skills -->
        <div class="section">
          <h2>
            <Icon name="gear" size={22} />
            {t.about.skills}
          </h2>
          
          <div class="skills-grid">
            {skills.map((category) => (
              <div class="skill-category">
                <h3>{localizeString(category.name, lang)}</h3>
                <div class="skill-tags">
                  {category.skills.map((skill) => (
                    <span class="tag">{localizeString(skill, lang)}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Languages -->
        <div class="section">
          <h2>
            <Icon name="globe" size={22} />
            {t.about.languages}
          </h2>
          
          <div class="languages-list">
            {languages.map((language) => (
              <div class="language-item">
                <span class="language-name">{localizeString(language.name, lang)}</span>
                <span class="language-level">{localizeString(language.level, lang)}</span>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Interests / Beyond Code -->
        <div class="section">
          <h2>
            <Icon name="heart" size={22} />
            {t.about.beyondCode}
          </h2>
          
          <div class="interests-grid">
            {interests.map((category) => (
              <div class="interest-category">
                <h3>
                  <Icon name={category.icon} size={18} />
                  {localizeString(category.name, lang)}
                </h3>
                <div class="interest-items">
                  {category.items.map((item) => (
                    <span class="interest-tag">{localizeString(item, lang)}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
      
      <!-- Sidebar -->
      <aside class="about-sidebar">
        <div class="profile-card gear-border">
          <div class="profile-avatar">
            {profile.avatar ? (
              <img src={profile.avatar} alt={profile.name} class="avatar-image" />
            ) : (
              <div class="avatar-placeholder">{profile.initials}</div>
            )}
          </div>
          <h3 class="profile-name">{profile.name}</h3>
          <p class="profile-title">{localizeString(profile.title, lang)}</p>
          
          <div class="profile-links">
            {profile.links.map((link) => (
              <a href={link.url} target="_blank" class="profile-link">
                <Icon name={link.icon} size={18} />
                <span>{link.name}</span>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  
  .subtitle {
    color: var(--color-text-secondary);
    font-style: italic;
    margin-top: var(--space-sm);
  }
  
  .about-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-xl);
    align-items: start;
  }
  
  .intro-section {
    margin-bottom: var(--space-xl);
    padding: var(--space-lg);
    background: var(--color-bg-card);
    border-left: 3px solid var(--color-brass);
  }
  
  .intro-text {
    color: var(--color-text-secondary);
    line-height: 1.9;
    margin-bottom: var(--space-md);
  }
  
  .intro-text:last-child {
    margin-bottom: 0;
  }
  
  .highlight {
    color: var(--color-brass-light);
  }
  
  .section {
    margin-bottom: var(--space-xl);
  }
  
  .section h2 {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  
  /* Timeline */
  .timeline-list {
    position: relative;
    padding-left: var(--space-lg);
  }
  
  .timeline-list::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-border);
  }
  
  .timeline-item {
    position: relative;
    margin-bottom: var(--space-md);
  }
  
  .timeline-marker {
    position: absolute;
    left: calc(-1 * var(--space-lg) + 2px);
    top: var(--space-lg);
    width: 9px;
    height: 9px;
    background: var(--color-brass);
    border-radius: 50%;
  }
  
  .timeline-content {
    padding: var(--space-md);
  }
  
  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
  }
  
  .timeline-header h3 {
    font-size: 1.1rem;
    color: var(--color-text-primary);
  }
  
  .timeline-location {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  
  .timeline-role {
    color: var(--color-brass-light);
    font-size: 1rem;
  }
  
  .timeline-desc {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin-top: var(--space-xs);
  }
  
  .timeline-date {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-family: var(--font-mono);
    margin-top: var(--space-xs);
  }
  
  /* Skills */
  .skills-grid {
    display: grid;
    gap: var(--space-lg);
  }
  
  .skill-category h3 {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }
  
  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  
  /* Languages */
  .languages-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
  
  .language-item {
    display: flex;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
  }
  
  .language-name {
    color: var(--color-text-primary);
  }
  
  .language-level {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  
  /* Interests / Beyond Code */
  .interests-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }
  
  .interest-category h3 {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }
  
  .interest-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  
  .interest-tag {
    padding: 4px 10px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    transition: all 0.2s ease;
  }
  
  .interest-tag:hover {
    border-color: var(--color-brass);
    color: var(--color-brass-light);
  }
  
  /* Sidebar */
  .profile-card {
    padding: var(--space-lg);
    text-align: center;
    position: sticky;
    top: 100px;
  }
  
  .profile-avatar {
    margin-bottom: var(--space-md);
  }
  
  .avatar-placeholder {
    width: 80px;
    height: 80px;
    margin: 0 auto;
    background: var(--color-bg-secondary);
    border: 2px solid var(--color-brass);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-brass);
  }
  
  .avatar-image {
    width: 80px;
    height: 80px;
    margin: 0 auto;
    border: 2px solid var(--color-brass);
    border-radius: 50%;
    object-fit: cover;
  }
  
  .profile-name {
    font-size: 1.2rem;
    margin-bottom: var(--space-xs);
  }
  
  .profile-title {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin-bottom: var(--space-lg);
  }
  
  .profile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  
  .profile-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-size: 0.95rem;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: all 0.3s ease;
  }
  
  .profile-link:hover {
    border-color: var(--color-brass);
    color: var(--color-brass);
    background: rgba(201, 162, 39, 0.08);
  }
  
  .profile-link svg {
    flex-shrink: 0;
    color: var(--color-brass-light);
  }
  
  /* Responsive */
  @media (max-width: 900px) {
    .about-layout {
      grid-template-columns: 1fr;
    }
    
    .about-sidebar {
      order: -1;
    }
    
    .profile-card {
      position: static;
    }
    
    .languages-list {
      grid-template-columns: 1fr;
    }
    
    .interests-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
