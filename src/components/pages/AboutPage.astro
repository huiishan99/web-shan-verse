---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import TrustedInlineHtml from '../TrustedInlineHtml.astro';
import {
  pageHeader,
  intro,
  profile,
  education,
  experience,
  awards,
  skills,
  languages,
  interests,
  type InterestItem,
} from '../../data/about';
import { defaultLocale, localizeString, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { asTrustedInlineHtml } from '../../utils/html';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

const wikipediaPreviewCopy = {
  en: {
    prompt: 'Hover to load a cover preview.',
    loading: 'Loading Wikipedia preview...',
    details: 'Open Wikipedia for more details.',
    unavailable: 'Preview unavailable. Open Wikipedia for details.',
  },
  zh: {
    prompt: '悬停以加载封面预览。',
    loading: '正在加载维基百科预览…',
    details: '在维基百科查看更多信息。',
    unavailable: '暂时无法加载预览，请打开维基百科查看详情。',
  },
  ja: {
    prompt: 'ホバーするとカバープレビューを読み込みます。',
    loading: 'Wikipediaのプレビューを読み込んでいます…',
    details: 'Wikipediaで詳細を見る。',
    unavailable: 'プレビューを読み込めません。Wikipediaで詳細をご覧ください。',
  },
}[lang];

type RichInterestItem = Extract<InterestItem, { title: unknown }>;

function hasInterestTitle(item: InterestItem): item is RichInterestItem {
  return typeof item === 'object' && item !== null && 'title' in item;
}

function isWikiInterestItem(item: InterestItem): item is RichInterestItem & { wikiPage: string } {
  return typeof item === 'object' && item !== null && 'wikiPage' in item && typeof item.wikiPage === 'string';
}

function isAudioInterestItem(item: InterestItem): item is RichInterestItem & ({ audioSrc: string } | { previewProvider: 'itunes' }) {
  return (
    typeof item === 'object' &&
    item !== null &&
    (
      ('audioSrc' in item && typeof item.audioSrc === 'string') ||
      ('previewProvider' in item && item.previewProvider === 'itunes')
    )
  );
}

function getInterestTitle(item: InterestItem) {
  return hasInterestTitle(item) ? localizeString(item.title, lang) : localizeString(item, lang);
}

function getWikipediaTarget(page: string) {
  return {
    language: 'en' as const,
    page,
  };
}

function getWikipediaUrl(page: string, language: Locale) {
  return `https://${language}.wikipedia.org/wiki/${encodeURIComponent(page).replace(/%20/g, '_')}`;
}

function getWikipediaAriaLabel(title: string) {
  if (lang === 'zh') return `在维基百科查看${title}`;
  if (lang === 'ja') return `Wikipediaで${title}を見る`;
  return `${title} on Wikipedia`;
}

function getItunesSearchUrl(term: string, country = 'JP') {
  const params = new URLSearchParams({
    term,
    country,
    media: 'music',
    entity: 'song',
    limit: '1',
  });

  return `https://itunes.apple.com/search?${params.toString()}`;
}
---

<BaseLayout title={t.about.title} lang={lang}>
  <div class="container">
    <header class="page-header">
      <h1>{localizeString(pageHeader.title, lang)}</h1>
      <p class="subtitle">{localizeString(pageHeader.subtitle, lang)}</p>
    </header>
    
    <div class="about-layout">
      <section class="about-main">
        <!-- Intro -->
        <div class="intro-section">
          {intro.map((paragraph) => (
            <p class="intro-text">
              <TrustedInlineHtml html={asTrustedInlineHtml(localizeString(paragraph, lang))} />
            </p>
          ))}
        </div>
        
        <!-- Education -->
        <div class="section">
          <h2>
            <Icon name="graduation" size={22} />
            {t.about.education}
          </h2>
          
          <div class="timeline-list">
            {education.map((item) => (
              <div class="timeline-item">
                <div class="timeline-marker"></div>
                <div class="timeline-content card">
                  <div class="timeline-header">
                    <h3>{localizeString(item.school, lang)}</h3>
                    <span class="timeline-location">{localizeString(item.location, lang)}</span>
                  </div>
                  <p class="timeline-role">{localizeString(item.degree, lang)}</p>
                  {item.description && <p class="timeline-desc">{localizeString(item.description, lang)}</p>}
                  <p class="timeline-date">{localizeString(item.period, lang)}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Experience -->
        <div class="section">
          <h2>
            <Icon name="briefcase" size={22} />
            {t.about.experience}
          </h2>
          
          <div class="timeline-list">
            {experience.map((item) => (
              <div class="timeline-item">
                <div class="timeline-marker"></div>
                <div class="timeline-content card">
                  <div class="timeline-header">
                    <h3>{localizeString(item.company, lang)}</h3>
                  </div>
                  <p class="timeline-role">{localizeString(item.role, lang)}</p>
                  {item.description && <p class="timeline-desc">{localizeString(item.description, lang)}</p>}
                  <p class="timeline-date">{localizeString(item.period, lang)}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Awards -->
        <div class="section">
          <h2>
            <Icon name="award" size={22} />
            {t.about.awards}
          </h2>
          
          <div class="timeline-list">
            {awards.map((item) => (
              <div class="timeline-item">
                <div class="timeline-marker"></div>
                <div class="timeline-content card">
                  <div class="timeline-header">
                    <h3>{localizeString(item.title, lang)}</h3>
                  </div>
                  <p class="timeline-role">{localizeString(item.issuer, lang)}</p>
                  {item.description && <p class="timeline-desc">{localizeString(item.description, lang)}</p>}
                  <p class="timeline-date">{localizeString(item.period, lang)}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Skills -->
        <div class="section">
          <h2>
            <Icon name="gear" size={22} />
            {t.about.skills}
          </h2>
          
          <div class="skills-grid">
            {skills.map((category) => (
              <div class="skill-category">
                <h3>{localizeString(category.name, lang)}</h3>
                <div class="skill-tags">
                  {category.skills.map((skill) => (
                    <span class="tag">{localizeString(skill, lang)}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Languages -->
        <div class="section">
          <h2>
            <Icon name="globe" size={22} />
            {t.about.languages}
          </h2>
          
          <div class="languages-list">
            {languages.map((language) => (
              <div class="language-item">
                <span class="language-name">{localizeString(language.name, lang)}</span>
                <span class="language-level">{localizeString(language.level, lang)}</span>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Interests / Beyond Code -->
        <div class="section">
          <h2>
            <Icon name="heart" size={22} />
            {t.about.beyondCode}
          </h2>
          
          <div class="interests-grid">
            {interests.map((category) => (
              <div class="interest-category">
                <h3>
                  <Icon name={category.icon} size={18} />
                  {localizeString(category.name, lang)}
                </h3>
                <div class="interest-items">
                  {category.items.map((item) => {
                    const title = getInterestTitle(item);
                    const artist = hasInterestTitle(item) && item.artist ? localizeString(item.artist, lang) : '';
                    const itunesTerm = hasInterestTitle(item) && item.itunesTerm
                      ? localizeString(item.itunesTerm, lang)
                      : [title, artist].filter(Boolean).join(' ');
                    const itunesCountry = hasInterestTitle(item) ? item.itunesCountry ?? 'JP' : 'JP';
                    const wikipediaTarget = isWikiInterestItem(item) ? getWikipediaTarget(item.wikiPage) : undefined;

                    return isAudioInterestItem(item) ? (
                      <a
                        href={getItunesSearchUrl(itunesTerm, itunesCountry)}
                        target="_blank"
                        rel="noopener noreferrer"
                        role="button"
                        class="interest-tag interest-tag--work interest-tag--audio"
                        data-interest-audio
                        data-audio-src={item.audioSrc}
                        data-audio-title={title}
                        data-audio-artist={artist}
                        data-itunes-preview={item.previewProvider === 'itunes' ? true : undefined}
                        data-itunes-term={itunesTerm}
                        data-itunes-country={itunesCountry}
                        data-wiki-page={wikipediaTarget?.page}
                        data-wiki-language={wikipediaTarget?.language}
                        aria-label={`Play ${title}`}
                        aria-pressed="false"
                      >
                        <span>{title}</span>
                        <span class="interest-preview interest-preview--album" aria-hidden="true">
                          <span class="interest-preview-media interest-preview-media--album" data-wiki-media>
                            {item.previewProvider === 'itunes' ? (
                              <span class="interest-preview-placeholder">♪</span>
                            ) : (
                              <span class="interest-preview-placeholder">A</span>
                            )}
                          </span>
                          <span class="interest-preview-body">
                            <span class="interest-preview-kicker" data-preview-kicker>{item.previewProvider === 'itunes' ? 'iTunes Preview' : 'Album'}</span>
                            <strong data-wiki-title>{artist ? `${title} — ${artist}` : title}</strong>
                            <span data-wiki-extract>Hover to load an album preview.</span>
                          </span>
                        </span>
                      </a>
                    ) : wikipediaTarget ? (
                      <a
                        class="interest-tag interest-tag--work"
                        href={getWikipediaUrl(wikipediaTarget.page, wikipediaTarget.language)}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-wiki-preview
                        data-wiki-page={wikipediaTarget.page}
                        data-wiki-language={wikipediaTarget.language}
                        data-wiki-loading={wikipediaPreviewCopy.loading}
                        data-wiki-details={wikipediaPreviewCopy.details}
                        data-wiki-unavailable={wikipediaPreviewCopy.unavailable}
                        aria-label={getWikipediaAriaLabel(title)}
                      >
                        <span>{title}</span>
                        <span class="interest-preview" aria-hidden="true">
                          <span class="interest-preview-media" data-wiki-media>
                            <span class="interest-preview-placeholder">W</span>
                          </span>
                          <span class="interest-preview-body">
                            <span class="interest-preview-kicker">Wikipedia</span>
                            <strong data-wiki-title>{title}</strong>
                            <span data-wiki-extract>{wikipediaPreviewCopy.prompt}</span>
                          </span>
                        </span>
                      </a>
                    ) : (
                      <span class="interest-tag">{title}</span>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
          <audio class="interest-audio-player" preload="metadata" data-interest-audio-player></audio>
        </div>
      </section>
      
      <!-- Sidebar -->
      <aside class="about-sidebar">
        <div class="profile-card gear-border">
          <div class="profile-avatar">
            {profile.avatar ? (
              <img src={profile.avatar} alt={profile.name} class="avatar-image" />
            ) : (
              <div class="avatar-placeholder">{profile.initials}</div>
            )}
          </div>
          <h3 class="profile-name">{profile.name}</h3>
          <p class="profile-title">{localizeString(profile.title, lang)}</p>
          
          <div class="profile-links">
            {profile.links.map((link) => (
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="profile-link">
                <Icon name={link.icon} size={link.icon === 'linkedin' ? 20 : 18} />
                <span>{link.name}</span>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/client/about-previews.js';
  import '../../scripts/client/about-audio.js';
</script>



<style>
  .page-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  
  .subtitle {
    color: var(--color-text-secondary);
    font-style: italic;
    margin-top: var(--space-sm);
  }

  :global(.main-content:has(.about-layout)) {
    padding-bottom: 0;
  }
  
  .about-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-xl);
    align-items: start;
  }

  .about-sidebar {
    position: sticky;
    top: 100px;
    align-self: start;
    height: fit-content;
  }
  
  .intro-section {
    margin-bottom: var(--space-xl);
    padding: var(--space-lg);
    background:
      linear-gradient(90deg, rgba(201, 162, 39, 0.085), transparent 34%),
      var(--surface-glass);
    border-left: 3px solid var(--color-brass);
    border-radius: var(--surface-radius);
    box-shadow: var(--surface-shadow);
    backdrop-filter: blur(var(--surface-blur));
    -webkit-backdrop-filter: blur(var(--surface-blur));
  }
  
  .intro-text {
    color: var(--color-text-secondary);
    line-height: 1.9;
    margin-bottom: var(--space-md);
  }
  
  .intro-text:last-child {
    margin-bottom: 0;
  }
  
  .highlight {
    color: var(--color-brass-light);
  }
  
  .section {
    margin-bottom: var(--space-xl);
  }

  .about-main > .section:last-child {
    margin-bottom: 0;
  }
  
  .section h2 {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  
  /* Timeline */
  .timeline-list {
    position: relative;
    padding-left: var(--space-lg);
  }
  
  .timeline-list::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-border);
  }
  
  .timeline-item {
    position: relative;
    margin-bottom: var(--space-md);
  }
  
  .timeline-marker {
    position: absolute;
    left: calc(-1 * var(--space-lg) + 2px);
    top: var(--space-lg);
    width: 9px;
    height: 9px;
    background: var(--color-brass);
    border-radius: 50%;
  }
  
  .timeline-content {
    padding: var(--space-md);
  }
  
  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
  }
  
  .timeline-header h3 {
    font-size: 1.1rem;
    color: var(--color-text-primary);
  }
  
  .timeline-location {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  
  .timeline-role {
    color: var(--color-brass-light);
    font-size: 1rem;
  }
  
  .timeline-desc {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    font-family: var(--font-about-copy);
    margin-top: var(--space-xs);
  }
  
  .timeline-date {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-family: var(--font-mono);
    margin-top: var(--space-xs);
  }
  
  /* Skills */
  .skills-grid {
    display: grid;
    gap: var(--space-lg);
  }
  
  .skill-category h3 {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }
  
  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  
  /* Languages */
  .languages-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
  
  .language-item {
    display: flex;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-md);
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 4px;
  }
  
  .language-name {
    color: var(--color-text-primary);
  }
  
  .language-level {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  
  /* Interests / Beyond Code */
  .interests-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }
  
  .interest-category h3 {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }
  
  .interest-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  
  .interest-tag {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 4px;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    transition: all 0.2s ease;
  }

  a.interest-tag {
    text-decoration: none;
  }

  button.interest-tag {
    appearance: none;
    -webkit-appearance: none;
    font-family: inherit;
    font-size: 0.9rem;
    line-height: inherit;
    cursor: pointer;
  }
  
  .interest-tag:hover,
  .interest-tag:focus-visible {
    border-color: var(--color-brass);
    color: var(--color-brass-light);
  }

  .interest-tag--work {
    cursor: pointer;
  }

  .interest-tag--audio.is-playing {
    border-color: var(--color-brass);
    color: var(--color-brass-light);
    background: rgba(201, 162, 39, 0.08);
  }

  .interest-tag--audio.is-loading {
    border-color: rgba(201, 162, 39, 0.45);
    color: var(--color-brass-light);
  }

  .interest-tag--audio.has-error {
    border-color: rgba(208, 139, 115, 0.58);
    color: #d08b73;
  }

  .interest-audio-player {
    display: none;
  }

  .interest-preview {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.65rem);
    z-index: 40;
    display: grid;
    grid-template-columns: 4.2rem minmax(0, 1fr);
    gap: 0.65rem;
    width: min(16rem, calc(100vw - 2rem));
    min-height: 5.65rem;
    padding: 0.6rem;
    border: 1px solid rgba(201, 162, 39, 0.26);
    border-radius: 6px;
    background:
      linear-gradient(180deg, rgba(201, 162, 39, 0.09), rgba(255, 255, 255, 0.025)),
      rgba(10, 10, 15, 0.94);
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.38), 0 0 18px rgba(201, 162, 39, 0.08);
    color: var(--color-text-secondary);
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.35rem) scale(0.98);
    transform-origin: 1.25rem 100%;
    transition:
      opacity 0.16s ease,
      transform 0.16s ease;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .interest-preview::after {
    content: '';
    position: absolute;
    left: 1.1rem;
    bottom: -0.38rem;
    width: 0.7rem;
    height: 0.7rem;
    border-right: 1px solid rgba(201, 162, 39, 0.22);
    border-bottom: 1px solid rgba(201, 162, 39, 0.22);
    background: rgba(10, 10, 15, 0.94);
    transform: rotate(45deg);
  }

  .interest-tag--work:hover .interest-preview,
  .interest-tag--work:focus-visible .interest-preview,
  .interest-tag--work:focus-within .interest-preview {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .interest-preview-media {
    display: grid;
    place-items: center;
    width: 4.2rem;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 4px;
    background:
      radial-gradient(circle at 50% 42%, rgba(201, 162, 39, 0.08), transparent 62%),
      rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .interest-preview-media--album {
    aspect-ratio: 1;
  }

  :global(.interest-preview-media img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .interest-preview-placeholder {
    color: rgba(201, 162, 39, 0.62);
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .interest-preview-body {
    display: grid;
    align-content: center;
    gap: 0.22rem;
    min-width: 0;
  }

  .interest-preview-kicker {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .interest-preview-body strong {
    color: var(--color-text-primary);
    font-size: 0.88rem;
    line-height: 1.25;
  }

  .interest-preview-body span:last-child {
    color: var(--color-text-muted);
    font-size: 0.72rem;
    line-height: 1.35;
  }
  
  /* Sidebar */
  .profile-card {
    padding: var(--space-lg);
    text-align: center;
  }
  
  .profile-avatar {
    margin-bottom: var(--space-md);
  }
  
  .avatar-placeholder {
    width: 80px;
    height: 80px;
    margin: 0 auto;
    background: var(--color-bg-secondary);
    border: 2px solid var(--color-brass);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-brass);
  }
  
  .avatar-image {
    width: 80px;
    height: 80px;
    margin: 0 auto;
    border: 2px solid var(--color-brass);
    border-radius: 50%;
    object-fit: cover;
  }
  
  .profile-name {
    font-size: 1.2rem;
    margin-bottom: var(--space-xs);
  }
  
  .profile-title {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin-bottom: var(--space-lg);
  }
  
  .profile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  
  .profile-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.03);
    font-size: 0.95rem;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: all 0.3s ease;
  }
  
  .profile-link:hover {
    border-color: var(--color-brass);
    color: var(--color-brass);
    background: rgba(201, 162, 39, 0.08);
  }
  
  .profile-link svg {
    flex-shrink: 0;
    color: var(--color-brass-light);
  }
  
  /* Responsive */
  @media (max-width: 900px) {
    .about-layout {
      grid-template-columns: 1fr;
