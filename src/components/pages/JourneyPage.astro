---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultLocale, localizePath, localizeString, type Locale } from '../../i18n/config';
import { travelPoints } from '../../data/travel';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;

const journeyCopy: Record<Locale, {
  title: string;
  back: string;
  route: string;
}> = {
  en: {
    title: 'Travel Atlas',
    back: 'Back Home',
    route: 'Route Log',
  },
  zh: {
    title: '旅行星图',
    back: '返回首页',
    route: '轨迹记录',
  },
  ja: {
    title: '旅の星図',
    back: 'ホームへ',
    route: 'ルートログ',
  },
};

const copy = journeyCopy[lang];
const scenePoints = travelPoints.map((point) => ({
  id: point.id,
  name: localizeString(point.name, lang),
  note: localizeString(point.note, lang),
  lat: point.lat,
  lon: point.lon,
  year: point.year,
  kind: point.kind,
}));
---

<BaseLayout title={copy.title} lang={lang}>
  <section
    class="journey-shell"
    data-earth-scene
    data-points={JSON.stringify(scenePoints)}
    aria-label={copy.title}
  >
    <canvas class="earth-canvas" data-earth-canvas aria-label={copy.title}></canvas>
    <div class="journey-vignette" aria-hidden="true"></div>

    <div class="journey-copy">
      <a class="journey-back" href={localizePath('/', lang)}>
        <span aria-hidden="true">←</span>
        {copy.back}
      </a>
    </div>

    <aside class="journey-route" aria-label={copy.route}>
      <p>{copy.route}</p>
      <ol>
        {scenePoints.map((point) => (
          <li data-kind={point.kind}>
            <span>{point.year}</span>
            <strong>{point.name}</strong>
            <em>{point.note}</em>
          </li>
        ))}
      </ol>
    </aside>
  </section>
</BaseLayout>

<script>
  import * as THREE from 'three';

  const atlasWindow = window as typeof window & { __shanJourneyEarthReady?: boolean };

  function initJourneyEarthScenes() {
    document.querySelectorAll('[data-earth-scene]').forEach((root) => {
      if (!(root instanceof HTMLElement)) return;
      if (root.dataset.earthReady === 'true') return;

      const canvas = root.querySelector('[data-earth-canvas]');
      if (!(canvas instanceof HTMLCanvasElement)) return;

      root.dataset.earthReady = 'true';
      const points = JSON.parse(root.dataset.points || '[]');

      const renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        preserveDrawingBuffer: true,
      });
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);

      const ambient = new THREE.AmbientLight(0xb6c7e8, 0.82);
      const keyLight = new THREE.DirectionalLight(0xffdf9b, 1.75);
      keyLight.position.set(-3.2, 4.1, 5.2);
      const rimLight = new THREE.DirectionalLight(0x9bbcff, 1.75);
      rimLight.position.set(4.2, -1.4, 3.2);
      scene.add(ambient, keyLight, rimLight);

      const globe = new THREE.Group();
      scene.add(globe);

      function seededNoise(x, y) {
        return Math.sin(x * 12.9898 + y * 78.233) * 43758.5453 % 1;
      }

      function createCloudTexture() {
        const width = 1024;
        const height = 512;
        const cloudCanvas = document.createElement('canvas');
        cloudCanvas.width = width;
        cloudCanvas.height = height;
        const context = cloudCanvas.getContext('2d');
        if (!context) return null;
        context.clearRect(0, 0, width, height);

        for (let i = 0; i < 160; i += 1) {
          const x = Math.abs(seededNoise(i, 9)) * width;
          const y = Math.abs(seededNoise(17, i)) * height;
          const w = 18 + Math.abs(seededNoise(x, i)) * 76;
          const h = 4 + Math.abs(seededNoise(i, y)) * 18;
          const opacity = 0.035 + Math.abs(seededNoise(x, y)) * 0.07;
          context.fillStyle = `rgba(255, 255, 255, ${opacity})`;
          context.beginPath();
          context.ellipse(x, y, w, h, seededNoise(y, x) * Math.PI, 0, Math.PI * 2);
          context.fill();
        }

        const texture = new THREE.CanvasTexture(cloudCanvas);
        texture.colorSpace = THREE.SRGBColorSpace;
        return texture;
      }

      const earthGeometry = new THREE.SphereGeometry(2, 96, 96);
      const textureLoader = new THREE.TextureLoader();
      const earthTexture = textureLoader.load('/images/earth-black-marble-2016.jpg');
      earthTexture.colorSpace = THREE.SRGBColorSpace;
      earthTexture.anisotropy = 8;
      const earthMaterial = new THREE.MeshStandardMaterial({
        color: 0xffffff,
        map: earthTexture,
        emissiveMap: earthTexture,
        emissive: 0xd39b52,
        emissiveIntensity: 0.36,
        metalness: 0.1,
        roughness: 0.58,
      });
      const earth = new THREE.Mesh(earthGeometry, earthMaterial);
      globe.add(earth);

      const wire = new THREE.Mesh(
        new THREE.SphereGeometry(2.006, 36, 24),
        new THREE.MeshBasicMaterial({
          color: 0x8fb6dd,
          transparent: true,
          opacity: 0.035,
          wireframe: true,
        })
      );
      globe.add(wire);

      const cloudTexture = createCloudTexture();
      const clouds = new THREE.Mesh(
        new THREE.SphereGeometry(2.032, 96, 96),
        new THREE.MeshBasicMaterial({
          map: cloudTexture || undefined,
          color: 0xffffff,
          transparent: true,
          opacity: 0.18,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        })
      );
      globe.add(clouds);

      const atmosphere = new THREE.Mesh(
        new THREE.SphereGeometry(2.16, 96, 96),
        new THREE.MeshBasicMaterial({
          color: 0x6aabff,
          transparent: true,
          opacity: 0.12,
          side: THREE.BackSide,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        })
      );
      globe.add(atmosphere);

      const routeGeometries = [];
      const routeMaterials = [];
      const lightMaterials = [];

      function addCityLightCluster(lat, lon, count, radius, color = 0xf0c66a) {
        const positions = new Float32Array(count * 3);
        for (let index = 0; index < count; index += 1) {
          const angle = seededNoise(lat + index, lon) * Math.PI * 2;
          const distance = Math.abs(seededNoise(lon, lat + index)) * radius;
          const pointLat = lat + Math.sin(angle) * distance;
          const pointLon = lon + Math.cos(angle) * distance * 1.25;
          const position = latLonToVector3(pointLat, pointLon, 2.095);
          positions[index * 3] = position.x;
          positions[index * 3 + 1] = position.y;
          positions[index * 3 + 2] = position.z;
        }

        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        const material = new THREE.PointsMaterial({
          color,
          size: 0.012,
          transparent: true,
          opacity: 0.48,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        });
        const lights = new THREE.Points(geometry, material);
        lights.userData.phase = seededNoise(lat, lon) * Math.PI * 2;
        globe.add(lights);
        routeGeometries.push(geometry);
        routeMaterials.push(material);
        lightMaterials.push(material);
      }

      function addOrbitRing(radius, y, color, opacity) {
        const curve = new THREE.EllipseCurve(0, 0, radius, radius, 0, Math.PI * 2);
        const positions = curve.getPoints(128).map((point) => new THREE.Vector3(point.x, y, point.y));
        const geometry = new THREE.BufferGeometry().setFromPoints(positions);
        const material = new THREE.LineBasicMaterial({
          color,
          transparent: true,
          opacity,
        });
        const ring = new THREE.LineLoop(geometry, material);
        globe.add(ring);
      }

      [-1.35, -0.68, 0, 0.68, 1.35].forEach((y, index) => {
        addOrbitRing(Math.sqrt(Math.max(0.01, 4 - y * y)), y, index === 2 ? 0xc9a227 : 0x88a7c4, index === 2 ? 0.1 : 0.04);
      });

      function addMeridian(rotationZ) {
        const curve = new THREE.EllipseCurve(0, 0, 2.012, 2.012, 0, Math.PI * 2);
        const positions = curve.getPoints(128).map((point) => new THREE.Vector3(point.x, point.y, 0));
        const geometry = new THREE.BufferGeometry().setFromPoints(positions);
        const material = new THREE.LineBasicMaterial({
          color: 0x88a7c4,
          transparent: true,
          opacity: 0.09,
        });
        const meridian = new THREE.LineLoop(geometry, material);
        meridian.rotation.y = Math.PI / 2;
        meridian.rotation.z = rotationZ;
        globe.add(meridian);
      }

      Array.from({ length: 6 }, (_, index) => addMeridian((Math.PI / 6) * index));

      function latLonToVector3(lat, lon, radius = 2.055) {
        const phi = THREE.MathUtils.degToRad(90 - lat);
        const theta = THREE.MathUtils.degToRad(lon + 180);

        return new THREE.Vector3(
          -radius * Math.sin(phi) * Math.cos(theta),
          radius * Math.cos(phi),
          radius * Math.sin(phi) * Math.sin(theta)
        );
      }

      function createSurfaceRouteCurve(start, end) {
        const startNormal = start.clone().normalize();
        const endNormal = end.clone().normalize();
        const dot = THREE.MathUtils.clamp(startNormal.dot(endNormal), -1, 1);
        const theta = Math.acos(dot);
        const sinTheta = Math.sin(theta);
        const routePoints = [];

        for (let step = 0; step <= 72; step += 1) {
          const t = step / 72;
          let point;

          if (sinTheta < 0.001) {
            point = startNormal.clone().lerp(endNormal, t);
          } else {
            point = startNormal.clone()
              .multiplyScalar(Math.sin((1 - t) * theta) / sinTheta)
              .add(endNormal.clone().multiplyScalar(Math.sin(t * theta) / sinTheta));
          }

          const lift = 0.026 + Math.sin(t * Math.PI) * (0.028 + theta * 0.014);
          routePoints.push(point.normalize().multiplyScalar(2.065 + lift));
        }

        return new THREE.CatmullRomCurve3(routePoints);
      }

      function addBrassRoute(curve) {
        const shadowGeometry = new THREE.TubeGeometry(curve, 96, 0.009, 8, false);
        const shadowMaterial = new THREE.MeshBasicMaterial({
          color: 0x3d2a07,
          transparent: true,
          opacity: 0.24,
          depthWrite: false,
        });
        const shadow = new THREE.Mesh(shadowGeometry, shadowMaterial);
        globe.add(shadow);
        routeGeometries.push(shadowGeometry);
        routeMaterials.push(shadowMaterial);

        const coreGeometry = new THREE.TubeGeometry(curve, 96, 0.0042, 12, false);
        const coreMaterial = new THREE.MeshStandardMaterial({
          color: 0xb8902d,
          metalness: 0.78,
          roughness: 0.26,
          emissive: 0x3a2505,
          emissiveIntensity: 0.18,
          transparent: true,
          opacity: 0.74,
          depthWrite: false,
        });
        const core = new THREE.Mesh(coreGeometry, coreMaterial);
        globe.add(core);
        routeGeometries.push(coreGeometry);
        routeMaterials.push(coreMaterial);

        const highlightGeometry = new THREE.BufferGeometry().setFromPoints(curve.getPoints(96));
        const highlightMaterial = new THREE.LineDashedMaterial({
          color: 0xffdf91,
          dashSize: 0.035,
          gapSize: 0.038,
          transparent: true,
          opacity: 0.52,
          depthWrite: false,
        });
        const highlight = new THREE.Line(highlightGeometry, highlightMaterial);
        highlight.computeLineDistances();
        globe.add(highlight);
        routeGeometries.push(highlightGeometry);
        routeMaterials.push(highlightMaterial);
      }

      [
        [39.9, 116.4, 46, 0.9],
        [39.3, 117.4, 28, 0.6],
        [31.2, 121.5, 54, 0.8],
        [23.1, 113.3, 46, 0.75],
        [22.5, 114.1, 42, 0.55],
        [35.7, 139.7, 52, 0.65],
        [34.7, 135.5, 42, 0.55],
        [37.5, 127.0, 38, 0.55],
        [25.0, 121.5, 32, 0.45],
        [13.8, 100.5, 26, 0.45],
      ].forEach(([lat, lon, count, radius]) => addCityLightCluster(lat, lon, count, radius));

      const markerGeometry = new THREE.SphereGeometry(0.024, 24, 24);
      const markerRingGeometry = new THREE.TorusGeometry(0.042, 0.003, 8, 32);
      const haloGeometry = new THREE.SphereGeometry(0.043, 20, 20);
      const markerMaterial = new THREE.MeshStandardMaterial({
        color: 0xd4af37,
        metalness: 0.82,
        roughness: 0.2,
        emissive: 0x5b3807,
        emissiveIntensity: 0.25,
      });
      const markerRingMaterial = new THREE.MeshStandardMaterial({
        color: 0xe7c76c,
        metalness: 0.86,
        roughness: 0.18,
        emissive: 0x3c2606,
        emissiveIntensity: 0.2,
      });
      const markerHaloMaterial = new THREE.MeshBasicMaterial({
        color: 0xc9a227,
        transparent: true,
        opacity: 0.1,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
      });

      points.forEach((point) => {
        const position = latLonToVector3(point.lat, point.lon);
        const normal = position.clone().normalize();
        const marker = new THREE.Mesh(markerGeometry, markerMaterial);
        marker.position.copy(position);
        globe.add(marker);

        const ring = new THREE.Mesh(markerRingGeometry, markerRingMaterial);
        ring.position.copy(normal.clone().multiplyScalar(2.092));
        ring.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), normal);
        globe.add(ring);

        const halo = new THREE.Mesh(haloGeometry, markerHaloMaterial);
        halo.position.copy(position);
        globe.add(halo);
      });

      for (let index = 1; index < points.length; index += 1) {
        const previous = points[index - 1];
        const current = points[index];
        const start = latLonToVector3(previous.lat, previous.lon, 2.065);
        const end = latLonToVector3(current.lat, current.lon, 2.065);
        addBrassRoute(createSurfaceRouteCurve(start, end));
      }

      const starGeometry = new THREE.BufferGeometry();
      const starPositions = new Float32Array(260 * 3);
      for (let index = 0; index < 260; index += 1) {
        const radius = 8 + Math.random() * 12;
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos(2 * Math.random() - 1);
        starPositions[index * 3] = radius * Math.sin(phi) * Math.cos(theta);
        starPositions[index * 3 + 1] = radius * Math.cos(phi);
        starPositions[index * 3 + 2] = -Math.abs(radius * Math.sin(phi) * Math.sin(theta)) - 2;
      }
      starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
      const stars = new THREE.Points(
        starGeometry,
        new THREE.PointsMaterial({
          color: 0xd8e6ff,
          size: 0.035,
          transparent: true,
          opacity: 0.46,
          depthWrite: false,
        })
      );
      scene.add(stars);

      let targetRotationX = 0.18;
      let targetRotationY = 2.54;
      let isDragging = false;
      let lastX = 0;
      let lastY = 0;

      globe.rotation.x = targetRotationX;
      globe.rotation.y = targetRotationY;
      globe.rotation.z = 0.04;

      function resize() {
        const width = Math.max(1, root.clientWidth);
        const height = Math.max(1, root.clientHeight);
        const isMobile = width < 720;

        renderer.setSize(width, height, false);
        camera.aspect = width / height;
        camera.position.set(isMobile ? 0 : 0.18, isMobile ? 0.5 : 0.2, isMobile ? 5.65 : 5.15);
        camera.lookAt(isMobile ? 0 : 0.08, isMobile ? -0.08 : -0.16, 0);
        camera.updateProjectionMatrix();

        globe.position.set(isMobile ? 0.08 : 0.24, isMobile ? -0.34 : -0.34, 0);
        const scale = isMobile ? 0.98 : 1.08;
        globe.scale.setScalar(scale);
      }

      function onPointerDown(event) {
        isDragging = true;
        lastX = event.clientX;
        lastY = event.clientY;
        canvas.setPointerCapture(event.pointerId);
      }

      function onPointerMove(event) {
        if (!isDragging) return;
        const deltaX = event.clientX - lastX;
        const deltaY = event.clientY - lastY;
        targetRotationY += deltaX * 0.004;
        targetRotationX = THREE.MathUtils.clamp(targetRotationX + deltaY * 0.002, -0.72, 0.34);
        lastX = event.clientX;
        lastY = event.clientY;
      }

      function onPointerUp(event) {
        isDragging = false;
        if (canvas.hasPointerCapture(event.pointerId)) {
          canvas.releasePointerCapture(event.pointerId);
        }
      }

      canvas.addEventListener('pointerdown', onPointerDown);
      canvas.addEventListener('pointermove', onPointerMove);
      canvas.addEventListener('pointerup', onPointerUp);
      canvas.addEventListener('pointercancel', onPointerUp);
      window.addEventListener('resize', resize);

      let animationFrame = 0;
      let lastCanvasSample = 0;

      function sampleCanvasPixels() {
        const sample = document.createElement('canvas');
        sample.width = 72;
        sample.height = 72;
        const context = sample.getContext('2d', { willReadFrequently: true });
        if (!context) return;

        context.drawImage(canvas, 0, 0, sample.width, sample.height);
        const data = context.getImageData(0, 0, sample.width, sample.height).data;
        let nonTransparent = 0;
        let bright = 0;

        for (let index = 0; index < data.length; index += 4) {
          const red = data[index];
          const green = data[index + 1];
          const blue = data[index + 2];
          const alpha = data[index + 3];

          if (alpha > 4) nonTransparent += 1;
          if (red + green + blue > 80) bright += 1;
        }

        root.dataset.canvasPixelSample = JSON.stringify({
          width: canvas.width,
          height: canvas.height,
          nonTransparent,
          bright,
          total: sample.width * sample.height,
        });
      }

      function animate(time = 0) {
        globe.rotation.x += (targetRotationX - globe.rotation.x) * 0.07;
        globe.rotation.y += (targetRotationY - globe.rotation.y) * 0.07;
        stars.rotation.y += 0.00008;
        lightMaterials.forEach((material, index) => {
          material.opacity = 0.34 + Math.sin(time * 0.0017 + index * 1.73) * 0.12;
        });

        renderer.render(scene, camera);
        if (time - lastCanvasSample > 1200) {
          lastCanvasSample = time;
          sampleCanvasPixels();
        }

        animationFrame = requestAnimationFrame(animate);
      }

      function cleanup() {
        cancelAnimationFrame(animationFrame);
        window.removeEventListener('resize', resize);
        canvas.removeEventListener('pointerdown', onPointerDown);
        canvas.removeEventListener('pointermove', onPointerMove);
        canvas.removeEventListener('pointerup', onPointerUp);
        canvas.removeEventListener('pointercancel', onPointerUp);
        root.dataset.earthReady = 'false';
        renderer.dispose();
        earthGeometry.dispose();
        earthTexture.dispose();
        cloudTexture?.dispose();
        markerGeometry.dispose();
        markerRingGeometry.dispose();
        haloGeometry.dispose();
        markerMaterial.dispose();
        markerRingMaterial.dispose();
        markerHaloMaterial.dispose();
        routeGeometries.forEach((geometry) => geometry.dispose());
        routeMaterials.forEach((material) => material.dispose());
        starGeometry.dispose();
      }

      resize();
      animate();
      document.addEventListener('astro:before-swap', cleanup, { once: true });
    });
  }

  if (!atlasWindow.__shanJourneyEarthReady) {
    atlasWindow.__shanJourneyEarthReady = true;
    initJourneyEarthScenes();
    document.addEventListener('astro:page-load', initJourneyEarthScenes);
  } else {
    initJourneyEarthScenes();
  }
</script>

<style>
  .journey-shell {
    position: relative;
    min-height: calc(100vh - 4.5rem);
    margin: calc(-1 * var(--space-xl)) 0 calc(-1 * var(--space-xl));
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(circle at 63% 42%, rgba(106, 171, 255, 0.22), transparent 34rem),
      radial-gradient(circle at 42% 70%, rgba(201, 162, 39, 0.17), transparent 22rem),
      rgba(8, 10, 18, 0.2);
  }

  .earth-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: grab;
    z-index: 0;
  }

  .earth-canvas:active {
    cursor: grabbing;
  }

  .journey-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(5, 6, 11, 0.55), rgba(5, 6, 11, 0.04) 46%, rgba(5, 6, 11, 0.38)),
      linear-gradient(180deg, rgba(5, 6, 11, 0.46), transparent 28%, rgba(5, 6, 11, 0.58));
  }

  .journey-copy {
    position: relative;
    z-index: 2;
    width: max-content;
    padding: clamp(1.6rem, 4vw, 3.4rem) 0 0 clamp(2rem, 7vw, 7rem);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.65);
  }

  .journey-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(232, 229, 220, 0.76);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .journey-back:hover,
  .journey-back:focus-visible {
    color: var(--color-brass-light);
  }

  .journey-route {
    position: absolute;
    right: clamp(1.25rem, 5vw, 5rem);
    bottom: clamp(1.25rem, 4vw, 3.2rem);
    z-index: 2;
    width: min(27rem, 36vw);
    color: var(--color-text-secondary);
  }

  .journey-route p {
    margin-bottom: 0.8rem;
    color: var(--color-brass-light);
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .journey-route ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 0.7rem;
    max-height: min(34vh, 22rem);
    overflow: auto;
    padding: 0.15rem 0.25rem 0.15rem 0;
    list-style: none;
    scrollbar-width: thin;
    scrollbar-color: rgba(201, 162, 39, 0.32) transparent;
  }

  .journey-route li {
    position: relative;
    min-width: 0;
    padding: 0.5rem 0.55rem 0.45rem 0.72rem;
    border-left: 1px solid rgba(201, 162, 39, 0.34);
    background: linear-gradient(90deg, rgba(201, 162, 39, 0.07), transparent);
  }

  .journey-route li[data-kind='travel'] {
    border-left-color: rgba(106, 171, 255, 0.52);
    background: linear-gradient(90deg, rgba(106, 171, 255, 0.07), transparent);
  }

  .journey-route li[data-kind='work'] {
    border-left-color: rgba(212, 168, 75, 0.62);
  }

  .journey-route li[data-kind='event'] {
    border-left-color: rgba(159, 183, 255, 0.68);
  }

  .journey-route span,
  .journey-route em {
    display: block;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-style: normal;
    line-height: 1.35;
  }

  .journey-route strong {
    display: block;
    overflow: hidden;
    margin: 0.1rem 0;
    color: var(--color-text-primary);
    font-size: 0.94rem;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .journey-route {
      width: min(24rem, 42vw);
    }

    .journey-route ol {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .journey-shell {
      min-height: calc(100vh - 3.4rem);
