---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultLocale, localizePath, localizeString, type Locale } from '../../i18n/config';
import { travelPoints } from '../../data/travel';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;

const journeyCopy: Record<Locale, {
  title: string;
  back: string;
}> = {
  en: {
    title: 'Travel Atlas',
    back: 'Back Home',
  },
  zh: {
    title: '旅行星图',
    back: '返回首页',
  },
  ja: {
    title: '旅の星図',
    back: 'ホームへ',
  },
};

const journeyKindLabels: Record<Locale, Record<string, string>> = {
  en: {
    study: 'Study',
    travel: 'Travel',
    work: 'Work',
    event: 'Event',
  },
  zh: {
    study: '学习',
    travel: '旅行',
    work: '工作',
    event: '事件',
  },
  ja: {
    study: '学び',
    travel: '旅',
    work: '仕事',
    event: 'イベント',
  },
};

const copy = journeyCopy[lang];
const scenePoints = travelPoints.map((point) => ({
  id: point.id,
  name: localizeString(point.name, lang),
  note: localizeString(point.note, lang),
  lat: point.lat,
  lon: point.lon,
  year: point.year,
  period: localizeString(point.period, lang),
  kind: point.kind,
  kindLabel: journeyKindLabels[lang][point.kind] ?? point.kind,
}));
---

<BaseLayout title={copy.title} lang={lang}>
  <section
    class="journey-shell"
    data-earth-scene
    data-points={JSON.stringify(scenePoints)}
    aria-label={copy.title}
  >
    <canvas class="earth-canvas" data-earth-canvas aria-label={copy.title}></canvas>
    <div class="journey-vignette" aria-hidden="true"></div>

    <div class="journey-copy">
      <a class="journey-back" href={localizePath('/', lang)}>
        <span aria-hidden="true">←</span>
        {copy.back}
      </a>
    </div>

    <div class="journey-place-card" data-place-card hidden>
      <span class="journey-place-media" aria-hidden="true">
        <span class="journey-place-initial" data-place-initial></span>
      </span>
      <span class="journey-place-kicker" data-place-kicker></span>
      <strong data-place-name></strong>
      <span class="journey-place-note" data-place-note></span>
    </div>
  </section>
</BaseLayout>

<script>
  const atlasWindow = window as typeof window & { __shanJourneyEarthReady?: boolean };

  async function loadJourneyEarthScenes() {
    const { initJourneyEarthScenes } = await import('../../scripts/journey-earth');
    initJourneyEarthScenes();
  }

  if (!atlasWindow.__shanJourneyEarthReady) {
    atlasWindow.__shanJourneyEarthReady = true;
    void loadJourneyEarthScenes();
    document.addEventListener('astro:page-load', () => {
      void loadJourneyEarthScenes();
    });
  } else {
    void loadJourneyEarthScenes();
  }
</script>

<style>
  .journey-shell {
    position: relative;
    height: 100%;
    min-height: 0;
    margin: 0;
    overflow: visible;
    isolation: isolate;
    background:
      radial-gradient(circle at 63% 42%, rgba(106, 171, 255, 0.22), transparent 34rem),
      radial-gradient(circle at 42% 70%, rgba(201, 162, 39, 0.17), transparent 22rem),
      rgba(8, 10, 18, 0.2);
  }

  :global(html:has(.journey-shell)),
  :global(body:has(.journey-shell)) {
    height: 100%;
    overflow: hidden;
  }

  :global(body:has(.journey-shell) .page-wrapper) {
    height: 100dvh;
    min-height: 100dvh;
    overflow: hidden;
  }

  :global(body:has(.journey-shell) .main-content) {
    flex: 1 1 auto;
    min-height: 0;
    padding: 0;
    overflow: visible;
  }

  :global(body:has(.journey-shell) .site-footer) {
    display: none;
  }

  .earth-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: grab;
    z-index: 0;
  }

  .earth-canvas:active {
    cursor: grabbing;
  }

  .journey-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(5, 6, 11, 0.55), rgba(5, 6, 11, 0.04) 46%, rgba(5, 6, 11, 0.38)),
      linear-gradient(180deg, rgba(5, 6, 11, 0.46), transparent 28%, rgba(5, 6, 11, 0.58));
  }

  .journey-copy {
    position: relative;
    z-index: 2;
    width: max-content;
    padding: clamp(1.6rem, 4vw, 3.4rem) 0 0 clamp(2rem, 7vw, 7rem);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.65);
  }

  .journey-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(232, 229, 220, 0.76);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .journey-back:hover,
  .journey-back:focus-visible {
    color: var(--color-brass-light);
  }

  .journey-place-card {
    position: absolute;
    z-index: 3;
    display: grid;
    grid-template-rows: auto auto auto auto;
    gap: 0.42rem;
    width: min(12.25rem, calc(100vw - 1.5rem));
    padding: 0.6rem 0.62rem 0.72rem;
    border: 1px solid rgba(201, 162, 39, 0.26);
    border-radius: 6px;
    background:
      linear-gradient(180deg, rgba(201, 162, 39, 0.09), rgba(255, 255, 255, 0.025)),
      rgba(10, 10, 15, 0.94);
    box-shadow:
      0 18px 42px rgba(0, 0, 0, 0.38),
      0 0 18px rgba(201, 162, 39, 0.08);
    color: var(--color-text-secondary);
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.35rem) scale(0.98);
    transform-origin: var(--pin-x, 50%) calc(100% + 1.35rem);
    transition:
      opacity 0.16s ease,
      transform 0.16s ease;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .journey-place-card[hidden] {
    display: none;
  }

  .journey-place-card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .journey-place-card::after {
    content: '';
    position: absolute;
    left: var(--pin-x, 50%);
    bottom: -0.38rem;
    width: 0.7rem;
    height: 0.7rem;
    border-right: 1px solid rgba(201, 162, 39, 0.22);
    border-bottom: 1px solid rgba(201, 162, 39, 0.22);
    background: rgba(10, 10, 15, 0.94);
    pointer-events: none;
    transform: translateX(-50%) rotate(45deg);
  }

  .journey-place-media {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    background:
      radial-gradient(circle at 50% 38%, rgba(201, 162, 39, 0.16), transparent 28%),
      radial-gradient(circle at 44% 60%, rgba(123, 167, 217, 0.12), transparent 34%),
      linear-gradient(150deg, rgba(201, 162, 39, 0.08), rgba(255, 255, 255, 0.025)),
      rgba(255, 255, 255, 0.035);
  }

  .journey-place-media::before {
    content: '';
    position: absolute;
    inset: 13%;
    border: 1px solid rgba(201, 162, 39, 0.2);
    border-radius: 4px;
    pointer-events: none;
    transform: rotate(45deg);
  }

  .journey-place-initial {
    position: relative;
    z-index: 1;
    color: rgba(245, 225, 162, 0.78);
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 8vw, 3.3rem);
    line-height: 1;
    text-transform: uppercase;
    text-shadow: 0 0 18px rgba(201, 162, 39, 0.22);
  }

  .journey-place-kicker {
    display: block;
    margin-bottom: 0.24rem;
    color: var(--color-brass-light);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .journey-place-card strong {
    display: block;
    color: var(--color-text-primary);
    font-size: 0.95rem;
    line-height: 1.2;
  }

  .journey-place-note {
    display: block;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.35;
  }

  @media (max-width: 720px) {
    .journey-shell {
      background:
        radial-gradient(circle at 52% 48%, rgba(106, 171, 255, 0.2), transparent 18rem),
        radial-gradient(circle at 48% 78%, rgba(201, 162, 39, 0.15), transparent 14rem),
        rgba(8, 10, 18, 0.18);
    }

    .journey-vignette {
      background:
        linear-gradient(180deg, rgba(5, 6, 11, 0.56), rgba(5, 6, 11, 0.08) 36%, rgba(5, 6, 11, 0.62)),
        linear-gradient(90deg, rgba(5, 6, 11, 0.42), transparent 50%, rgba(5, 6, 11, 0.28));
    }

    .journey-copy {
      width: max-content;
      padding: 1.15rem 1rem 0;
    }

    .journey-back {
      font-size: 0.74rem;
    }

    .journey-place-card {
      width: min(11.5rem, calc(100vw - 1.5rem));
      padding: 0.56rem 0.58rem 0.68rem;
    }
  }

  @media (max-width: 420px) {
    .journey-copy {
      padding-inline: 1rem;
    }
  }
</style>
