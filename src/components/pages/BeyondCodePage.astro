---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import { categories, nodes, edges, resolveLocalized } from '../../data/beyond-code';
import media from '../../data/beyond-code-media.json';
import thumbnails from '../../data/beyond-code-thumbnails.json';
import { localizePath, type Locale } from '../../i18n/config';

interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props;
const copy = {
  en: {
    eyebrow: 'A PERSONAL CONSTELLATION', title: 'Beyond Code',
    subtitle: "What I've watched, read, played, and listened to, plus the food and ideas I enjoy.",
    all: 'All', search: 'Find something…', constellation: 'Constellation', index: 'Index', surprise: 'Surprise me',
    reset: 'Reset constellation', stepBack: 'Back',
    zoomIn: 'Zoom in', zoomOut: 'Zoom out', pauseMotion: 'Pause floating motion', resumeMotion: 'Resume floating motion',
    reducedMotion: 'Motion is off to follow your system preference', close: 'Close introduction',
    related: 'Connected worlds', nearby: 'In this constellation', source: 'Explore further',
    noResults: 'No matching worlds.', back: 'Back to About', collection: 'From my collection',
    context: 'Related creator or source', playing: 'Pause preview', play: 'Play preview',
  },
  zh: {
    eyebrow: '我的兴趣星群', title: '代码之外', subtitle: '记录我看过、读过、玩过、听过的作品，以及喜欢的食物和想法。',
    all: '全部', search: '寻找一颗星…', constellation: '星群', index: '索引', surprise: '随便看看',
    reset: '重置星群', stepBack: '返回上一步', zoomIn: '放大', zoomOut: '缩小',
    pauseMotion: '暂停气泡漂浮', resumeMotion: '恢复气泡漂浮', reducedMotion: '已根据系统偏好关闭动态效果',
    close: '关闭介绍', related: '相连的世界', nearby: '同一片星群',
    source: '继续了解', noResults: '没有找到相关内容。', back: '返回关于我',
    collection: '我的收藏', context: '相关创作者或原作', playing: '暂停试听', play: '试听',
  },
  ja: {
    eyebrow: '私の小さな星座', title: 'コードを超えて', subtitle: '観たもの、読んだもの、遊んだもの、聴いたもの。好きな食べ物や関心のあることも。',
    all: 'すべて', search: '星を探す…', constellation: '星座', index: '一覧', surprise: 'おまかせ',
    reset: '星座をリセット', stepBack: 'ひとつ戻る', zoomIn: '拡大', zoomOut: '縮小',
    pauseMotion: '浮遊する動きを止める', resumeMotion: '浮遊する動きを再開する', reducedMotion: 'システム設定に従って動きを停止しています',
    close: '紹介を閉じる', related: 'つながる世界', nearby: '同じ星座から',
    source: 'もっと知る', noResults: '見つかりませんでした。', back: 'About に戻る',
    collection: '私のコレクション', context: '関連する作り手・原作', playing: '試聴を止める', play: '試聴',
  },
}[lang];

type MediaEntry = { artwork?: string; description?: string; source?: string };
const nodeMedia = media as Record<string, MediaEntry>;
const thumbnailImages = thumbnails.images as Record<string, { thumbnail: string }>;
function thumbnailFor(artwork: string) {
  if (!artwork) return '';
  const entry = thumbnailImages[artwork];
  if (!entry) throw new Error(`Missing collection thumbnail for ${artwork}; run npm run generate:beyond-thumbnails`);
  return entry.thumbnail;
}
const localizedCategories = categories.map((category) => ({ ...category, title: resolveLocalized(category.title, lang) }));
const graphNodes = nodes.map((node) => ({
  ...node,
  title: resolveLocalized(node.title, lang),
  subtitle: resolveLocalized(node.subtitle, lang),
  searchText: [resolveLocalized(node.title, 'en'), resolveLocalized(node.title, 'zh'), resolveLocalized(node.title, 'ja')].join(' '),
  artwork: nodeMedia[node.id]?.artwork || node.artwork || '',
  thumbnail: thumbnailFor(nodeMedia[node.id]?.artwork || node.artwork || ''),
  description: nodeMedia[node.id]?.description || '',
  externalUrl: node.externalUrl || nodeMedia[node.id]?.source || '',
}));
const graphData = JSON.stringify({
  categories: localizedCategories, nodes: graphNodes,
  edges: edges.map((edge) => ({ ...edge, label: resolveLocalized(edge.label, lang) })),
  copy, lang,
}).replace(/</g, '\\u003c');
---

<BaseLayout title={copy.title} lang={lang}>
  <section class="beyond" data-beyond>
    <div class="beyond-heading">
      <div>
        <a class="beyond-back" href={`${localizePath('/about', lang)}#beyond-code`}>
          <Icon name="chevronLeft" size={13} /> {copy.back}
        </a>
        <p class="beyond-eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
        <p class="beyond-subtitle">{copy.subtitle}</p>
      </div>
      <div class="beyond-tools">
        <label class="beyond-search">
          <Icon name="search" size={17} />
          <input type="search" placeholder={copy.search} aria-label={copy.search} data-beyond-search autocomplete="off" />
        </label>
        <div class="beyond-view-actions">
          <div class="beyond-view" role="group" aria-label={lang === 'zh' ? '浏览方式' : 'View'}>
            <button type="button" aria-pressed="true" data-beyond-view="graph"><Icon name="sparkle" size={15} /> {copy.constellation}</button>
            <button type="button" aria-pressed="false" data-beyond-view="index"><Icon name="layers" size={15} /> {copy.index}</button>
          </div>
          <button type="button" class="beyond-surprise" data-beyond-surprise disabled>
            <span>{copy.surprise}</span>
            <Icon name="arrowRight" size={14} />
          </button>
        </div>
      </div>
    </div>

    <nav class="beyond-categories" aria-label={lang === 'zh' ? '兴趣分类' : 'Interest categories'}>
      <button type="button" class="is-active" aria-pressed="true" data-beyond-category="all">{copy.all}</button>
      {localizedCategories.map((category) => (
        <button type="button" aria-pressed="false" data-beyond-category={category.id}>
          <Icon name={category.icon} size={15} />{category.title}
        </button>
      ))}
    </nav>
    <div class="beyond-stage" data-beyond-stage>
      <div class="beyond-breadcrumb" hidden>
        <button type="button" data-beyond-back hidden disabled>
          <Icon name="chevronLeft" size={14} />{copy.stepBack}
        </button>
      </div>
      <div class="beyond-atmosphere" aria-hidden="true"></div>
      <div class="beyond-graph" data-beyond-graph role="group" aria-label={copy.constellation}>
        <canvas class="beyond-links" data-beyond-canvas aria-hidden="true"></canvas>
        <div class="beyond-regions" aria-hidden="true">
          {localizedCategories.map((category) => (
            <span class="beyond-region-label" data-region-label={category.id} hidden>{category.title}</span>
          ))}
        </div>
        <div class="beyond-nodes">
          {graphNodes.map((node) => {
            const category = localizedCategories.find((category) => category.id === node.category)!;
            return (
              <button type="button" class:list={['beyond-node', `beyond-node--${node.type}`, { 'has-artwork': !!node.artwork }]}
                data-node={node.id} aria-label={`${node.title} · ${category.title}`} aria-pressed="false">
                <span class="beyond-node-art">
                  {node.artwork ? <img src={node.thumbnail} alt="" loading="eager" decoding="async" draggable="false" /> : <Icon name={category.icon} size={21} />}
                </span>
                <span class="beyond-node-label"><span data-node-label-title>{node.title}</span><small>{category.title}</small></span>
                {node.subtitle && <span class="beyond-node-subtitle">{node.subtitle}</span>}
              </button>
            );
          })}
        </div>
      </div>

      <div class="beyond-index" data-beyond-index hidden>
        {localizedCategories.map((category) => (
          <section class="beyond-index-category" data-index-category={category.id}>
            <h2><Icon name={category.icon} size={17} />{category.title}</h2>
            <div class="beyond-index-works">
              {graphNodes.filter((node) => node.category === category.id && !node.isContext).map((node) => (
                <button class="beyond-index-item" type="button" data-index-node={node.id}>
                  <span class="beyond-index-cover">
                    {node.artwork ? <img src={node.artwork} alt="" loading="lazy" decoding="async" /> : <Icon name={category.icon} size={21} />}
                  </span>
                  <span>{node.title}{node.subtitle && <small>{node.subtitle}</small>}</span>
                  <Icon name="arrowRight" size={15} />
                </button>
              ))}
            </div>
          </section>
        ))}
      </div>

      <p class="beyond-no-results" data-beyond-empty hidden>{copy.noResults}</p>
      <div class="beyond-bottom" data-beyond-bottom>
        <div class="beyond-navigation" role="group" aria-label={copy.constellation}>
          <button type="button" data-beyond-motion aria-label={copy.pauseMotion} aria-pressed="true" title={copy.pauseMotion}>
            <span class="beyond-motion-pause" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M8 5v14M16 5v14" /></svg></span>
            <span class="beyond-motion-play" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="m8 5 11 7-11 7Z" /></svg></span>
          </button>
          <span class="beyond-control-divider"></span>
          <button type="button" data-beyond-zoom="out" aria-label={copy.zoomOut} title={copy.zoomOut}><Icon name="minus" size={17} /></button>
          <button type="button" data-beyond-zoom="in" aria-label={copy.zoomIn} title={copy.zoomIn}><Icon name="plus" size={17} /></button>
          <button type="button" data-beyond-reset aria-label={copy.reset} title={copy.reset}><Icon name="rotateCcw" size={16} /></button>
        </div>
      </div>

      <aside class="beyond-detail" data-beyond-detail aria-labelledby="beyond-detail-title" hidden>
        <button type="button" class="beyond-detail-close" data-beyond-close aria-label={copy.close}><Icon name="x" size={20} /></button>
        <div class="beyond-detail-image" data-detail-image></div>
        <div class="beyond-detail-copy">
          <p class="beyond-detail-category" data-detail-category></p>
          <h2 id="beyond-detail-title" tabindex="-1" data-detail-title></h2>
          <p class="beyond-detail-subtitle" data-detail-subtitle></p>
          <p class="beyond-detail-description" data-detail-description></p>
          <div class="beyond-detail-links" data-detail-links></div>
          <a class="beyond-detail-source" data-detail-source target="_blank" rel="noopener noreferrer">{copy.source}<Icon name="arrowRight" size={15} /></a>
        </div>
      </aside>
    </div>
    <script type="application/json" data-beyond-data set:html={graphData}></script>
  </section>
</BaseLayout>

<script>
  import '../../scripts/beyond-code';
</script>

<style>
  :global(body:has([data-beyond]) .main-content) { padding: 0; }
  :global(body:has([data-beyond]) .site-footer) { padding-top: 0; }
  .beyond { --beyond-ink: #e3dccb; max-width: 1660px; margin: 0 auto; padding: 22px 48px 0; }
  .beyond-heading { display:flex; justify-content:space-between; align-items:flex-end; gap:32px; padding:0 12px 19px; }
  .beyond-back { display:inline-flex; align-items:center; gap:3px; font-size:12px; color:var(--color-text-muted); text-decoration:none; margin-bottom:9px; }
  .beyond-back:hover { color:var(--color-brass-light); }
  .beyond-eyebrow { font-family:var(--font-mono); font-size:10px; color:#a69770; letter-spacing:.22em; }
  h1 { font:400 clamp(2.1rem,3.3vw,3rem)/1.2 var(--font-display); color:#f0e9d9; margin:5px 0 3px; letter-spacing:.015em; }
  .beyond-subtitle { font-family:var(--font-page-subtitle); color:#aaa49a; font-size:16px; font-style:italic; }
  .beyond-tools { display:flex; flex-direction:column; align-items:flex-end; gap:21px; padding-bottom:5px; }
  .beyond-search { width:215px; display:flex; align-items:center; gap:9px; padding:7px 0; border-bottom:1px solid rgba(201,162,39,.22); }
  .beyond-search input { appearance:none; width:100%; background:transparent; color:var(--color-text-primary); border:0; outline:0; font:16px var(--font-body); }
  .beyond-search:focus-within { border-color:var(--color-brass); }
  .beyond-search input::placeholder { color:#8d8982; }
  .beyond-view-actions { display:flex; align-items:center; justify-content:flex-end; gap:14px; }
  .beyond-view { display:flex; gap:3px; }
  .beyond button { font-family:var(--font-about-copy); cursor:pointer; -webkit-tap-highlight-color:transparent; }
  .beyond-view button { display:flex; align-items:center; gap:7px; padding:6px 13px; color:#9b978e; background:transparent; border:1px solid transparent; border-radius:3px; font-size:14px; }
  .beyond-view button[aria-pressed='true'] { color:#d6be80; border-color:rgba(201,162,39,.2); background:rgba(201,162,39,.05); }
  .beyond-surprise { display:inline-flex; align-items:center; justify-content:center; gap:6px; min-height:34px; padding:6px 2px; border:0; border-radius:2px; background:transparent; color:#bbaa84; font-size:13px; white-space:nowrap; }
  :global(html[lang='zh']) .beyond-surprise { font-family:'Crimson Pro','Zhuque Fangsong Explore',var(--font-cjk),serif; }
  .beyond-surprise:hover:not(:disabled) { color:#ead79e; }
  .beyond-surprise:focus-visible { outline:1px solid var(--color-brass); outline-offset:3px; }
  .beyond-surprise:disabled { opacity:.38; cursor:default; }
  .beyond-categories { display:flex; flex-wrap:wrap; gap:8px 22px; align-items:center; border-top:1px solid rgba(201,162,39,.12); padding:15px 12px 13px; }
  .beyond-categories button { display:flex; align-items:center; gap:7px; border:0; border-bottom:1px solid transparent; color:#99958d; background:transparent; padding:3px 1px 7px; font-size:15px; white-space:nowrap; transition:color .2s,border-color .2s; }
  .beyond-categories button :global(svg) { opacity:.5; }
  .beyond-categories button.is-active { border-color:var(--color-brass); color:#e1c579; }
  .beyond-categories button.is-active :global(svg) { opacity:1; }
  .beyond-categories button:hover { color:#ddd3be; }
  .beyond-breadcrumb { position:absolute; top:5px; left:12px; z-index:8; pointer-events:none; }
  .beyond-breadcrumb button { display:inline-flex; align-items:center; gap:4px; min-height:44px; padding:0 10px 0 5px; border:0; border-radius:3px; background:rgba(10,10,15,.88); color:#c8b174; font-size:13px; pointer-events:auto; }
  .beyond-breadcrumb button:hover:not(:disabled) { color:#ead79e; }
  .beyond-breadcrumb button:disabled { color:#666258; cursor:default; }
  .beyond-stage { position:relative; min-height:820px; height:calc(100svh - 319px); max-height:1000px; isolation:isolate; border-top:1px solid rgba(255,255,255,.045); }
  .beyond-atmosphere { position:absolute; inset:0; pointer-events:none; z-index:-1; background:radial-gradient(ellipse at 24% 40%,rgba(115,93,40,.05),transparent 43%),radial-gradient(ellipse at 73% 56%,rgba(99,112,128,.035),transparent 43%); }
  .beyond-graph { position:absolute; inset:0; overflow:hidden; touch-action:pan-y; cursor:grab; user-select:none; }
  .beyond-graph.is-dragging { cursor:grabbing; }
  .beyond-links { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
  .beyond-regions { position:absolute; inset:0; pointer-events:none; }
  .beyond-region-label { position:absolute; top:0; left:0; color:#bdb19a; font:400 14px/20px var(--font-display); letter-spacing:.11em; white-space:nowrap; text-shadow:0 2px 8px #08080d; pointer-events:none; }
  .beyond-node { position:absolute; left:0; top:0; display:flex; align-items:center; justify-content:center; width:max(44px,var(--node-size,52px)); height:max(44px,var(--node-size,52px)); min-height:44px; padding:0; background:transparent; border:0; color:var(--beyond-ink); user-select:none; will-change:transform; transition:opacity .4s; touch-action:none; }
  .beyond-node-art { position:relative; display:grid; place-items:center; flex:0 0 var(--node-size,52px); width:var(--node-size,52px); height:var(--node-size,52px); aspect-ratio:1; border-radius:50%; overflow:hidden; background:rgba(21,21,27,.9); border:1px solid rgba(186,163,104,.28); box-shadow:0 0 15px rgba(201,162,39,.04); transition:border-color .3s,box-shadow .3s; }
  .beyond-node-art img { width:100%; height:100%; object-fit:cover; opacity:.96; pointer-events:none; transition:opacity .3s; }
  .beyond-node--work[data-category='books'] .beyond-node-art img { object-position:50% 25%; }
  .beyond-node[data-node='studio-ghibli'] .beyond-node-art { background:#c9c3b5; }
  .beyond-node[data-node='studio-ghibli'] .beyond-node-art img { object-fit:contain; padding:5px; }
  .beyond-node:is([data-node='movies-indiana-jones-series'],[data-node='movies-terminator-series']) .beyond-node-art img { object-fit:contain; padding:4px; }
  .beyond-node--topic:not(.has-artwork) .beyond-node-art { width:20px; height:20px; background:rgba(201,162,39,.06); border-color:rgba(201,162,39,.4); }
  .beyond-node--topic:not(.has-artwork) .beyond-node-art :global(svg) { width:11px;height:11px;opacity:.8; }
  .beyond-node-label { position:absolute; display:block; font-size:14px; line-height:1.2; margin:0; width:125px; left:50%; top:50%; max-width:125px; text-wrap:balance; text-shadow:0 1px 8px #08080d,0 0 6px #08080d; opacity:0; pointer-events:none; transition:opacity .15s; }
  .beyond-node-subtitle { display:none; }
  .beyond-node-label small { display:block; margin-top:3px; color:#b8aa8d; font:10px/12px var(--font-body); letter-spacing:.04em; }
  .beyond-node:hover .beyond-node-label,.beyond-node:focus-visible .beyond-node-label,.beyond-node.is-selected .beyond-node-label { opacity:1; }
  .beyond-node:hover,.beyond-node:focus-visible,.beyond-node.is-selected { z-index:5; outline:none; }
  .beyond-node:hover .beyond-node-art,.beyond-node:focus-visible .beyond-node-art,.beyond-node.is-selected .beyond-node-art { border-color:#d3b666; box-shadow:0 0 24px rgba(201,162,39,.17); }
  .beyond-node:hover img,.beyond-node.is-selected img { opacity:1; }
  .beyond-node.is-muted { opacity:.12; }
  .beyond-node.is-muted:hover,.beyond-node.is-muted:focus-visible { opacity:1; }
  .beyond-node.is-neighbor { color:#e4d5b2; opacity:1; }
  .beyond-bottom { position:absolute; bottom:17px; left:18px; right:18px; display:flex; align-items:center; justify-content:flex-end; pointer-events:none; z-index:7; }
  .beyond-navigation { display:flex; align-items:center; gap:2px; pointer-events:auto; padding:4px; border:1px solid rgba(201,162,39,.15); border-radius:4px; background:rgba(10,10,15,.85); backdrop-filter:blur(8px); }
  .beyond-navigation button { width:34px; height:34px; display:grid; place-items:center; padding:0; border:0; background:transparent; border-radius:2px; color:var(--color-brass); }
  .beyond-navigation button:hover { background:rgba(201,162,39,.09); }
  .beyond-navigation button:disabled { cursor:default; opacity:.35; }
  .beyond-motion-pause,.beyond-motion-play { display:grid; place-items:center; }
  [data-beyond-motion][aria-pressed='true'] .beyond-motion-play,[data-beyond-motion][aria-pressed='false'] .beyond-motion-pause { display:none; }
  .beyond-control-divider { height:16px; width:1px; background:rgba(201,162,39,.18); margin:0 6px; }
  .beyond-index { padding:64px 20px 80px; }
  .beyond-stage:has(.beyond-index:not([hidden])) { height:auto; max-height:none; }
  .beyond-index-category { margin-bottom:35px; }
  .beyond-index-category h2 { font:400 20px var(--font-display); display:flex; align-items:center; gap:10px; color:#c8b681; padding-bottom:13px; border-bottom:1px solid rgba(201,162,39,.12); }
  .beyond-index-works { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:0 32px; }
  .beyond-index-item { display:flex; width:100%; align-items:center; gap:13px; text-align:left; border:0; border-bottom:1px solid rgba(255,255,255,.055); background:transparent; color:#d2cbbc; padding:16px 0; font-size:16px; }
  .beyond-index-item>span:nth-child(2) { flex:1; }
  .beyond-index-item> :global(svg) { opacity:0; transition:opacity .2s; }
  .beyond-index-item:hover> :global(svg) { opacity:1; }
  .beyond-index-item small { display:block; color:#969080; font-size:13px; }
  .beyond-index-cover { display:grid; place-items:center; width:38px; height:48px; flex:0 0 38px; }
  .beyond-index-cover img { width:100%; height:100%; object-fit:cover; border-radius:2px; }
  .beyond-index-item:is([data-index-node='movies-indiana-jones-series'],[data-index-node='movies-terminator-series']) .beyond-index-cover img { object-fit:contain; }
  .beyond-no-results { position:absolute; top:40%; left:0; right:0; text-align:center; color:#aaa294; }
  .beyond-detail { position:absolute; z-index:10; top:0; right:0; width:340px; bottom:0; overflow-y:auto; overscroll-behavior:contain; background:linear-gradient(100deg,rgba(13,13,19,.95),rgba(13,13,19,.99)); border-left:1px solid rgba(201,162,39,.18); scrollbar-width:thin; scrollbar-color:#5a4c2a transparent; box-shadow:-24px 0 50px rgba(0,0,0,.15); }
  .beyond-detail-close { display:grid; place-items:center; position:absolute; right:14px; top:14px; width:34px; height:34px; background:rgba(10,10,15,.85); border:1px solid rgba(201,162,39,.2); border-radius:50%; z-index:2; }
  .beyond-detail-image { width:100%; height:215px; background:rgba(201,162,39,.025); overflow:hidden; }
  .beyond-detail-image :global(img) { width:100%; height:100%; object-fit:contain; padding:20px; }
  .beyond-detail-image[hidden] { display:none; }
  .beyond-detail-copy { padding:23px 27px 32px; }
  .beyond-detail-category { color:#bfa568; font-size:11px; letter-spacing:.14em; text-transform:uppercase; font-family:var(--font-mono); }
  .beyond-detail h2 { font:400 30px/1.22 var(--font-editorial); color:#f0e6cf; margin:9px 0 8px; }
  .beyond-detail-subtitle { color:#a39780; font-size:15px; margin-bottom:12px; }
  .beyond-detail-description { color:#b1aca1; font-size:15px; line-height:1.65; margin:15px 0 22px; }
  .beyond-detail-links :global(h3) { font:400 12px var(--font-mono); letter-spacing:.08em; text-transform:uppercase; color:#9b8a62; margin-bottom:7px; }
  .beyond-detail-links :global(button) { width:100%; display:flex; gap:12px; align-items:center; padding:13px 0; background:transparent; text-align:left; border:0; border-bottom:1px solid rgba(201,162,39,.11); color:#d5c9b0; }
  .beyond-detail-links :global(img) { width:30px; height:38px; object-fit:cover; border-radius:2px; }
  .beyond-detail-links :global(button:is([data-related-node='movies-indiana-jones-series'],[data-related-node='movies-terminator-series']) img) { object-fit:contain; }
