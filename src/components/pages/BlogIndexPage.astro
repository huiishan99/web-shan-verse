---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultLocale, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import {
  type BlogIndexKind,
  blogPostsPerPage,
  getBlogIndexPagePath,
  getBlogCategoryPath,
  getBlogCardExcerpt,
  getBlogPostDisplayTitle,
  getBlogPageCount,
  getBlogPagePosts,
  getBlogPostKind,
  getBlogPosts,
  getBlogPostsForIndexKind,
  getBlogPostsForLocale,
  getBlogPostPath,
  getBlogTagPath,
  getInformativeBlogCategories,
  getInformativeBlogTags,
  sortBlogPosts,
} from '../../utils/blog';

interface Props {
  lang?: Locale;
  currentPage?: number;
  activeKind?: BlogIndexKind;
}

type PaginationItem =
  | { type: 'page'; page: number; href: string; isCurrent: boolean }
  | { type: 'gap'; key: string };

const { lang = defaultLocale, currentPage: requestedPage = 1, activeKind = 'all' } = Astro.props;
const t = useTranslations(lang);
const dateLocale: Record<Locale, string> = {
  en: 'en-US',
  zh: 'zh-CN',
  ja: 'ja-JP',
};

// 从 content collection 获取博客文章
const visiblePosts = getBlogPostsForLocale(await getBlogPosts(), lang);

// 按日期排序（最新在前）
const sortedPosts = sortBlogPosts(visiblePosts);
const filteredPosts = getBlogPostsForIndexKind(sortedPosts, activeKind);
const totalPages = getBlogPageCount(filteredPosts);
const currentPage = Math.min(Math.max(1, Math.floor(requestedPage)), totalPages);
const pagePosts = getBlogPagePosts(filteredPosts, currentPage, blogPostsPerPage);
const totalPostCount = filteredPosts.length;
const pageStart = totalPostCount === 0 ? 0 : (currentPage - 1) * blogPostsPerPage + 1;
const pageEnd = Math.min(currentPage * blogPostsPerPage, totalPostCount);
const allPostCount = sortedPosts.length;
const articleCount = sortedPosts.filter((post) => getBlogPostKind(post) === 'article').length;
const noteCount = sortedPosts.filter((post) => getBlogPostKind(post) === 'note').length;
const postKindFilters = [
  { kind: 'all', label: t.blog.allPosts, count: allPostCount },
  { kind: 'article', label: t.blog.articlesLabel, count: articleCount },
  { kind: 'note', label: t.blog.notesLabel, count: noteCount },
] as const;

// 收集所有分类和标签
const allCategories = [...new Set(visiblePosts.flatMap(post => getInformativeBlogCategories(post)))];
const allTags = [...new Set(visiblePosts.flatMap(post => getInformativeBlogTags(post)))];

// 格式化日期的辅助函数
function formatDate(date: Date) {
  return date.toLocaleDateString(dateLocale[lang], {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
}

function getCardExcerpt(post: (typeof sortedPosts)[number]) {
  return getBlogCardExcerpt(post, lang);
}

function getPaginationItems(): PaginationItem[] {
  const visiblePages = new Set(
    [1, totalPages, currentPage - 1, currentPage, currentPage + 1].filter(
      (page) => page >= 1 && page <= totalPages
    )
  );
  const orderedPages = [...visiblePages].sort((a, b) => a - b);

  return orderedPages.flatMap((page, index) => {
    const previousPage = orderedPages[index - 1];
    const items: PaginationItem[] = [];

    if (previousPage && page - previousPage > 1) {
      items.push({ type: 'gap', key: `${previousPage}-${page}` });
    }

    items.push({
      type: 'page',
      page,
      href: getBlogIndexPagePath(page, lang, activeKind),
      isCurrent: page === currentPage,
    });

    return items;
  });
}

const paginationItems = getPaginationItems();
const paginationSummary = t.blog.paginationSummary
  .replace('{current}', String(currentPage))
  .replace('{total}', String(totalPages));
const paginationRange = t.blog.paginationRange
  .replace('{start}', String(pageStart))
  .replace('{end}', String(pageEnd))
  .replace('{total}', String(totalPostCount));
const pageTitle = currentPage === 1 ? t.blog.title : `${t.blog.title} ${paginationSummary}`;
const previousPagePath = currentPage > 1
  ? getBlogIndexPagePath(currentPage - 1, lang, activeKind)
  : undefined;
const nextPagePath = currentPage < totalPages
  ? getBlogIndexPagePath(currentPage + 1, lang, activeKind)
  : undefined;
const topPaginationLabel = `${t.blog.paginationLabel} (${t.blog.paginationTop})`;
const bottomPaginationLabel = `${t.blog.paginationLabel} (${t.blog.paginationBottom})`;
---

<BaseLayout title={pageTitle} lang={lang}>
  <div class="container">
    <header class="page-header">
      <h1>{t.blog.title}</h1>
      <p class="subtitle">{t.blog.subtitle}</p>
      <div class="kind-filters" aria-label={t.blog.title}>
        {postKindFilters.map((filter) => (
          <a
            href={getBlogIndexPagePath(1, lang, filter.kind)}
            class:list={['kind-filter', { 'is-active': filter.kind === activeKind }]}
            data-kind-filter={filter.kind}
            data-astro-reload
            aria-current={filter.kind === activeKind ? 'page' : undefined}
          >
            <span>{filter.label}</span>
            <span class="kind-count">{filter.count}</span>
          </a>
        ))}
      </div>
      {totalPostCount > 0 && (
        <p class="page-range">{paginationRange}</p>
      )}
      {totalPages > 1 && (
        <nav class="pagination pagination--top" aria-label={topPaginationLabel}>
          <p class="pagination-summary">{paginationSummary}</p>
          <div class="pagination-controls">
            {previousPagePath ? (
              <a href={previousPagePath} class="pagination-link pagination-step" rel="prev">
                <span aria-hidden="true">←</span>
                <span>{t.blog.paginationPrevious}</span>
              </a>
            ) : (
              <span class="pagination-link pagination-step is-disabled" aria-disabled="true">
                <span aria-hidden="true">←</span>
                <span>{t.blog.paginationPrevious}</span>
              </span>
            )}

            {paginationItems.map((item) => (
              item.type === 'gap' ? (
                <span class="pagination-gap" aria-hidden="true">...</span>
              ) : (
                <a
                  href={item.href}
                  class:list={['pagination-link', 'pagination-number', { 'is-active': item.isCurrent }]}
                  aria-label={
                    item.isCurrent
                      ? `${t.blog.paginationCurrentPage}: ${item.page}`
                      : `${t.blog.paginationPage} ${item.page}`
                  }
                  aria-current={item.isCurrent ? 'page' : undefined}
                >
                  {item.page}
                </a>
              )
            ))}

            {nextPagePath ? (
              <a href={nextPagePath} class="pagination-link pagination-step" rel="next">
                <span>{t.blog.paginationNext}</span>
                <span aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="pagination-link pagination-step is-disabled" aria-disabled="true">
                <span>{t.blog.paginationNext}</span>
                <span aria-hidden="true">→</span>
              </span>
            )}
          </div>
        </nav>
      )}
    </header>
    
    <div class="blog-layout">
      <main class="posts-list">
        {pagePosts.map((post) => {
          const postKind = getBlogPostKind(post);
          const cardExcerpt = getCardExcerpt(post);
          const cardCategory = getInformativeBlogCategories(post)[0];
          const cardTags = getInformativeBlogTags(post);
          const visibleCardTags = cardTags.slice(0, 3);
          const hiddenTagCount = cardTags.length - visibleCardTags.length;
          const showCardTitle = postKind === 'article';

          return (
            <article
              class:list={['post-card', `post-card--${postKind}`]}
              data-href={getBlogPostPath(post, lang)}
              data-kind={postKind}
            >
              <div class="post-meta">
                <time class="post-date" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                {cardCategory && (
                  <a href={getBlogCategoryPath(cardCategory, lang)}
                     class="post-category">
                    {cardCategory}
                  </a>
                )}
                {post.data.draft && (
                  <span class="draft-badge">{t.blog.draft}</span>
                )}
                {post.data.deprecated && (
                  <span class="deprecated-badge">{t.blog.deprecated}</span>
                )}
              </div>
              {showCardTitle && (
                <h2 class="post-title">{getBlogPostDisplayTitle(post, lang)}</h2>
              )}
              {cardExcerpt && (
                <p class="post-excerpt">{cardExcerpt}</p>
              )}
              {visibleCardTags.length > 0 && (
                <div class="post-tags">
                  {visibleCardTags.map((tag: string) => (
                    <a href={getBlogTagPath(tag, lang)}
                       class="tag-in-card">
                      #{tag}
                    </a>
                  ))}
                  {hiddenTagCount > 0 && (
                    <span class="tag-more">+{hiddenTagCount}</span>
                  )}
                </div>
              )}
            </article>
          );
        })}
        
        {pagePosts.length === 0 && (
          <p class="no-posts">{t.blog.noPosts}</p>
        )}
        {pagePosts.length > 0 && (
          <p class="no-posts no-posts--filtered" data-kind-empty hidden>{t.blog.noPostsForKind}</p>
        )}
        {totalPages > 1 && (
          <nav class="pagination" aria-label={bottomPaginationLabel}>
            <p class="pagination-summary">{paginationSummary}</p>
            <div class="pagination-controls">
              {previousPagePath ? (
                <a href={previousPagePath} class="pagination-link pagination-step" rel="prev">
                  <span aria-hidden="true">←</span>
                  <span>{t.blog.paginationPrevious}</span>
                </a>
              ) : (
                <span class="pagination-link pagination-step is-disabled" aria-disabled="true">
                  <span aria-hidden="true">←</span>
                  <span>{t.blog.paginationPrevious}</span>
                </span>
              )}

              {paginationItems.map((item) => (
                item.type === 'gap' ? (
                  <span class="pagination-gap" aria-hidden="true">...</span>
                ) : (
                  <a
                    href={item.href}
                    class:list={['pagination-link', 'pagination-number', { 'is-active': item.isCurrent }]}
                    aria-label={
                      item.isCurrent
                        ? `${t.blog.paginationCurrentPage}: ${item.page}`
                        : `${t.blog.paginationPage} ${item.page}`
                    }
                    aria-current={item.isCurrent ? 'page' : undefined}
                  >
                    {item.page}
                  </a>
                )
              ))}

              {nextPagePath ? (
                <a href={nextPagePath} class="pagination-link pagination-step" rel="next">
                  <span>{t.blog.paginationNext}</span>
                  <span aria-hidden="true">→</span>
                </a>
              ) : (
                <span class="pagination-link pagination-step is-disabled" aria-disabled="true">
                  <span>{t.blog.paginationNext}</span>
                  <span aria-hidden="true">→</span>
                </span>
              )}
            </div>
          </nav>
        )}
      </main>
      
      <aside class="blog-sidebar">
        <div class="sidebar-section gear-border">
          <h3>{t.blog.categories}</h3>
          <ul class="category-list">
            {allCategories.map((category) => (
              <li>
                <a href={getBlogCategoryPath(category, lang)} class="category-link">
                  {category}
                </a>
              </li>
            ))}
          </ul>
        </div>
        
        <div class="sidebar-section gear-border">
          <h3>{t.blog.tags}</h3>
          <div class="tag-cloud">
            {allTags.map((tag) => (
              <a href={getBlogTagPath(tag, lang)} class="tag-link">
                #{tag}
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import { navigate } from 'astro:transitions/client';

  // 让整个卡片可点击，但标签链接可以独立点击
  function setupPostCards() {
    document.querySelectorAll<HTMLElement>('.post-card[data-href]').forEach((card) => {
      if (card.dataset.clickReady === 'true') return;
      card.dataset.clickReady = 'true';

      card.addEventListener('click', (event) => {
        const target = event.target;
        // 如果点击的是链接，让链接自己处理
        if (target instanceof Element && target.closest('a')) return;
        // 否则跳转到文章
        const href = card.getAttribute('data-href');
        if (href) navigate(href);
      });
    });
  }

  setupPostCards();
  document.addEventListener('astro:page-load', setupPostCards);
</script>

<style>
  .page-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  
  .subtitle {
    color: var(--color-text-secondary);
    font-style: italic;
    margin-top: var(--space-sm);
  }

  .kind-filters {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: var(--space-lg);
    padding: 0.25rem;
    border: 1px solid var(--surface-border);
    border-radius: 6px;
    background: rgba(10, 10, 15, 0.52);
    box-shadow: var(--surface-shadow);
    backdrop-filter: blur(var(--surface-blur));
    -webkit-backdrop-filter: blur(var(--surface-blur));
  }

  .kind-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.35rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 4px;
    background: transparent;
    color: var(--color-text-secondary);
    font-family: var(--font-body);
    font-size: 0.98rem;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .kind-filter:hover,
  .kind-filter.is-active {
    color: var(--color-accent-gold);
    border-color: rgba(201, 162, 39, 0.32);
    background: rgba(201, 162, 39, 0.1);
  }

  .kind-count {
    min-width: 1.5rem;
    padding: 0 0.35rem;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.055);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .kind-filter.is-active .kind-count {
    color: var(--color-accent-gold);
    background: rgba(201, 162, 39, 0.14);
  }

  .page-range {
    margin-top: var(--space-md);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }
  
  .blog-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-xl);
    align-items: start;
  }
  
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  
  .post-card {
    background: var(--surface-glass);
    border: 1px solid var(--surface-border);
    border-radius: var(--surface-radius);
    padding: var(--space-lg);
    transition: all 0.3s ease;
    box-shadow: var(--surface-shadow);
    backdrop-filter: blur(var(--surface-blur));
    -webkit-backdrop-filter: blur(var(--surface-blur));
    cursor: pointer;
  }
  
  .post-card:hover {
    background: var(--surface-glass-hover);
    border-color: var(--surface-border-hover);
    box-shadow: var(--surface-shadow-hover);
    transform: translateY(-2px);
  }

  .post-card--note {
    background:
      linear-gradient(180deg, rgba(30, 28, 35, 0.68), rgba(12, 12, 18, 0.46)),
      rgba(14, 14, 20, 0.48);
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }
  
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .post-category {
    font-size: 0.85rem;
    color: var(--color-brass);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  
  .post-category:hover {
    color: var(--color-accent-gold);
  }
  
  .draft-badge {
    background: rgba(255, 100, 100, 0.2);
    color: #ff9999;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .deprecated-badge {
    background: rgba(255, 160, 60, 0.2);
    color: #ffa03c;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .post-title {
    font-size: 1.35rem;
    font-family: var(--font-body);
    font-weight: 600;
    margin-bottom: var(--space-sm);
    color: var(--color-text-primary);
    transition: color 0.2s ease;
  }
  
  .post-card:hover .post-title {
    color: var(--color-accent-gold);
  }

  .post-excerpt {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  .post-card--note .post-excerpt {
    color: rgba(245, 245, 245, 0.84);
    font-size: 1.08rem;
    line-height: 1.85;
    margin-top: 0.1rem;
  }
  
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  
  .post-tags .tag {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  
  .tag-in-card {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.15rem 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.025);
    transition: all 0.2s ease;
  }
  
  .tag-in-card:hover {
    color: var(--color-accent-gold);
    border-color: var(--color-accent-gold);
    background: rgba(201, 162, 39, 0.1);
  }

  .tag-more {
    align-self: center;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  
  .no-posts {
    color: var(--color-text-muted);
    text-align: center;
    padding: var(--space-xl);
    font-style: italic;
  }

  .no-posts[hidden] {
    display: none;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    padding-top: var(--space-md);
  }

  .pagination--top {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 42rem;
    margin: var(--space-md) auto 0;
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    gap: 0.6rem;
  }

  .pagination--top .pagination-summary {
    font-size: 0.78rem;
    text-align: center;
  }

  .pagination--top .pagination-controls {
    justify-content: center;
  }

  .pagination--top .pagination-link,
  .pagination--top .pagination-gap {
    min-width: 2.1rem;
    min-height: 2.1rem;
    font-size: 0.78rem;
  }

  .pagination--top .pagination-step {
    min-width: 4.25rem;
    padding: 0 0.58rem;
  }

  .pagination-summary {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.86rem;
  }

  .pagination-controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .pagination-link,
  .pagination-gap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.35rem;
    min-height: 2.35rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .pagination-link {
    gap: 0.35rem;
    border: 1px solid var(--surface-border);
    background: rgba(10, 10, 15, 0.48);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .pagination-link:hover,
  .pagination-link.is-active {
    color: var(--color-accent-gold);
    border-color: rgba(201, 162, 39, 0.38);
    background: rgba(201, 162, 39, 0.1);
  }

  .pagination-link.is-active {
    cursor: default;
  }

  .pagination-link.is-disabled {
    color: var(--color-text-muted);
    opacity: 0.45;
    pointer-events: none;
  }

  .pagination-step {
    min-width: 4.85rem;
    padding: 0 0.7rem;
  }

  .pagination-gap {
    color: var(--color-text-muted);
  }
  
  /* Sidebar */
  .blog-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    position: sticky;
    top: 100px;
  }
  
  .sidebar-section {
    padding: var(--space-md);
  }
  
  .sidebar-section h3 {
    font-size: 1rem;
    color: var(--color-brass);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-md);
  }
  
  .category-list {
    list-style: none;
  }
  
  .category-list li {
    margin-bottom: var(--space-xs);
  }
  
  .category-link {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  
  .category-link:hover {
    color: var(--color-accent-gold);
  }
  
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  
  .tag-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.2rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.03);
    transition: all 0.2s ease;
  }
  
  .tag-link:hover {
    border-color: var(--color-accent-gold);
    color: var(--color-accent-gold);
    background: rgba(201, 162, 39, 0.1);
  }
  
  @media (max-width: 900px) {
    .blog-layout {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .posts-list {
      gap: var(--space-md);
    }
    
    .blog-sidebar {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
    }
    
    .sidebar-section {
      flex: 1;
      min-width: 200px;
    }
  }

  @media (max-width: 600px) {
    .container > .page-header {
      margin-bottom: var(--space-lg);
    }

    .container > .page-header .subtitle {
      margin-top: 0.4rem;
      font-size: 0.92rem;
      line-height: 1.45;
    }

    .container > .page-header .kind-filters {
      display: flex;
      width: 100%;
      margin-top: 0.85rem;
      padding: 0.18rem;
      overflow-x: auto;
      border-radius: 5px;
    }

    .container > .page-header .kind-filter {
