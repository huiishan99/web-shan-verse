---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultLocale, localizePath, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import {
  getBlogCategoryPath,
  getBlogPostDisplayTitle,
  getBlogPostMetaDescription,
  getBlogPostKind,
  getBlogTagPath,
  getInformativeBlogCategories,
  getInformativeBlogTags,
} from '../../utils/blog';

type Props = {
  post: CollectionEntry<'blog'>;
  lang?: Locale;
  alternateLocales?: readonly Locale[];
};

const { post, lang = defaultLocale, alternateLocales } = Astro.props;
const { Content } = await render(post);
const t = useTranslations(lang);
const postKind = getBlogPostKind(post);
const displayTitle = getBlogPostDisplayTitle(post, lang);
const showPostTitle = postKind === 'article';
const metaDescription = getBlogPostMetaDescription(post);
const postCategories = getInformativeBlogCategories(post);
const postTags = getInformativeBlogTags(post);
const dateLocale: Record<Locale, string> = {
  en: 'en-US',
  zh: 'zh-CN',
  ja: 'ja-JP',
};

const formattedDate = post.data.date.toLocaleDateString(dateLocale[lang], {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={displayTitle}
  description={metaDescription}
  lang={lang}
  alternateLocales={alternateLocales}
>
  <article class:list={['blog-post', `blog-post--${postKind}`]}>
    <header class="post-header">
      <h1 class:list={{ 'visually-hidden': !showPostTitle }}>{displayTitle}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        {postCategories.length > 0 && (
          <span class="categories">
            {postCategories.map((cat: string) => (
              <a href={getBlogCategoryPath(cat, lang)} class="category">
                {cat}
              </a>
            ))}
          </span>
        )}
      </div>
      {postTags.length > 0 && (
        <div class="tags">
          {postTags.map((tag: string) => (
            <a href={getBlogTagPath(tag, lang)} class="tag">
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    {post.data.deprecated && (
      <div class="deprecated-notice">
        <span class="deprecated-icon">⚠️</span>
        <div class="deprecated-content">
          <strong>{t.blog.deprecated}</strong>
          <p>{post.data.deprecatedReason || 'This article is outdated and may no longer be accurate or relevant.'}</p>
        </div>
      </div>
    )}

    {post.data.image && (
      <div class="featured-image">
        <img src={post.data.image} alt={displayTitle} />
      </div>
    )}

    <div class="post-content">
      <Content />
    </div>

    <footer class="post-footer">
      <a href={localizePath('/blog', lang)} class="back-link">← {t.blog.backToBlog}</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .blog-post {
    max-width: 880px;
    margin: 0 auto;
    padding: 2.5rem 3rem;
    background: rgba(13, 13, 18, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 8px;
    margin-top: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .blog-post--note {
    max-width: 700px;
    padding: 2.75rem 3.25rem;
    background:
      linear-gradient(180deg, rgba(22, 22, 30, 0.78), rgba(11, 11, 17, 0.68)),
      rgba(13, 13, 18, 0.72);
    border: 1px solid rgba(106, 171, 255, 0.1);
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.26), 0 0 28px rgba(106, 171, 255, 0.045);
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .blog-post--note .post-header {
    position: relative;
    margin-bottom: 2.35rem;
    padding-bottom: 1.75rem;
    text-align: center;
    border-bottom: 0;
  }

  .blog-post--note .post-header::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 5rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(106, 171, 255, 0.5), transparent);
    transform: translateX(-50%);
  }

  .deprecated-notice {
    display: flex;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: rgba(255, 160, 60, 0.1);
    border: 1px solid rgba(255, 160, 60, 0.3);
    border-left: 4px solid #ffa03c;
    border-radius: 6px;
    margin-bottom: 2rem;
  }

  .deprecated-icon {
    font-size: 1.5rem;
    line-height: 1;
    filter: grayscale(100%) sepia(100%) saturate(300%) hue-rotate(5deg) brightness(1.1);
  }

  .deprecated-content {
    flex: 1;
  }

  .deprecated-content strong {
    color: #ffa03c;
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.05em;
  }

  .deprecated-content p {
    margin: 0.25rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .post-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .blog-post--note .post-meta {
    justify-content: center;
  }

  .post-meta time {
    color: var(--color-accent-gold);
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .category {
    background: rgba(201, 162, 39, 0.15);
    color: var(--color-accent-gold);
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    font-size: 0.85rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .category:hover {
    background: rgba(201, 162, 39, 0.3);
    color: var(--color-accent-copper);
  }

  .tags {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .blog-post--note .tags {
    justify-content: center;
    opacity: 0.82;
  }

  .tag {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-family: var(--font-mono);
    text-decoration: none;
    padding: 0.2rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 3px;
    transition: all 0.2s ease;
  }

  .tag:hover {
    color: var(--color-accent-gold);
    border-color: var(--color-accent-gold);
    background: rgba(201, 162, 39, 0.1);
  }

  .featured-image {
    margin-bottom: 2rem;
    border-radius: 8px;
    overflow: hidden;
  }

  .featured-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .post-content {
    line-height: 1.8;
  }

  .blog-post--note .post-content {
    font-size: 1.16rem;
    line-height: 1.95;
  }

  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-family: var(--font-display);
  }

  .blog-post--note .post-content :global(h2),
  .blog-post--note .post-content :global(h3),
  .blog-post--note .post-content :global(h4) {
    border-bottom: 0;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0;
  }

  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .blog-post--note .post-content :global(p) {
    margin-bottom: 1.55rem;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .post-content :global(.blog-figure) {
    margin: 2rem auto;
    text-align: center;
  }

  .post-content :global(.blog-figure img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
    border: 1px solid var(--color-border);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.2);
  }

  .post-content :global(.blog-figure figcaption) {
    margin-top: 0.65rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    font-style: italic;
  }

  .post-content :global(.blog-figure--small) {
    max-width: 520px;
  }

  .post-content :global(.blog-figure--normal) {
    max-width: 720px;
  }

  .post-content :global(.blog-figure--wide) {
    width: calc(100% + 3rem);
    max-width: calc(100% + 3rem);
    margin-left: -1.5rem;
    margin-right: -1.5rem;
  }

  .post-content :global(.blog-figure--full) {
    width: calc(100% + 6rem);
    max-width: calc(100% + 6rem);
    margin-left: -3rem;
    margin-right: -3rem;
  }

  .post-content :global(a) {
    color: var(--color-accent-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-content :global(a:hover) {
    color: var(--color-accent-copper);
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--color-accent-gold);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .blog-post--note .post-content :global(blockquote) {
    max-width: 34rem;
    margin: 2.25rem auto;
    padding: 0;
    border-left: 0;
    color: rgba(245, 245, 245, 0.78);
    text-align: center;
  }

  .post-content :global(code) {
    font-family: var(--font-mono);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .post-content :global(pre) {
    background: var(--color-bg-card);
    padding: 1rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .post-content :global(.blog-table-scroll) {
    width: 100%;
    margin: 1.75rem 0 2rem;
    overflow-x: auto;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(106, 171, 255, 0.045), rgba(201, 162, 39, 0.025)),
      rgba(12, 12, 18, 0.74);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.2);
  }

  .post-content :global(.blog-table-scroll::-webkit-scrollbar) {
    height: 0.65rem;
  }

  .post-content :global(.blog-table-scroll::-webkit-scrollbar-track) {
    background: rgba(255, 255, 255, 0.035);
  }

  .post-content :global(.blog-table-scroll::-webkit-scrollbar-thumb) {
    background: rgba(201, 162, 39, 0.42);
    border-radius: 999px;
  }

  .post-content :global(table) {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .post-content :global(th),
  .post-content :global(td) {
    min-width: 9rem;
    padding: 0.8rem 0.95rem;
    vertical-align: top;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .post-content :global(th:last-child),
  .post-content :global(td:last-child) {
    border-right: 0;
  }

  .post-content :global(thead th) {
    color: var(--color-text-primary);
    background:
      linear-gradient(180deg, rgba(201, 162, 39, 0.16), rgba(106, 171, 255, 0.08)),
      rgba(22, 22, 30, 0.96);
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-align: left;
    white-space: nowrap;
  }

  .post-content :global(tbody tr:nth-child(even)) {
    background: rgba(255, 255, 255, 0.025);
  }

  .post-content :global(tbody tr:hover) {
    background: rgba(106, 171, 255, 0.055);
  }

  .post-content :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  .post-content :global(th:first-child),
  .post-content :global(td:first-child) {
    min-width: 8.5rem;
  }

  .post-content :global(th:last-child),
  .post-content :global(td:last-child) {
    min-width: 15rem;
  }

  .post-content :global(td:first-child) {
    color: var(--color-accent-gold);
    font-weight: 600;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    color: var(--color-accent-gold);
    text-decoration: none;
    font-family: var(--font-display);
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-accent-copper);
  }

  @media (max-width: 768px) {
    .blog-post {
      padding: 1.5rem 1.25rem;
      margin-top: 0.75rem;
      margin-bottom: 1.5rem;
      border-radius: 0;
    }

    .blog-post--note {
      padding: 2rem 1.35rem;
    }

    .post-header h1 {
      font-size: 1.75rem;
      line-height: 1.3;
    }

    .post-meta {
      font-size: 0.9rem;
      gap: 0.5rem;
    }

    .post-content {
      font-size: 1rem;
      line-height: 1.75;
    }

    .post-content :global(h2) {
      font-size: 1.4rem;
    }

    .post-content :global(h3) {
      font-size: 1.2rem;
    }

    .post-content :global(pre) {
      padding: 0.75rem;
      font-size: 0.85rem;
      margin-left: -0.5rem;
      margin-right: -0.5rem;
      border-radius: 0;
    }

    .post-content :global(.blog-table-scroll) {
      width: calc(100% + 1rem);
      max-width: calc(100% + 1rem);
      margin: 1.5rem -0.5rem;
      border-radius: 0;
    }

    .post-content :global(table) {
      min-width: 720px;
      font-size: 0.86rem;
    }

    .post-content :global(th),
    .post-content :global(td) {
      padding: 0.68rem 0.75rem;
    }

    .post-content :global(img) {
      margin: 1rem -0.5rem;
      max-width: calc(100% + 1rem);
      border-radius: 0;
    }

    .post-content :global(.blog-figure),
    .post-content :global(.blog-figure--small),
    .post-content :global(.blog-figure--normal),
    .post-content :global(.blog-figure--wide),
    .post-content :global(.blog-figure--full) {
      width: calc(100% + 1rem);
      max-width: calc(100% + 1rem);
      margin: 1.5rem -0.5rem;
    }

    .post-content :global(.blog-figure img) {
      border-radius: 0;
    }

    .post-content :global(.blog-figure figcaption) {
      padding: 0 0.5rem;
      font-size: 0.85rem;
    }

    .tags {
      gap: 0.4rem;
    }

    .tag {
      font-size: 0.8rem;
      padding: 0.15rem 0.4rem;
    }
  }
</style>
