---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { timelineData } from '../../data/timeline';
import { defaultLocale, localizeMonth, localizeString, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout title={t.timeline.title} lang={lang}>
  <div class="container">
    <header class="page-header">
      <h1>{t.timeline.title}</h1>
      <p class="subtitle">{t.timeline.subtitle}</p>
    </header>
    
    <div class="timeline">
      {timelineData.map((yearData) => (
        <div class="timeline-year">
          <div class="year-marker">
            <span class="year-label">{yearData.year}</span>
          </div>
          <div class="year-events">
            {yearData.events.map((event) => (
              <div class="timeline-event">
                <div class="event-dot"></div>
                <div class="event-content card">
                  <span class="event-month">{localizeMonth(event.month, lang)}</span>
                  <h3 class="event-title">{localizeString(event.title, lang)}</h3>
                  <p class="event-desc">{localizeString(event.description, lang)}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    
    <div class="timeline-end">
      <div class="end-dot"></div>
      <span>{t.timeline.end}</span>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  
  .subtitle {
    color: var(--color-text-secondary);
    font-style: italic;
    margin-top: var(--space-sm);
  }
  
  .timeline {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
  }
  
  .timeline-year {
    margin-bottom: var(--space-xl);
    position: relative;
    padding-left: 20px;
  }
  
  /* 竖线 - 只在年份内部的事件区域，上粗下细 */
  .year-events::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(
      180deg,
      var(--color-brass) 0%,
      var(--color-brass-dark) 100%
    );
    clip-path: polygon(0 0, 100% 0, 75% 100%, 25% 100%);
  }
  
  .year-marker {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    position: relative;
  }
  
  /* 年份大圆点 */
  .year-marker::before {
    content: '';
    width: 20px;
    height: 20px;
    background: var(--color-bg-primary);
    border: 3px solid var(--color-brass);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--color-brass-dark);
    flex-shrink: 0;
    z-index: 2;
  }
  
  .year-label {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--color-brass);
    letter-spacing: 0.1em;
  }
  
  .year-marker::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--color-brass-dark), transparent);
  }
  
  .year-events {
    padding-left: 40px;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    position: relative;
    margin-left: 9px;
  }
  
  .timeline-event {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
  }
  
  /* 月份横杠 - 穿过竖线，左粗右细 */
  .event-dot {
    position: absolute;
    left: -32px;
    top: 1rem;
    width: 18px;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-brass) 0%,
      var(--color-brass-dark) 100%
    );
    clip-path: polygon(0 0, 100% 30%, 100% 70%, 0 100%);
    z-index: 1;
    transition: all 0.3s ease;
  }
  
  .timeline-event:hover .event-dot {
    background: linear-gradient(
      90deg,
      var(--color-brass-light) 0%,
      var(--color-brass) 100%
    );
    box-shadow: 0 0 8px var(--color-brass);
  }
  
  .event-content {
    padding: var(--space-md) var(--space-lg);
    flex: 1;
  }
  
  .event-month {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  
  .event-title {
    font-size: 1.2rem;
    font-family: var(--font-body);
    font-weight: 600;
    margin: var(--space-xs) 0 var(--space-sm);
    color: var(--color-text-primary);
  }
  
  .event-desc {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.7;
  }
  
  .timeline-end {
    text-align: center;
    padding: var(--space-xl) 0;
    color: var(--color-brass-dark);
    font-style: italic;
    position: relative;
  }
  
  .end-dot {
    width: 12px;
    height: 12px;
    background: var(--color-brass-dark);
    border: 2px solid var(--color-brass);
    border-radius: 50%;
    margin: 0 auto var(--space-md);
    animation: pulse 2s ease-in-out infinite;
  }
  
  @keyframes pulse {
    0%, 100% {
      box-shadow: 0 0 5px var(--color-brass-dark);
    }
    50% {
      box-shadow: 0 0 15px var(--color-brass);
    }
  }
  
  @media (max-width: 768px) {
    .timeline-year {
      padding-left: 15px;
    }
    
    .year-events::before {
      left: 6px;
      width: 2px;
    }
    
    .year-marker::before {
      width: 16px;
      height: 16px;
      border-width: 2px;
    }
    
    .year-events {
      padding-left: 30px;
      margin-left: 7px;
    }
    
    .event-dot {
      left: -24px;
      width: 12px;
      height: 2px;
    }
    
    .year-label {
      font-size: 1.5rem;
    }
    
    .event-content {
      padding: var(--space-md);
    }
  }
</style>
