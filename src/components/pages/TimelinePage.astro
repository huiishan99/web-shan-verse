---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  timelineData,
  type TimelineEvent,
  type TimelineEventCategory,
  type TimelineEventWeight,
} from '../../data/timeline';
import { defaultLocale, localizeMonth, localizeString, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const dateLocale: Record<Locale, string> = {
  en: 'en-US',
  zh: 'zh-CN',
  ja: 'ja-JP',
};

const weightLabels: Record<TimelineEventWeight, { en: string; zh: string; ja: string }> = {
  major: { en: 'Major', zh: '重要', ja: '重要' },
  standard: { en: 'Signal', zh: '记录', ja: '記録' },
  note: { en: 'Note', zh: '日常', ja: 'メモ' },
};

const categoryLabels: Record<TimelineEventCategory, { en: string; zh: string; ja: string }> = {
  research: { en: 'Research', zh: '研究', ja: '研究' },
  career: { en: 'Career', zh: '职业', ja: 'キャリア' },
  education: { en: 'Education', zh: '教育', ja: '教育' },
  life: { en: 'Life', zh: '生活', ja: '生活' },
  travel: { en: 'Travel', zh: '旅行', ja: '旅' },
  project: { en: 'Project', zh: '项目', ja: 'プロジェクト' },
  award: { en: 'Award', zh: '奖项', ja: '受賞' },
};

const weightRank: Record<TimelineEventWeight, number> = {
  major: 0,
  standard: 1,
  note: 2,
};

type TimelineMonthGroup = {
  key: string;
  label: string;
  events: TimelineEvent[];
};

function getEventWeight(event: TimelineEvent): TimelineEventWeight {
  return event.weight ?? 'standard';
}

function getEventCategory(event: TimelineEvent): TimelineEventCategory {
  return event.category ?? 'life';
}

function getMonthGroups(events: TimelineEvent[]): TimelineMonthGroup[] {
  return events.reduce<TimelineMonthGroup[]>((groups, event) => {
    const key = localizeString(event.month, 'en');
    const previousGroup = groups[groups.length - 1];

    if (previousGroup?.key === key) {
      previousGroup.events.push(event);
      return groups;
    }

    groups.push({
      key,
      label: localizeMonth(event.month, lang),
      events: [event],
    });

    return groups;
  }, []);
}

function getDominantWeight(events: TimelineEvent[]): TimelineEventWeight {
  if (events.some((event) => getEventWeight(event) === 'major')) return 'major';
  if (events.some((event) => getEventWeight(event) === 'standard')) return 'standard';
  return 'note';
}

function getMonthSummary(events: TimelineEvent[]): string {
  const summaryParts = (['major', 'standard', 'note'] as TimelineEventWeight[])
    .map((weight) => {
      const count = events.filter((event) => getEventWeight(event) === weight).length;
      return count > 0 ? `${count} ${localizeString(weightLabels[weight], lang)}` : '';
    })
    .filter(Boolean);

  return summaryParts.join(' / ');
}

function getSortedEvents(events: TimelineEvent[]): TimelineEvent[] {
  return [...events].sort((firstEvent, secondEvent) => {
    const rankDifference = weightRank[getEventWeight(firstEvent)] - weightRank[getEventWeight(secondEvent)];
    if (rankDifference !== 0) return rankDifference;

    if (firstEvent.date && secondEvent.date) {
      return secondEvent.date.localeCompare(firstEvent.date);
    }

    if (firstEvent.date) return -1;
    if (secondEvent.date) return 1;

    return 0;
  });
}

function formatEventDate(event: TimelineEvent): string | undefined {
  if (!event.date || event.datePrecision === 'month') return undefined;

  return new Date(`${event.date}T00:00:00Z`).toLocaleDateString(dateLocale[lang], {
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<BaseLayout title={t.timeline.title} lang={lang}>
  <div class="container">
    <header class="page-header">
      <h1>{t.timeline.title}</h1>
      <p class="subtitle">{t.timeline.subtitle}</p>
    </header>

    <div class="timeline">
      {timelineData.map((yearData) => (
        <section class="timeline-year" aria-labelledby={`year-${yearData.year}`}>
          <div class="year-marker">
            <span class="year-signal" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <path d="M7.027 11.477a5 5 0 1 0 5.496 -4.45a4.951 4.951 0 0 0 -3.088 .681"></path>
                <path d="M5.636 5.636a9 9 0 1 0 3.555 -2.188"></path>
                <path d="M17 5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path>
                <path d="M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path>
                <path d="M8 16a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path>
              </svg>
            </span>
            <h2 id={`year-${yearData.year}`} class="year-label">{yearData.year}</h2>
          </div>

          <div class="year-months">
            {getMonthGroups(yearData.events).map((monthGroup) => {
              const dominantWeight = getDominantWeight(monthGroup.events);

              return (
                <article class={`month-cluster month-cluster--${dominantWeight}`}>
                  <div class="month-rail" aria-hidden="true">
                    <span class="month-pin"></span>
                  </div>

                  <div class="month-shell">
                    <header class="month-header">
                      <div>
                        <span class="month-label">{monthGroup.label}</span>
                        <span class="month-summary">{getMonthSummary(monthGroup.events)}</span>
                      </div>
                    </header>

                    <div class="month-events">
                      {getSortedEvents(monthGroup.events).map((event) => {
                        const weight = getEventWeight(event);
                        const category = getEventCategory(event);
                        const eventDate = formatEventDate(event);

                        return (
                          <section class={`timeline-event timeline-event--${weight} timeline-event--${category}`}>
                            <div class="event-body">
                              <div class="event-meta">
                                {eventDate && (
                                  <time class="event-date" datetime={event.date}>{eventDate}</time>
                                )}
                                <span class="event-category">{localizeString(categoryLabels[category], lang)}</span>
                              </div>
                              <h3 class="event-title">{localizeString(event.title, lang)}</h3>
                              <p class="event-desc">{localizeString(event.description, lang)}</p>
                            </div>
                          </section>
                        );
                      })}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>

    <div class="timeline-end">
      <div class="end-dot"></div>
      <span>{t.timeline.end}</span>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .subtitle {
    color: var(--color-text-secondary);
    font-style: italic;
    margin-top: var(--space-sm);
  }

  .timeline {
    max-width: 980px;
    margin: 0 auto;
  }

  .timeline-year {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--space-lg);
    position: relative;
    margin-bottom: var(--space-xl);
  }

  .year-marker {
    position: sticky;
    top: 6rem;
    align-self: start;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.55rem;
    padding-top: 0.15rem;
  }

  .year-signal {
    position: relative;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    color: var(--color-brass);
    filter: drop-shadow(0 0 8px rgba(201, 162, 39, 0.34));
    transform: translateY(-0.36rem);
  }

  .year-signal::before {
    content: '';
    position: absolute;
    inset: 0.1rem;
    border: 1px solid rgba(201, 162, 39, 0.18);
    border-radius: 999px;
    background: radial-gradient(circle, rgba(201, 162, 39, 0.08), transparent 62%);
  }

  .year-signal svg {
    position: relative;
    z-index: 1;
    width: 1.42rem;
    height: 1.42rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .year-label {
    margin: 0;
    color: var(--color-brass);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.45rem);
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .year-months {
    display: grid;
    gap: var(--space-md);
    min-width: 0;
  }

  .month-cluster {
    --month-accent: var(--color-brass);
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    position: relative;
  }

  .month-cluster--major {
    --month-accent: var(--color-accent-gold);
  }

  .month-cluster--note {
    --month-accent: var(--color-brass);
  }

  .month-rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .month-rail::before {
    content: '';
    position: absolute;
    top: 1.1rem;
    bottom: -1.2rem;
    width: 1px;
    background: linear-gradient(180deg, var(--month-accent), rgba(255, 255, 255, 0.05));
  }

  .month-pin {
    position: relative;
    z-index: 1;
    width: 0.72rem;
    height: 0.72rem;
    margin-top: 0.82rem;
    border: 1px solid var(--month-accent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--month-accent) 30%, var(--color-bg-primary));
    box-shadow: 0 0 14px color-mix(in srgb, var(--month-accent) 34%, transparent);
  }

  .month-shell {
    min-width: 0;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid rgba(201, 162, 39, 0.24);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(201, 162, 39, 0.055), transparent 42%),
      rgba(13, 13, 18, 0.66);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .month-cluster--major .month-shell {
    border-color: rgba(201, 162, 39, 0.36);
  }

  .month-cluster--note .month-shell {
    border-color: rgba(201, 162, 39, 0.16);
    background:
      linear-gradient(135deg, rgba(201, 162, 39, 0.035), transparent 42%),
      rgba(13, 13, 18, 0.6);
  }

  .month-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .month-label {
    display: block;
    color: var(--month-accent);
    font-family: var(--font-display);
    font-size: 1.28rem;
    letter-spacing: 0.06em;
  }

  .month-summary {
    display: block;
    margin-top: 0.18rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .month-events {
    display: grid;
    gap: 0;
  }

  .timeline-event {
    --event-accent: var(--color-brass);
    display: block;
    padding: var(--space-md) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.055);
  }

  .timeline-event:first-child {
    border-top: 0;
  }

  .timeline-event--major {
    --event-accent: var(--color-accent-gold);
    padding: var(--space-md) 0 var(--space-lg);
  }

  .timeline-event--major .event-title {
    color: var(--color-text-primary);
    font-size: clamp(1.2rem, 2vw, 1.42rem);
  }

  .timeline-event--major .event-body {
    padding-left: 0;
  }

  .timeline-event--note {
    --event-accent: var(--color-brass);
    padding-block: var(--space-sm);
  }

  .timeline-event--note .event-title {
    font-size: 1rem;
  }

  .timeline-event--note .event-desc {
    font-size: 0.9rem;
  }

  .event-body {
    min-width: 0;
  }

  .event-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.36rem;
  }

  .event-category,
  .event-date {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event-category {
    color: var(--color-brass);
    padding-bottom: 0.08rem;
    border-bottom: 1px solid rgba(201, 162, 39, 0.22);
  }

  .timeline-event--major .event-category {
    color: var(--color-accent-gold);
  }

  .timeline-event--note .event-category {
    color: var(--color-brass);
    opacity: 0.72;
  }

  .event-date {
    padding: 0.1rem 0.38rem;
    border: 1px solid color-mix(in srgb, var(--event-accent) 38%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--event-accent) 10%, transparent);
  }

  .event-title {
    margin: 0 0 0.42rem;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .event-desc {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.96rem;
    line-height: 1.65;
  }

  .timeline-end {
    text-align: center;
    padding: var(--space-xl) 0;
    color: var(--color-brass-dark);
    font-style: italic;
    position: relative;
  }

  .end-dot {
    width: 12px;
    height: 12px;
    background: var(--color-brass-dark);
    border: 2px solid var(--color-brass);
    border-radius: 50%;
    margin: 0 auto var(--space-md);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      box-shadow: 0 0 5px var(--color-brass-dark);
    }
    50% {
      box-shadow: 0 0 15px var(--color-brass);
    }
  }

  @media (max-width: 768px) {
    .page-header {
      margin-bottom: var(--space-lg);
    }

    .timeline {
      max-width: none;
    }

    .timeline-year {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      margin-bottom: var(--space-xl);
    }

    .year-marker {
      position: relative;
      top: auto;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: var(--space-sm);
    }

    .year-label {
      font-size: 1.7rem;
    }

    .month-cluster {
      grid-template-columns: 1.6rem minmax(0, 1fr);
    }

    .month-shell {
      padding: var(--space-md);
    }

    .month-label {
      font-size: 1.08rem;
    }

    .event-desc {
      font-size: 0.92rem;
      line-height: 1.6;
    }
  }
</style>
