---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import { projectCategories } from '../../data/projects';
import type { ProjectCategory, ProjectItem, ProjectStatus } from '../../data/projects';
import { defaultLocale, localizeString, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const statusMeta = Object.fromEntries(
  Object.entries(t.projects.status).map(([status, [label, title]]) => [status, { label, title }])
) as Record<ProjectStatus, { label: string; title: string }>;

function getProjectStatus(project: ProjectItem, category: ProjectCategory): ProjectStatus {
  if (project.status) return project.status;
  if (category.id === 'publications') return 'publication';
  if (!project.github && !project.website) return 'private';
  if (category.id === 'school') return 'coursework';
  if (category.id === 'vr') return 'prototype';
  if (category.id === 'unity') return project.website ? 'live' : 'practice';
  if (category.id === 'other') return 'practice';
  if (project.website) return 'live';
  return 'archive';
}

const categoryRoutes = projectCategories.map((category) => ({
  id: category.id,
  icon: category.icon,
  title: localizeString(category.title, lang),
  count: category.items.length,
}));
---

<BaseLayout title={t.projects.title} lang={lang}>
  <div class="container">
    <header class="page-header">
      <h1>{t.projects.title}</h1>
      <p class="subtitle">{t.projects.subtitle}</p>
    </header>

    <nav class="category-routes" aria-label={t.projects.routes.label}>
      <div class="category-routes-header">
        <span>{t.projects.routes.label}</span>
        <span>{t.projects.routes.hint}</span>
      </div>
      <div class="category-route-grid">
        {categoryRoutes.map((category) => (
          <a href={`#${category.id}`} class="category-route-item">
            <span class="category-route-logo" aria-hidden="true">
              <Icon name={category.icon} size={18} />
            </span>
            <span class="category-route-title">{category.title}</span>
            <span class="category-route-count">{category.count}</span>
          </a>
        ))}
      </div>
    </nav>
    
    {projectCategories.map((category) => (
      <section class="project-section" id={category.id}>
        <h2>
          <span class="section-logo" aria-hidden="true">
            <Icon name={category.icon} size={24} />
          </span>
          <span>{localizeString(category.title, lang)}</span>
        </h2>
        
        <div class="projects-grid">
          {category.items.map((project) => {
            const status = getProjectStatus(project, category);
            const meta = statusMeta[status];

            return (
              <article class={`project-card project-card--${status} ${project.featured ? 'featured' : ''}`}>
                {project.featured && <div class="featured-banner">{t.projects.featured}</div>}

                {project.image && (
                  <div class="project-image">
                    <img src={project.image} alt={localizeString(project.title, lang)} />
                  </div>
                )}
                
                <div class="project-content">
                  <div class="project-header">
                    <h3>{localizeString(project.title, lang)}</h3>
                    <div class="project-links">
                      {project.github && (
                        <a href={project.github} target="_blank" rel="noopener noreferrer" class="icon-link" title={t.projects.sourceTitle} aria-label={t.projects.sourceTitle}>
                          <Icon name="github" size={16} class="icon-link-symbol" />
                        </a>
                      )}
                      {project.website && (
                        <a href={project.website} target="_blank" rel="noopener noreferrer" class="icon-link" title={t.projects.siteTitle} aria-label={t.projects.siteTitle}>
                          <Icon name="externalLink" size={16} class="icon-link-symbol" />
                        </a>
                      )}
                    </div>
                  </div>
                  
                  <p class="project-desc">{localizeString(project.description, lang)}</p>
                  
                  {project.tags && project.tags.length > 0 && (
                    <div class="project-tags">
                      {project.tags.map((tag) => (
                        <span class="tag">{localizeString(tag, lang)}</span>
                      ))}
                    </div>
                  )}

                  <div class="project-meta-row">
                    <span class={`project-status project-status--${status}`} title={meta.title}>
                      {meta.label}
                    </span>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  
  .subtitle {
    color: var(--color-text-secondary);
    font-style: italic;
    margin-top: var(--space-sm);
  }

  .category-routes {
    margin-bottom: var(--space-xl);
  }

  .category-routes-header {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .category-route-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: var(--space-sm);
  }

  .category-route-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: center;
    min-height: 58px;
    padding: 0.65rem 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--surface-radius);
    background: rgba(10, 10, 15, 0.72);
    box-shadow: var(--surface-shadow);
    color: var(--color-text-primary);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .category-route-item:hover {
    background: rgba(201, 162, 39, 0.1);
    color: var(--color-brass-light);
  }

  .category-route-logo,
  .section-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(201, 162, 39, 0.24);
    background: rgba(201, 162, 39, 0.07);
    color: var(--color-brass);
    box-shadow: inset 0 0 16px rgba(201, 162, 39, 0.05);
  }

  .category-route-logo {
    width: 34px;
    height: 34px;
    border-radius: 8px;
  }

  .category-route-item:hover .category-route-logo {
    border-color: rgba(201, 162, 39, 0.5);
    background: rgba(201, 162, 39, 0.12);
  }

  .category-route-title {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .category-route-count {
    color: var(--color-brass-light);
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }
  
  .project-section {
    margin-bottom: var(--space-xl);
  }
  
  .project-section h2 {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .section-logo {
    width: 42px;
    height: 42px;
    border-radius: 10px;
  }
  
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }
  
  .project-card {
    background: var(--surface-glass);
    border: 1px solid var(--surface-border);
    border-radius: var(--surface-radius);
    position: relative;
    transition: all 0.3s ease;
    box-shadow: var(--surface-shadow);
    backdrop-filter: blur(var(--surface-blur));
    -webkit-backdrop-filter: blur(var(--surface-blur));
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  
  .project-card:hover {
    background: var(--surface-glass-hover);
    border-color: var(--surface-border-hover);
    transform: translateY(-2px);
    box-shadow: var(--surface-shadow-hover);
  }
  
  /* Featured marker: editorial ribbon, light enough to avoid reading as a status badge. */
  .featured-banner {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 1.6rem;
    padding: 0.22rem 1.1rem 0;
    border-top: 1px solid rgba(201, 162, 39, 0.42);
    background: linear-gradient(90deg, transparent 4%, rgba(201, 162, 39, 0.045) 50%, transparent 96%);
    color: rgba(236, 211, 141, 0.82);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0.035em;
    line-height: 1.1;
    pointer-events: none;
    z-index: 1;
  }

  .featured-banner::before,
  .featured-banner::after {
    content: "";
    flex: 0 1 4.6rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(201, 162, 39, 0.42));
  }

  .featured-banner::after {
    background: linear-gradient(90deg, rgba(201, 162, 39, 0.42), transparent);
  }
  
  .project-card.featured {
    border-color: rgba(201, 162, 39, 0.28);
  }

  .project-card--live {
    --status-color: rgba(106, 171, 255, 0.92);
    --status-glow: rgba(106, 171, 255, 0.28);
  }

  .project-card--prototype {
    --status-color: rgba(201, 162, 39, 0.92);
    --status-glow: rgba(201, 162, 39, 0.26);
  }

  .project-card--coursework {
    --status-color: rgba(160, 200, 255, 0.86);
    --status-glow: rgba(160, 200, 255, 0.2);
  }

  .project-card--practice {
    --status-color: rgba(184, 115, 51, 0.9);
    --status-glow: rgba(184, 115, 51, 0.22);
  }

  .project-card--publication {
    --status-color: rgba(212, 168, 75, 0.94);
    --status-glow: rgba(212, 168, 75, 0.3);
  }

  .project-card--private {
    --status-color: rgba(136, 136, 136, 0.82);
    --status-glow: rgba(136, 136, 136, 0.18);
  }

  .project-card--archive {
    --status-color: rgba(150, 150, 170, 0.78);
    --status-glow: rgba(150, 150, 170, 0.18);
  }
  
  .project-image {
    overflow: hidden;
  }
  
  .project-image img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  
  .project-card:hover .project-image img {
    transform: scale(1.03);
  }
  
  .project-content {
    padding: var(--space-lg);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .project-card.featured .project-content {
    padding-top: calc(var(--space-lg) + 1.25rem);
  }

  .project-meta-row {
    display: flex;
    justify-content: flex-start;
    margin-top: 0.65rem;
    padding-top: 0.15rem;
  }

  .project-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.11em;
    line-height: 1;
    text-transform: uppercase;
  }

  .project-status::before {
    content: "";
    width: 14px;
    height: 1px;
    background: var(--status-color);
    opacity: 0.7;
  }
  
  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }
  
  .project-header h3 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.22rem;
    font-weight: 700;
    line-height: 1.35;
    min-width: 0;
  }
  
  .project-links {
    display: inline-flex;
    align-items: center;
    gap: 0.12rem;
    flex-shrink: 0;
    padding: 0.12rem;
    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.026);
    box-shadow: inset 0 0 12px rgba(255, 255, 255, 0.018);
  }
  
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.72rem;
    height: 1.72rem;
    border-radius: 4px;
    color: rgba(217, 217, 217, 0.58);
    transition:
      background 0.22s ease,
      color 0.22s ease,
      transform 0.22s ease,
      box-shadow 0.22s ease;
  }
  
  .icon-link :global(.icon-link-symbol) {
    color: currentColor;
  }

  .icon-link:hover,
  .icon-link:focus-visible {
    background: rgba(201, 162, 39, 0.1);
    color: var(--color-brass-light);
    box-shadow: 0 0 0 1px rgba(201, 162, 39, 0.18);
    transform: translateY(-1px);
  }

  .icon-link:focus-visible {
    outline: 1px solid rgba(201, 162, 39, 0.55);
    outline-offset: 2px;
  }
  
  .project-desc {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin-bottom: var(--space-md);
    line-height: 1.6;
    flex: 1;
  }
  
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0;
  }

  .project-tags .tag {
    padding: 0.22rem 0.42rem;
    border-color: rgba(255, 255, 255, 0.045);
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.018);
    color: var(--color-text-muted);
    font-size: 0.72rem;
    line-height: 1.25;
  }
  
  @media (max-width: 768px) {
    .category-routes-header {
      display: block;
    }

    .category-routes-header span:last-child {
      display: block;
      margin-top: 0.25rem;
    }

    .category-route-grid {
      grid-template-columns: 1fr;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      margin-top: var(--space-md);
    }

    .project-content {
      padding: var(--space-md);
    }

    .project-card.featured .project-content {
      padding-top: calc(var(--space-md) + 1.15rem);
    }

    .project-image img {
      height: 140px;
    }
  }
</style>
