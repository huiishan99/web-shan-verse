---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import { projectCategories } from '../../data/projects';
import type { ProjectStatus } from '../../data/projects';
import { defaultLocale, localizeString, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getProjectStatus } from '../../utils/projects';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const statusMeta = Object.fromEntries(
  Object.entries(t.projects.status).map(([status, [label, title]]) => [status, { label, title }])
) as Record<ProjectStatus, { label: string; title: string }>;

const categoryOrder = new Map([
  ['publications', 0],
  ['research', 1],
]);
const orderedProjectCategories = [...projectCategories].sort((first, second) =>
  (categoryOrder.get(first.id) ?? 2) - (categoryOrder.get(second.id) ?? 2)
);

const categoryRoutes = orderedProjectCategories.map((category) => ({
  id: category.id,
  icon: category.icon,
  title: localizeString(category.title, lang),
  count: category.items.length,
}));

const highlightedAuthorPattern = /(HuiShan Lai|Huishan Lai)/g;
const highlightedAuthorNames = new Set(['HuiShan Lai', 'Huishan Lai']);

function getAuthorParts(authors: string) {
  return authors.split(highlightedAuthorPattern)
    .filter(Boolean)
    .map((text) => ({
      text,
      highlighted: highlightedAuthorNames.has(text),
    }));
}
---

<BaseLayout title={t.projects.title} lang={lang}>
  <div class="container">
    <header class="page-header">
      <h1>{t.projects.title}</h1>
      <p class="subtitle">{t.projects.subtitle}</p>
    </header>

    <nav class="category-routes" aria-label={t.projects.routes.label}>
      <div class="category-routes-header">
        <span>{t.projects.routes.label}</span>
        <span>{t.projects.routes.hint}</span>
      </div>
      <div class="category-route-grid">
        {categoryRoutes.map((category) => (
          <a href={`#${category.id}`} class="category-route-item">
            <span class="category-route-logo" aria-hidden="true">
              <Icon name={category.icon} size={18} />
            </span>
            <span class="category-route-title">{category.title}</span>
            <span class="category-route-count">{category.count}</span>
          </a>
        ))}
      </div>
    </nav>
    
    {orderedProjectCategories.map((category) => (
      <section class="project-section" id={category.id}>
        <h2>
          <span class="section-logo" aria-hidden="true">
            <Icon name={category.icon} size={24} />
          </span>
          <span>{localizeString(category.title, lang)}</span>
        </h2>
        
        <div class="projects-grid">
          {category.items.map((project, projectIndex) => {
            const status = getProjectStatus(project, category);
            const meta = statusMeta[status];
            const detailDialogId = `project-detail-${category.id}-${projectIndex}`;
            const detailTitleId = `${detailDialogId}-title`;
            const detailImage = project.detailImage || project.image;
            const detailImageAlt = localizeString(project.detailImageAlt || project.title, lang);
            const detailDescription = localizeString(project.details || project.description, lang);

            return (
              <>
                <article class={`project-card project-card--${status} ${project.featured ? 'featured' : ''}`}>
                {project.featured && (
                  <div class="featured-banner">
                    {project.featuredLabel ? localizeString(project.featuredLabel, lang) : t.projects.featured}
                  </div>
                )}

                {project.image && (
                  <div class="project-image">
                    <img src={project.image} alt={localizeString(project.title, lang)} />
                  </div>
                )}
                
                <div class="project-content">
                  <div class="project-main">
                    <div class="project-header">
                      <h3>{localizeString(project.title, lang)}</h3>
                    </div>

                    {(project.authors || project.conference) && (
                      <div class="project-publication-meta">
                        {project.authors && (
                          <p class="project-authors">
                            {getAuthorParts(localizeString(project.authors, lang)).map((part) => (
                              part.highlighted ? <strong>{part.text}</strong> : <span>{part.text}</span>
                            ))}
                          </p>
                        )}
                        {project.conference && (
                          <p class="project-conference">{localizeString(project.conference, lang)}</p>
                        )}
                      </div>
                    )}

                    <p class="project-desc">{localizeString(project.description, lang)}</p>
                  </div>

                  <div class="project-card-footer">
                    {project.tags && project.tags.length > 0 && (
                      <div class="project-tags">
                        {project.tags.map((tag) => (
                          <span class="tag">{localizeString(tag, lang)}</span>
                        ))}
                      </div>
                    )}

                    <div class="project-meta-row">
                      {(project.github || project.paper || project.caseStudy || project.website) && (
                        <div class="project-links">
                        {project.github && (
                          <a href={project.github} target="_blank" rel="noopener noreferrer" class="icon-link" title={t.projects.sourceTitle} aria-label={t.projects.sourceTitle}>
                            <Icon name="github" size={13} class="icon-link-symbol" />
                          </a>
                        )}
                        {project.paper && (
                          <a href={project.paper} target="_blank" rel="noopener noreferrer" class="icon-link" title={t.projects.paperTitle} aria-label={t.projects.paperTitle}>
                            <Icon name="publication" size={13} class="icon-link-symbol" />
                          </a>
                        )}
                        {project.caseStudy && (
                          <a href={project.caseStudy} target="_blank" rel="noopener noreferrer" class="icon-link" title={t.projects.caseStudyTitle} aria-label={t.projects.caseStudyTitle}>
                            <Icon name="book" size={13} class="icon-link-symbol" />
                          </a>
                        )}
                        {project.website && (
                          <a href={project.website} target="_blank" rel="noopener noreferrer" class="icon-link" title={t.projects.siteTitle} aria-label={t.projects.siteTitle}>
                            <Icon name="externalLink" size={13} class="icon-link-symbol" />
                          </a>
                        )}
                        </div>
                      )}
                      <span class={`project-status project-status--${status}`} title={meta.title}>
                        {meta.label}
                      </span>
                      <button
                        type="button"
                        class="project-detail-trigger"
                        aria-haspopup="dialog"
                        aria-controls={detailDialogId}
                        data-project-dialog-open={detailDialogId}
                      >
                        <Icon name="plus" size={12} />
                        <span>{t.projects.detailsButton}</span>
                      </button>
                    </div>
                  </div>
                </div>
                </article>

                <dialog
                  id={detailDialogId}
                  class={`project-detail-dialog project-detail-dialog--${detailImage ? 'with-image' : 'text-only'} project-card--${status}`}
                  aria-labelledby={detailTitleId}
                >
                  <div class="project-detail-panel">
                    <button
                      type="button"
                      class="project-detail-close"
                      aria-label={t.projects.closeDetails}
                      data-project-dialog-close
                    >
                      <Icon name="x" size={18} />
                    </button>

                    {detailImage && (
                      <figure class="project-detail-media">
                        <img
                          src={detailImage}
                          alt={detailImageAlt}
                          loading="lazy"
                          decoding="async"
                        />
                      </figure>
                    )}

                    <div class="project-detail-body">
                      <div class="project-detail-kicker">
                        <span>{localizeString(category.title, lang)}</span>
                        <span class={`project-status project-status--${status}`} title={meta.title}>
                          {meta.label}
                        </span>
                      </div>

                      <h2 id={detailTitleId}>{localizeString(project.title, lang)}</h2>

                    {(project.authors || project.conference) && (
                      <div class="project-detail-publication-meta">
                        {project.authors && (
                          <p class="project-authors">
                            {getAuthorParts(localizeString(project.authors, lang)).map((part) => (
                              part.highlighted ? <strong>{part.text}</strong> : <span>{part.text}</span>
                            ))}
                          </p>
                        )}
                        {project.conference && (
                          <p class="project-conference">{localizeString(project.conference, lang)}</p>
                        )}
                      </div>
                    )}

                    <p class="project-detail-description">{detailDescription}</p>

                    {project.tags && project.tags.length > 0 && (
                      <div class="project-tags project-detail-tags">
                        {project.tags.map((tag) => (
                          <span class="tag">{localizeString(tag, lang)}</span>
                        ))}
                      </div>
                    )}

                    {(project.github || project.paper || project.caseStudy || project.website) && (
                      <div class="project-detail-links" aria-label={t.projects.detailsLinks}>
                        {project.github && (
                          <a href={project.github} target="_blank" rel="noopener noreferrer" class="project-detail-link">
                            <Icon name="github" size={15} />
                            <span>{t.projects.sourceTitle}</span>
                          </a>
                        )}
                        {project.paper && (
                          <a href={project.paper} target="_blank" rel="noopener noreferrer" class="project-detail-link">
                            <Icon name="publication" size={15} />
                            <span>{t.projects.paperTitle}</span>
                          </a>
                        )}
                        {project.caseStudy && (
                          <a href={project.caseStudy} target="_blank" rel="noopener noreferrer" class="project-detail-link">
                            <Icon name="book" size={15} />
                            <span>{t.projects.caseStudyTitle}</span>
                          </a>
                        )}
                        {project.website && (
                          <a href={project.website} target="_blank" rel="noopener noreferrer" class="project-detail-link">
                            <Icon name="externalLink" size={15} />
                            <span>{t.projects.siteTitle}</span>
                          </a>
                        )}
                      </div>
                    )}
                    </div>
                  </div>
                </dialog>
              </>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  
  .subtitle {
    color: var(--color-text-secondary);
    font-style: italic;
    margin-top: var(--space-sm);
  }

  .category-routes {
    margin-bottom: var(--space-xl);
  }

  .category-routes-header {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .category-route-grid {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.45rem;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding-bottom: 0.15rem;
    scrollbar-width: thin;
  }

  .category-route-item {
    display: grid;
    flex: 1 0 0;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.46rem;
    align-items: center;
    min-width: 0;
    min-height: 50px;
    padding: 0.52rem 0.58rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--surface-radius);
    background: rgba(10, 10, 15, 0.72);
    box-shadow: var(--surface-shadow);
    color: var(--color-text-primary);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .category-route-item:hover {
    background: rgba(201, 162, 39, 0.1);
    color: var(--color-brass-light);
  }

  .category-route-logo,
  .section-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(201, 162, 39, 0.24);
    background: rgba(201, 162, 39, 0.07);
    color: var(--color-brass);
    box-shadow: inset 0 0 16px rgba(201, 162, 39, 0.05);
  }

  .category-route-logo {
    width: 30px;
    height: 30px;
    border-radius: 8px;
  }

  .category-route-item:hover .category-route-logo {
    border-color: rgba(201, 162, 39, 0.5);
    background: rgba(201, 162, 39, 0.12);
  }

  .category-route-title {
    min-width: 0;
    overflow: hidden;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .category-route-count {
    color: var(--color-brass-light);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  
  .project-section {
    margin-bottom: var(--space-xl);
  }
  
  .project-section h2 {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .section-logo {
    width: 42px;
    height: 42px;
    border-radius: 10px;
  }
  
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }
  
  .project-card {
    background: var(--surface-glass);
    border: 1px solid var(--surface-border);
    border-radius: var(--surface-radius);
    position: relative;
    transition: all 0.3s ease;
    box-shadow: var(--surface-shadow);
    backdrop-filter: blur(var(--surface-blur));
    -webkit-backdrop-filter: blur(var(--surface-blur));
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  
  .project-card:hover {
    background: var(--surface-glass-hover);
    border-color: var(--surface-border-hover);
    transform: translateY(-2px);
    box-shadow: var(--surface-shadow-hover);
  }
  
  /* Featured marker: editorial ribbon, light enough to avoid reading as a status badge. */
  .featured-banner {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 1.6rem;
    padding: 0.22rem 1.1rem 0;
    border-top: 1px solid rgba(201, 162, 39, 0.42);
    background: linear-gradient(90deg, transparent 4%, rgba(201, 162, 39, 0.045) 50%, transparent 96%);
    color: rgba(236, 211, 141, 0.82);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0.035em;
    line-height: 1.1;
    pointer-events: none;
    z-index: 1;
  }

  .featured-banner::before,
  .featured-banner::after {
    content: "";
    flex: 0 1 4.6rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(201, 162, 39, 0.42));
  }

  .featured-banner::after {
    background: linear-gradient(90deg, rgba(201, 162, 39, 0.42), transparent);
  }
  
  .project-card.featured {
    border-color: rgba(201, 162, 39, 0.28);
  }

  .project-card--live {
    --status-color: rgba(106, 171, 255, 0.92);
    --status-glow: rgba(106, 171, 255, 0.28);
  }

  .project-card--prototype {
    --status-color: rgba(201, 162, 39, 0.92);
    --status-glow: rgba(201, 162, 39, 0.26);
  }

  .project-card--coursework {
    --status-color: rgba(160, 200, 255, 0.86);
    --status-glow: rgba(160, 200, 255, 0.2);
  }

  .project-card--practice {
    --status-color: rgba(184, 115, 51, 0.9);
    --status-glow: rgba(184, 115, 51, 0.22);
  }

  .project-card--in-preparation {
    --status-color: rgba(205, 145, 76, 0.92);
    --status-glow: rgba(205, 145, 76, 0.24);
  }

  .project-card--under-review {
    --status-color: rgba(146, 156, 255, 0.92);
    --status-glow: rgba(146, 156, 255, 0.24);
  }

  .project-card--accepted {
    --status-color: rgba(103, 190, 145, 0.92);
    --status-glow: rgba(103, 190, 145, 0.24);
  }

  .project-card--early-stage {
    --status-color: rgba(102, 180, 196, 0.92);
    --status-glow: rgba(102, 180, 196, 0.24);
  }

  .project-card--on-hold {
    --status-color: rgba(142, 150, 164, 0.86);
    --status-glow: rgba(142, 150, 164, 0.2);
  }

  .project-card--awaiting-coordination {
    --status-color: rgba(172, 135, 190, 0.9);
    --status-glow: rgba(172, 135, 190, 0.22);
  }

  .project-card--publication {
    --status-color: rgba(212, 168, 75, 0.94);
    --status-glow: rgba(212, 168, 75, 0.3);
  }

  .project-card--private {
    --status-color: rgba(136, 136, 136, 0.82);
    --status-glow: rgba(136, 136, 136, 0.18);
  }

  .project-card--archive {
    --status-color: rgba(150, 150, 170, 0.78);
    --status-glow: rgba(150, 150, 170, 0.18);
  }
  
  .project-image {
    overflow: hidden;
  }
  
  .project-image img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  
  .project-card:hover .project-image img {
    transform: scale(1.03);
  }
  
  .project-content {
    padding: var(--space-lg);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .project-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .project-card-footer {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin-top: auto;
  }

  .project-card.featured .project-content {
    padding-top: calc(var(--space-lg) + 1.25rem);
  }

  .project-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.44rem 0.62rem;
    justify-content: flex-start;
    margin-top: 0.7rem;
    padding-top: 0.1rem;
  }

  .project-detail-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    min-height: 1.72rem;
    margin-left: auto;
    padding: 0.3rem 0.55rem;
    border: 1px solid rgba(201, 162, 39, 0.22);
    border-radius: 4px;
    background: rgba(201, 162, 39, 0.045);
    color: rgba(226, 206, 151, 0.78);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.06em;
    line-height: 1;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .project-detail-trigger:hover,
  .project-detail-trigger:focus-visible {
    border-color: rgba(201, 162, 39, 0.5);
    background: rgba(201, 162, 39, 0.11);
    color: var(--color-brass-light);
    transform: translateY(-1px);
  }

  .project-detail-trigger:focus-visible {
    outline: 1px solid rgba(212, 168, 75, 0.65);
    outline-offset: 2px;
  }

  .project-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.11em;
    line-height: 1;
    text-transform: uppercase;
  }

  .project-status::before {
    content: "";
    width: 12px;
    height: 1px;
    background: var(--status-color);
    opacity: 0.62;
  }
  
  .project-header {
    margin-bottom: var(--space-sm);
  }
  
  .project-header h3 {
    font-family: var(--font-editorial);
    font-size: 1.22rem;
    font-weight: 700;
    line-height: 1.35;
    min-width: 0;
    overflow-wrap: break-word;
  }
  
  .project-links {
    display: inline-flex;
    align-items: center;
    gap: 0.08rem;
    flex-shrink: 0;
    padding: 0.08rem;
    border: 1px solid rgba(255, 255, 255, 0.045);
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.014);
  }
  
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.38rem;
    height: 1.38rem;
    border-radius: 3px;
    color: rgba(217, 217, 217, 0.5);
    text-decoration: none;
    transition:
      background 0.22s ease,
      color 0.22s ease,
      transform 0.22s ease,
      box-shadow 0.22s ease;
  }
  
  .icon-link:visited {
    color: rgba(217, 217, 217, 0.5);
  }

  .icon-link :global(.icon-link-symbol) {
    color: currentColor;
  }

  .icon-link:hover,
  .icon-link:focus-visible {
    background: rgba(255, 255, 255, 0.045);
    color: rgba(242, 242, 242, 0.82);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.055);
    transform: translateY(-1px);
  }

  .icon-link:focus-visible {
    outline: 1px solid rgba(217, 217, 217, 0.35);
    outline-offset: 2px;
  }
  
  .project-desc {
    display: -webkit-box;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin-bottom: var(--space-md);
    line-height: 1.6;
    flex: 1;
    max-height: calc(1.6em * 4);
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .project-publication-meta {
    display: grid;
    gap: 0.24rem;
    margin: -0.12rem 0 0.7rem;
    color: rgba(218, 218, 218, 0.72);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .project-authors,
  .project-conference {
    margin: 0;
  }

  .project-authors {
    font-family: var(--font-body);
    font-style: italic;
  }

  .project-authors strong {
    color: inherit;
    font-style: inherit;
    font-weight: 700;
  }

  .project-conference {
    display: flex;
    align-items: baseline;
    gap: 0.44rem;
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }

  .project-conference::before {
    content: "";
    flex: 0 0 12px;
    height: 1px;
    background: rgba(201, 162, 39, 0.38);
  }
  
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0;
  }

  .project-tags .tag {
    padding: 0.22rem 0.42rem;
    border-color: rgba(255, 255, 255, 0.045);
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.018);
    color: var(--color-text-muted);
    font-size: 0.72rem;
    line-height: 1.25;
  }

  .project-detail-dialog {
    width: min(790px, calc(100vw - 2rem));
    max-width: 790px;
    max-height: min(82vh, 720px);
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(201, 162, 39, 0.32);
    border-radius: 10px;
    background:
      linear-gradient(145deg, rgba(27, 25, 30, 0.98), rgba(10, 10, 15, 0.99)),
      var(--color-bg-primary);
    box-shadow:
      0 30px 90px rgba(0, 0, 0, 0.62),
      0 0 0 1px rgba(255, 255, 255, 0.035),
      0 0 42px var(--status-glow);
    color: var(--color-text-primary);
  }

  .project-detail-dialog--text-only {
    width: min(630px, calc(100vw - 2rem));
  }

