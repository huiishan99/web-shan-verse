---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import { projectCategories } from '../../data/projects';
import type { ProjectStatus } from '../../data/projects';
import { defaultLocale, localizeString, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import '../../styles/projects-shared.css';
import { getProjectPath, getProjectRecord, getProjectStatus } from '../../utils/projects';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const statusMeta = Object.fromEntries(
  Object.entries(t.projects.status).map(([status, [label, title]]) => [status, { label, title }])
) as Record<ProjectStatus, { label: string; title: string }>;

const categoryOrder = new Map([
  ['publications', 0],
  ['theses', 1],
  ['research', 2],
]);
const academicCategoryIds = new Set(['publications', 'theses', 'research']);
const orderedProjectCategories = [...projectCategories].sort((first, second) =>
  (categoryOrder.get(first.id) ?? 3) - (categoryOrder.get(second.id) ?? 3)
);

const categoryRoutes = orderedProjectCategories.map((category) => ({
  id: category.id,
  icon: category.icon,
  title: localizeString(category.title, lang),
  count: category.items.length,
}));

const highlightedAuthorPattern = /(HuiShan Lai|Huishan Lai)/g;
const highlightedAuthorNames = new Set(['HuiShan Lai', 'Huishan Lai']);

function getAuthorParts(authors: string) {
  return authors.split(highlightedAuthorPattern)
    .filter(Boolean)
    .map((text) => ({
      text,
      highlighted: highlightedAuthorNames.has(text),
    }));
}
---

<BaseLayout title={t.projects.title} lang={lang}>
  <div class="container">
    <header class="page-header">
      <h1>{t.projects.title}</h1>
      <p class="subtitle">{t.projects.subtitle}</p>
    </header>

    <nav class="category-routes" aria-label={t.projects.routes.label}>
      <div class="category-routes-header">
        <span>{t.projects.routes.label}</span>
        <span>{t.projects.routes.hint}</span>
      </div>
      <div class="category-route-grid">
        {categoryRoutes.map((category) => (
          <a href={`#${category.id}`} class="category-route-item">
            <span class="category-route-logo" aria-hidden="true">
              <Icon name={category.icon} size={18} />
            </span>
            <span class="category-route-title">{category.title}</span>
            <span class="category-route-count">{category.count}</span>
          </a>
        ))}
      </div>
    </nav>
    
    {orderedProjectCategories.map((category) => (
      <section class="project-section" id={category.id}>
        <h2>
          <span class="section-logo" aria-hidden="true">
            <Icon name={category.icon} size={24} />
          </span>
          <span>{localizeString(category.title, lang)}</span>
        </h2>
        
        <div class="projects-grid">
          {category.items.map((project, projectIndex) => {
            const status = getProjectStatus(project, category);
            const meta = statusMeta[status];
            const record = getProjectRecord(category.id, projectIndex);
            const detailPath = getProjectPath(record, lang);
            const firstDetailImage = project.detailImages?.[0];
            const cardImage = project.image || project.detailImage || firstDetailImage?.src;
            const hasAcademicPreview = Boolean(cardImage) && academicCategoryIds.has(category.id);
            const cardImageAlt = firstDetailImage && firstDetailImage.src === cardImage
              ? localizeString(firstDetailImage.alt, lang)
              : localizeString(project.detailImageAlt || project.title, lang);
            const cardImageFit = project.image
              ? 'cover'
              : firstDetailImage?.fit || project.detailImageFit || 'cover';
            const legacyDetailImage = project.detailImage || project.image;
            const projectDetailImageCount = project.detailImages?.length
              ? project.detailImages.length
              : legacyDetailImage
                ? 1
                : 0;
            const awardImageIndex = project.award ? projectDetailImageCount : -1;

            return (
              <>
                <article class={`project-card project-card--${status} ${project.featured ? 'featured' : ''} ${project.featured && !project.featuredLabel ? 'project-card--selected' : ''} ${hasAcademicPreview ? 'project-card--academic-preview' : ''}`}>
                  {cardImage && (
                    <div class={`project-image project-image--${cardImageFit}`}>
                      <img src={cardImage} alt={cardImageAlt} loading="lazy" decoding="async" />
                    </div>
                  )}

                  {project.featured && (
                    <div class="featured-banner">
                      {project.featuredLabel ? localizeString(project.featuredLabel, lang) : t.projects.featured}
                    </div>
                  )}
                
                <div class="project-content">
                  <div class="project-main">
                    <div class="project-header">
                      <h3>{localizeString(project.title, lang)}</h3>
                    </div>

                    {(project.authors || project.conference) && (
                      <div class="project-publication-meta">
                        {project.authors && (
                          <p class="project-authors">
                            {getAuthorParts(localizeString(project.authors, lang)).map((part) => (
                              <span class:list={{ 'project-author--highlighted': part.highlighted }}>{part.text}</span>
                            ))}
                          </p>
                        )}
                        {project.conference && (
                          <p class="project-conference">{localizeString(project.conference, lang)}</p>
                        )}
                      </div>
                    )}

                    <p class="project-desc">{localizeString(project.description, lang)}</p>
                  </div>

                  <div class="project-card-footer">
                    {project.tags && project.tags.length > 0 && (
                      <div class="project-tags">
                        {project.tags.map((tag) => (
                          <span class="tag">{localizeString(tag, lang)}</span>
                        ))}
                      </div>
                    )}

                    <div class="project-meta-row">
                      {(project.github || project.paper || project.caseStudy || project.award || project.website) && (
                        <div class="project-links">
                        {project.github && (
                          <a href={project.github} target="_blank" rel="noopener noreferrer" class="icon-link" title={t.projects.sourceTitle} aria-label={t.projects.sourceTitle}>
                            <Icon name="github" size={13} class="icon-link-symbol" />
                          </a>
                        )}
                        {project.paper && (
                          <a href={project.paper} target="_blank" rel="noopener noreferrer" class="icon-link" title={t.projects.paperTitle} aria-label={t.projects.paperTitle}>
                            <Icon name="publication" size={13} class="icon-link-symbol" />
                          </a>
                        )}
                        {project.caseStudy && (
                          <a href={project.caseStudy} target="_blank" rel="noopener noreferrer" class="icon-link" title={t.projects.caseStudyTitle} aria-label={t.projects.caseStudyTitle}>
                            <Icon name="globe" size={13} class="icon-link-symbol" />
                          </a>
                        )}
                        {project.award && (
                          <a
                            href={`${detailPath}#project-detail-gallery`}
                            class="icon-link icon-link--award"
                            title={t.projects.awardTitle}
                            aria-label={t.projects.awardTitle}
                            data-project-detail-link
                            data-project-gallery-start={awardImageIndex}
                          >
                            <Icon name="award" size={13} class="icon-link-symbol" />
                          </a>
                        )}
                        {project.website && (
                          <a href={project.website} target="_blank" rel="noopener noreferrer" class="icon-link" title={t.projects.siteTitle} aria-label={t.projects.siteTitle}>
                            <Icon name="externalLink" size={13} class="icon-link-symbol" />
                          </a>
                        )}
                        </div>
                      )}
                      <span class={`project-status project-status--${status}`} title={meta.title}>
                        {meta.label}
                      </span>
                      <a
                        href={detailPath}
                        class="project-detail-trigger"
                        data-project-detail-link
                      >
                        <Icon name="chevronRight" size={11} />
                        <span>{t.projects.detailsButton}</span>
                      </a>
                    </div>
                  </div>
                </div>
                </article>
              </>
            );
          })}
        </div>
      </section>
    ))}
  </div>

  <dialog
    id="project-detail-dialog"
    class="project-detail-dialog"
    aria-labelledby="project-detail-title"
    data-project-detail-dialog
  >
    <button
      type="button"
      class="project-detail-close"
      aria-label={t.projects.closeDetails}
      data-project-dialog-close
    >
      <Icon name="x" size={18} />
    </button>
    <div data-project-dialog-content></div>
  </dialog>
</BaseLayout>


<script>
  import '../../scripts/client/project-details.js';
</script>
