---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SiteStats from '../components/SiteStats.astro';
import { currentStatus } from '../data/status';
import { timelineData } from '../data/timeline';
import { getCollection } from 'astro:content';

// 获取最新3篇博客文章
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

type HomepagePetMood = 'idle' | 'waving' | 'failed';

// Keep the homepage pet available for later without rendering it now.
const showHomepagePet = false;

// Change this to 'waving' or 'failed' when you want the homepage pet to react.
// The pet uses a stable frame from each row; full-row playback flashes on some Codex Pet atlases.
const homepagePetMood: HomepagePetMood = 'idle';
const homepagePetRows: Record<HomepagePetMood, number> = {
  idle: 0,
  waving: 1,
  failed: 8,
};
const homepagePetRowOffset = `${homepagePetRows[homepagePetMood] * 12.5}%`;

const monthIndex: Record<string, number> = {
  January: 0,
  February: 1,
  March: 2,
  April: 3,
  May: 4,
  June: 5,
  July: 6,
  August: 7,
  September: 8,
  October: 9,
  November: 10,
  December: 11,
};

type ActivitySignal = {
  date: Date;
  datetime: string;
  displayDate: string;
  dateSource: 'blog date' | 'timeline month';
  href: string;
  title: string;
  type: 'post' | 'milestone';
};

const postSignals: ActivitySignal[] = allPosts.map((post) => ({
  date: post.data.date,
  datetime: toDateKey(post.data.date),
  displayDate: formatActivityDate(post.data.date),
  dateSource: 'blog date',
  href: `/blog/${post.id}`,
  title: post.data.title,
  type: 'post',
}));

const timelineSignals: ActivitySignal[] = timelineData.flatMap((yearData) =>
  yearData.events.map((event) => {
    const eventMonthIndex = monthIndex[event.month] ?? 0;

    return {
      // Timeline entries are month-level, so place them at mid-month for the grid.
      date: new Date(Date.UTC(yearData.year, eventMonthIndex, 15)),
      datetime: `${yearData.year}-${String(eventMonthIndex + 1).padStart(2, '0')}`,
      displayDate: `${event.month} ${yearData.year}`,
      dateSource: 'timeline month' as const,
      href: '/timeline',
      title: event.title,
      type: 'milestone' as const,
    };
  })
);

const activitySignals = [...postSignals, ...timelineSignals];

function toDateKey(date: Date): string {
  return date.toISOString().slice(0, 10);
}

function startOfDay(date: Date): Date {
  return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
}

function addDays(date: Date, days: number): Date {
  const nextDate = new Date(date);
  nextDate.setUTCDate(nextDate.getUTCDate() + days);
  return nextDate;
}

function formatActivityDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

function formatActivityMonthYear(date: Date): string {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

function filterCrowdedMonthLabels(labels: string[], minGap: number = 3): string[] {
  const filteredLabels = [...labels];
  let previousLabelIndex = -1;

  labels.forEach((label, index) => {
    if (!label) return;

    if (previousLabelIndex >= 0 && index - previousLabelIndex < minGap) {
      filteredLabels[previousLabelIndex] = '';
    }

    previousLabelIndex = index;
  });

  return filteredLabels;
}

const today = startOfDay(new Date());
const gridEnd = addDays(today, 6 - today.getUTCDay());
const gridStart = addDays(gridEnd, -(52 * 7 - 1));
const activityRangeLabel = `${formatActivityMonthYear(gridStart)} - ${formatActivityMonthYear(gridEnd)}`;

const signalsByDay = activitySignals.reduce<Record<string, ActivitySignal[]>>((acc, signal) => {
  const key = toDateKey(startOfDay(signal.date));
  acc[key] = [...(acc[key] || []), signal];
  return acc;
}, {});

const activityWeeks = Array.from({ length: 52 }, (_, weekIndex) =>
  Array.from({ length: 7 }, (_, dayIndex) => {
    const date = addDays(gridStart, weekIndex * 7 + dayIndex);
    const signals = signalsByDay[toDateKey(date)] || [];
    const intensity = Math.min(signals.length, 4);

    return {
      date,
      key: toDateKey(date),
      signals,
      intensity,
    };
  })
);

const activityMonthLabels = filterCrowdedMonthLabels(activityWeeks.map((week, weekIndex) => {
  const firstOfMonth = week.find((day) => day.date.getUTCDate() === 1);
  const labelDate = firstOfMonth?.date || (weekIndex === 0 ? week[0].date : null);

  return labelDate
    ? labelDate.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' })
    : '';
}));

const activityYearLabels = activityWeeks.map((week, weekIndex) => {
  const firstOfYear = week.find((day) => day.date.getUTCMonth() === 0 && day.date.getUTCDate() === 1);
  const labelDate = firstOfYear?.date || (weekIndex === 0 ? week[0].date : null);

  return labelDate ? String(labelDate.getUTCFullYear()) : '';
});

const visibleSignals = activitySignals
  .filter((signal) => {
    const signalDate = startOfDay(signal.date);
    return signalDate >= gridStart && signalDate <= gridEnd;
  })
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const activeDays = new Set(visibleSignals.map((signal) => toDateKey(startOfDay(signal.date)))).size;
const totalSignals = visibleSignals.length;
const activityLabel = `Signal map for ${activityRangeLabel}: ${totalSignals} signals across ${activeDays} active days. Blog dates are exact; milestones use timeline months.`;
const recentSignals = visibleSignals.slice(0, 6);
const postSignalCount = visibleSignals.filter((signal) => signal.type === 'post').length;
const milestoneSignalCount = visibleSignals.filter((signal) => signal.type === 'milestone').length;
const githubUsername = 'huiishan99';
const githubProfileUrl = `https://github.com/${githubUsername}`;
const githubContributionChartUrl = `https://ghchart.rshah.org/C9A227/${githubUsername}`;

// 提取文章第一段内容
function getExcerpt(body: string, maxLength: number = 100): string {
  // 移除 markdown 语法，提取纯文本
  const cleanText = body
    .replace(/^---[\s\S]*?---/m, '')  // 移除 frontmatter
    .replace(/!\[.*?\]\(.*?\)/g, '')  // 移除图片
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')  // 链接只保留文字
    .replace(/[#*`>\-]/g, '')  // 移除 markdown 符号
    .replace(/\n+/g, ' ')  // 换行变空格
    .trim();
  
  if (cleanText.length <= maxLength) return cleanText;
  return cleanText.slice(0, maxLength).trim() + '...';
}
---

<BaseLayout title="Home">
  <div class="container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <p class="hero-greeting">Welcome to</p>
        <h1 class="hero-title">
          <span class="title-line">SHAN</span>
          <span class="title-decoration">— ✦ —</span>
          <span class="title-line">VERSE</span>
        </h1>
        <p class="hero-tagline">Curiosity fuels the journey, code lights the way.</p>
        
        <div class="hero-intro">
          <p>
            Hi, I'm <span class="highlight">Lai HuiShan</span> — A person who loves the world. If you want to know more About Me, please click on "<span class="highlight">About Me</span>" button below.
          </p>
        </div>
        
        <div class="hero-actions">
          <a href="/about" class="btn">
            <Icon name="gear" size={16} /> About Me
          </a>
          <a href="/projects" class="btn">
            <Icon name="layers" size={16} /> View Projects
          </a>
        </div>
      </div>
      
      <aside class="hero-status">
        <div class="status-card">
          <h3 class="status-title">{currentStatus.title}</h3>
          <div class="status-badge">{currentStatus.badge}</div>
          <ul class="status-list">
            {currentStatus.items.map((item) => (
              <li>
                <Icon name={item.icon} size={16} />
                {item.url ? (
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    {item.text}
                  </a>
                ) : (
                  <span>{item.text}</span>
                )}
              </li>
            ))}
          </ul>
        </div>

        <SiteStats variant="panel" eyebrow="Site Signal" title="Live Metrics" />

        {showHomepagePet && (
          <div
            class="observatory-companion"
            aria-label={`YoRHa companion pet, ${homepagePetMood}`}
            role="button"
            tabindex="0"
            data-pet-mood={homepagePetMood}
            data-pet-default-mood={homepagePetMood}
            style={`--pet-row-offset: ${homepagePetRowOffset};`}
          >
            <div class="companion-pet" aria-hidden="true">
              <span class="companion-sprite companion-sprite--yorha"></span>
            </div>
          </div>
        )}
      </aside>
    </section>

    <!-- Activity Constellation -->
    <section class="activity">
      <div class="activity-header">
        <div>
          <p class="section-kicker">Activity Constellation</p>
          <h2>Signal Map</h2>
          <p class="activity-range">{activityRangeLabel}</p>
        </div>
        <div class="activity-stats">
          <span>{postSignalCount} posts</span>
          <span>{milestoneSignalCount} milestones</span>
          <span>{activeDays} active days</span>
        </div>
      </div>

      <div class="activity-panel">
        <div class="activity-chart">
          <div class="activity-map-frame">
            <div class="activity-map">
              <div class="activity-years" aria-hidden="true">
                {activityYearLabels.map((year) => (
                  <span>{year}</span>
                ))}
              </div>

              <div class="activity-months" aria-hidden="true">
                {activityMonthLabels.map((month) => (
                  <span>{month}</span>
                ))}
              </div>

              <div class="activity-calendar">
                <div class="activity-weekdays" aria-hidden="true">
                  {['', 'Mon', '', 'Wed', '', 'Fri', ''].map((day) => (
                    <span>{day}</span>
                  ))}
                </div>

                <div class="activity-grid" role="img" aria-label={activityLabel}>
                  {activityWeeks.map((week) => (
                    <div class="activity-week">
                      {week.map((day) => {
                        const titles = day.signals
                          .map((signal) => `${signal.displayDate} (${signal.dateSource}): ${signal.title}`)
                          .join(' / ');
                        const signalTypes = new Set(day.signals.map((signal) => signal.type));
                        const typeClass = signalTypes.size > 1
                          ? 'mixed'
                          : signalTypes.has('post')
                            ? 'post'
                            : signalTypes.has('milestone')
                              ? 'milestone'
                              : 'quiet';
                        const label = day.signals.length > 0
                          ? titles
                          : `${formatActivityDate(day.date)}: no signal`;

                        return (
                          <span
                            class={`activity-dot activity-dot--${day.intensity} activity-dot--${typeClass}`}
                            title={label}
                            aria-label={label}
                          />
                        );
                      })}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div class="activity-legend" aria-label="Activity signal types">
            <span><i class="activity-dot activity-dot--1 activity-dot--post"></i> Blog</span>
            <span><i class="activity-dot activity-dot--1 activity-dot--milestone"></i> Milestone</span>
            <span><i class="activity-dot activity-dot--2 activity-dot--mixed"></i> Mixed</span>
          </div>
          <p class="activity-source">Blog dates are exact; milestones use timeline months.</p>

          <div class="github-activity" aria-label="Live GitHub contribution chart" data-github-activity>
            <div class="github-activity-header">
              <span><Icon name="github" size={14} /> GitHub Contributions</span>
              <a href={githubProfileUrl} target="_blank" rel="noopener noreferrer">@{githubUsername}</a>
            </div>
            <a
              class="github-activity-frame"
              href={githubProfileUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div
                class="github-calendar"
                data-github-calendar
                data-username={githubUsername}
                data-start={toDateKey(gridStart)}
                data-end={toDateKey(gridEnd)}
                role="img"
                aria-label={`${githubUsername}'s GitHub contribution calendar`}
              ></div>
              <img
                class="github-activity-fallback"
                src={githubContributionChartUrl}
                alt={`${githubUsername}'s GitHub contribution calendar`}
                width="663"
                height="104"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            </a>
            <p class="github-activity-note">Live chart from GitHub contribution data.</p>
          </div>
        </div>

        <aside class="activity-log" aria-label="Recent activity signals">
          <p class="activity-log-title">Latest Signals</p>
          <ol>
            {recentSignals.map((signal) => (
              <li>
                <a href={signal.href}>
                  <span class={`activity-type activity-type--${signal.type}`}>
                    {signal.type === 'post' ? 'Blog' : 'Milestone'}
                  </span>
                  <span class="activity-log-main">
                    <time datetime={signal.datetime}>{signal.displayDate}</time>
                    <strong>{signal.title}</strong>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </aside>
      </div>
    </section>
    
    <!-- Featured Section -->
    <section class="featured">
      <div class="divider">
        <span class="divider-icon">◈</span>
      </div>
      
      <h2>Featured Works</h2>
      
      <div class="featured-grid">
        <a href="/projects#unity" class="featured-card">
          <div class="featured-icon"><Icon name="gamepad" size={28} /></div>
          <h3>Unity Projects</h3>
          <p>3D simulations, 2D platformers, and VR prototypes</p>
        </a>
        
        <a href="/projects#web" class="featured-card">
          <div class="featured-icon"><Icon name="globe" size={28} /></div>
          <h3>Web Development</h3>
          <p>Full-stack applications and interactive experiences</p>
        </a>
        
        <a href="/blog" class="featured-card">
          <div class="featured-icon"><Icon name="pen" size={28} /></div>
          <h3>Tech Blog</h3>
          <p>Development tutorials and learning notes</p>
        </a>
      </div>
    </section>
    
    <!-- Latest Posts Preview -->
    <section class="latest">
      <div class="divider">
        <Icon name="gear" size={20} class="divider-icon" />
      </div>
      
      <h2>Latest Posts</h2>
      
      <div class="posts-grid">
        {latestPosts.map((post) => (
          <a href={`/blog/${post.id}`} class="post-card">
            <div class="post-date">
              {new Date(post.data.date).toLocaleDateString('en-US', { 
                year: 'numeric', 
                month: 'short', 
                day: 'numeric' 
              })}
            </div>
            <h3 class="post-title">{post.data.title}</h3>
            <p class="post-excerpt">{getExcerpt(post.body)}</p>
          </a>
        ))}
      </div>
      
      <div class="posts-action">
        <a href="/blog" class="btn">
          <span>→</span> View All Posts
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    if (window.__shanGithubCalendarReady) return;
    window.__shanGithubCalendarReady = true;

    const API_ROOT = 'https://github-contributions-api.jogruber.de/v4/';
    const WEEKDAYS = ['', 'Mon', '', 'Wed', '', 'Fri', ''];
    const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });
    const dateFormatter = new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC',
    });

    function parseUTCDate(dateKey) {
      const [year, month, day] = dateKey.split('-').map(Number);
      return new Date(Date.UTC(year, month - 1, day));
    }

    function addDays(date, days) {
      const nextDate = new Date(date);
      nextDate.setUTCDate(nextDate.getUTCDate() + days);
      return nextDate;
    }

    function toDateKey(date) {
      return date.toISOString().slice(0, 10);
    }

    function buildWeeks(startKey, endKey, contributions) {
      const start = parseUTCDate(startKey);
      const end = parseUTCDate(endKey);
      const contributionByDate = new Map(
        contributions.map((item) => [item.date, item])
      );
      const days = [];

      for (let date = start; date <= end; date = addDays(date, 1)) {
        const key = toDateKey(date);
        days.push({
          date: new Date(date),
          key,
          contribution: contributionByDate.get(key) || { count: 0, level: 0 },
        });
      }

      const weeks = [];
      for (let index = 0; index < days.length; index += 7) {
        weeks.push(days.slice(index, index + 7));
      }

      return weeks;
    }

    function filterCrowdedLabels(labels, minGap = 3) {
      const filteredLabels = [...labels];
      let previousLabelIndex = -1;

      labels.forEach((label, index) => {
        if (!label) return;

        if (previousLabelIndex >= 0 && index - previousLabelIndex < minGap) {
          filteredLabels[previousLabelIndex] = '';
        }

        previousLabelIndex = index;
      });

      return filteredLabels;
    }

    function createLabelRow(className, weeks, getLabelDate, options = {}) {
      const row = document.createElement('div');
      row.className = className;
      row.setAttribute('aria-hidden', 'true');

      const labels = weeks.map((week, weekIndex) => {
        const labelDate = getLabelDate(week, weekIndex);
        return labelDate ? labelDate : '';
      });
      const visibleLabels = options.filterCrowded ? filterCrowdedLabels(labels) : labels;

      visibleLabels.forEach((labelText) => {
        const label = document.createElement('span');
        label.textContent = labelText;
        row.append(label);
      });

      return row;
    }

    function renderCalendar(root, weeks) {
      const years = createLabelRow('github-calendar-years', weeks, (week, weekIndex) => {
        const firstOfYear = week.find((day) => (
          day.date.getUTCMonth() === 0 && day.date.getUTCDate() === 1
        ));
        const labelDate = firstOfYear?.date || (weekIndex === 0 ? week[0]?.date : null);
        return labelDate ? String(labelDate.getUTCFullYear()) : '';
      });

      const months = createLabelRow('github-calendar-months', weeks, (week, weekIndex) => {
        const firstOfMonth = week.find((day) => day.date.getUTCDate() === 1);
        const labelDate = firstOfMonth?.date || (weekIndex === 0 ? week[0]?.date : null);
        return labelDate ? monthFormatter.format(labelDate) : '';
      }, { filterCrowded: true });

      const weekdays = document.createElement('div');
      weekdays.className = 'github-calendar-weekdays';
      weekdays.setAttribute('aria-hidden', 'true');
      WEEKDAYS.forEach((weekday) => {
        const label = document.createElement('span');
        label.textContent = weekday;
        weekdays.append(label);
      });

      const grid = document.createElement('div');
      grid.className = 'github-calendar-grid';
      weeks.forEach((week) => {
        const weekEl = document.createElement('div');
        weekEl.className = 'github-calendar-week';

        week.forEach((day) => {
          const count = Number(day.contribution.count) || 0;
          const level = Math.max(0, Math.min(4, Number(day.contribution.level) || 0));
          const cell = document.createElement('span');
          cell.className = `github-calendar-day github-calendar-day--${level}`;
          cell.title = `${dateFormatter.format(day.date)}: ${count} GitHub contribution${count === 1 ? '' : 's'}`;
          cell.setAttribute('aria-label', cell.title);
          weekEl.append(cell);
        });

        grid.append(weekEl);
      });

      const body = document.createElement('div');
      body.className = 'github-calendar-body';
      body.append(weekdays, grid);

      root.replaceChildren(years, months, body);
    }

    async function setupGithubCalendar(root) {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const username = root.dataset.username;
      const start = root.dataset.start;
      const end = root.dataset.end;
      const activity = root.closest('[data-github-activity]');
      if (!username || !start || !end || !activity) return;

      try {
        const response = await fetch(`${API_ROOT}${encodeURIComponent(username)}?y=last`);
        if (!response.ok) throw new Error(`GitHub contribution API returned ${response.status}`);
        const data = await response.json();
        if (!Array.isArray(data.contributions)) throw new Error('Invalid contribution payload');

        const weeks = buildWeeks(start, end, data.contributions);
        renderCalendar(root, weeks);
        activity.classList.add('is-enhanced');
        activity.classList.remove('is-fallback');
      } catch (error) {
        console.warn('GitHub contribution calendar fallback:', error);
        root.dataset.ready = 'false';
        activity.classList.remove('is-enhanced');
        activity.classList.add('is-fallback');
      }
    }

    function setupGithubCalendars() {
      document
        .querySelectorAll('[data-github-calendar]')
        .forEach((root) => setupGithubCalendar(root));
    }

    setupGithubCalendars();
    document.addEventListener('astro:page-load', setupGithubCalendars);
  })();
</script>

<script is:inline>
  (() => {
    if (window.__shanHomepagePetReady) return;
    window.__shanHomepagePetReady = true;

    const rowOffsets = {
      idle: '0%',
      waving: '12.5%',
      failed: '100%',
    };

    function setupHomepagePet(root) {
      if (!(root instanceof HTMLElement) || root.dataset.petReady === 'true') return;
      root.dataset.petReady = 'true';

      const defaultMood = root.dataset.petDefaultMood || 'idle';
      let restoreTimer = 0;
      let clickTimer = 0;
      let dragStartX = 0;
      let dragStartY = 0;
      let dragX = 0;
      let dragY = 0;
      let moved = false;
      let ignoredClick = false;

      function setMood(mood, options = {}) {
        const offset = rowOffsets[mood] || rowOffsets.idle;
        root.dataset.petMood = mood;
        root.style.setProperty('--pet-row-offset', offset);

        window.clearTimeout(restoreTimer);
        if (options.restoreAfter) {
          restoreTimer = window.setTimeout(() => {
            root.classList.remove('is-waving', 'is-failed');
            setMood(defaultMood);
          }, options.restoreAfter);
        }
      }

      function wave() {
        root.classList.remove('is-failed');
        root.classList.add('is-waving');
        setMood('waving', { restoreAfter: 1200 });
      }

      function fail() {
        root.classList.remove('is-waving');
        root.classList.add('is-failed');
        setMood('failed', { restoreAfter: 1600 });
      }

      function updateDrag() {
        root.style.setProperty('--pet-drag-x', `${dragX}px`);
        root.style.setProperty('--pet-drag-y', `${dragY}px`);
      }

      root.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        moved = false;
        dragStartX = event.clientX - dragX;
        dragStartY = event.clientY - dragY;
        root.classList.add('is-dragging');
        root.setPointerCapture?.(event.pointerId);
      });

      root.addEventListener('pointermove', (event) => {
        if (!root.classList.contains('is-dragging')) return;

        const nextX = event.clientX - dragStartX;
        const nextY = event.clientY - dragStartY;
        if (Math.abs(nextX - dragX) > 2 || Math.abs(nextY - dragY) > 2) {
          moved = true;
        }

        dragX = nextX;
        dragY = nextY;
        updateDrag();
      });

      function endDrag(event) {
        if (!root.classList.contains('is-dragging')) return;
        root.classList.remove('is-dragging');
        root.releasePointerCapture?.(event.pointerId);
        ignoredClick = moved;
      }

      root.addEventListener('pointerup', endDrag);
      root.addEventListener('pointercancel', endDrag);

      root.addEventListener('click', () => {
        if (ignoredClick) {
          ignoredClick = false;
          return;
        }

        window.clearTimeout(clickTimer);
        clickTimer = window.setTimeout(wave, 180);
      });

      root.addEventListener('dblclick', () => {
        window.clearTimeout(clickTimer);
        fail();
      });

      root.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          wave();
        }
      });

      setMood(defaultMood);
    }

    function setupHomepagePets() {
      document
        .querySelectorAll('.observatory-companion[data-pet-mood]')
        .forEach(setupHomepagePet);
    }

    setupHomepagePets();
    document.addEventListener('astro:page-load', setupHomepagePets);
  })();
</script>

