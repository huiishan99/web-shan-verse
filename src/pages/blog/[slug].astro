---
import type { CollectionEntry } from 'astro:content';
import BlogPostPage from '../../components/pages/BlogPostPage.astro';
import { defaultLocale, type Locale } from '../../i18n/config';
import { getBlogPostStaticPaths } from '../../utils/blog';

export async function getStaticPaths() {
  return getBlogPostStaticPaths(defaultLocale);
}

type Props = {
  post: CollectionEntry<'blog'>;
  alternateLocales: Locale[];
};

const { post, alternateLocales } = Astro.props;
---

<BlogPostPage post={post} lang={defaultLocale} alternateLocales={alternateLocales} />
