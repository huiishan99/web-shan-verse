---
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogPostPage from '../../components/pages/BlogPostPage.astro';
import { defaultLocale } from '../../i18n/config';
import { getPostSlug, isPostVisibleInLocale } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });

  return posts
    .filter((post) => isPostVisibleInLocale(post, defaultLocale))
    .map((post) => ({
      params: { slug: getPostSlug(post) },
      props: { post },
    }));
}

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
---

<BlogPostPage post={post} lang={defaultLocale} />
