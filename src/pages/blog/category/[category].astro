---
import type { CollectionEntry } from 'astro:content';
import BlogTaxonomyPage from '../../../components/pages/BlogTaxonomyPage.astro';
import { defaultLocale } from '../../../i18n/config';
import { getDefaultBlogTaxonomyStaticPaths } from '../../../utils/blog';

export async function getStaticPaths() {
  return getDefaultBlogTaxonomyStaticPaths('category');
}

type Props = {
  category: string;
  posts: CollectionEntry<'blog'>[];
};

const { category, posts } = Astro.props;
---

<BlogTaxonomyPage kind="category" value={category} posts={posts} lang={defaultLocale} />
