---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    // 在生产环境中排除草稿
    return import.meta.env.PROD ? data.draft !== true : true;
  });
  
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
const { Content } = await post.render();

// 格式化日期
const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={post.data.title}>
  <article class="blog-post">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        {post.data.categories && post.data.categories.length > 0 && (
          <span class="categories">
            {post.data.categories.map((cat: string) => (
              <a href={`/blog/category/${cat.toLowerCase().replace(/\s+/g, '-')}`} class="category">
                {cat}
              </a>
            ))}
          </span>
        )}
      </div>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag: string) => (
            <a href={`/blog/tag/${tag.toLowerCase().replace(/\s+/g, '-')}`} class="tag">
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    {post.data.deprecated && (
      <div class="deprecated-notice">
        <span class="deprecated-icon">⚠️</span>
        <div class="deprecated-content">
          <strong>Deprecated</strong>
          <p>{post.data.deprecatedReason || "This article is outdated and may no longer be accurate or relevant."}</p>
        </div>
      </div>
    )}

    {post.data.image && (
      <div class="featured-image">
        <img src={post.data.image} alt={post.data.title} />
      </div>
    )}

    <div class="post-content">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/blog" class="back-link">← Back to Blog</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .blog-post {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .deprecated-notice {
    display: flex;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: rgba(255, 160, 60, 0.1);
    border: 1px solid rgba(255, 160, 60, 0.3);
    border-left: 4px solid #ffa03c;
    border-radius: 6px;
    margin-bottom: 2rem;
  }

  .deprecated-icon {
    font-size: 1.5rem;
    line-height: 1;
    filter: grayscale(100%) sepia(100%) saturate(300%) hue-rotate(5deg) brightness(1.1);
  }

  .deprecated-content {
    flex: 1;
  }

  .deprecated-content strong {
    color: #ffa03c;
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.05em;
  }

  .deprecated-content p {
    margin: 0.25rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .post-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .post-meta time {
    color: var(--color-accent-gold);
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .category {
    background: rgba(201, 162, 39, 0.15);
    color: var(--color-accent-gold);
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    font-size: 0.85rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .category:hover {
    background: rgba(201, 162, 39, 0.3);
    color: var(--color-accent-copper);
  }

  .tags {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-family: var(--font-mono);
    text-decoration: none;
    padding: 0.2rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 3px;
    transition: all 0.2s ease;
  }

  .tag:hover {
    color: var(--color-accent-gold);
    border-color: var(--color-accent-gold);
    background: rgba(201, 162, 39, 0.1);
  }

  .featured-image {
    margin-bottom: 2rem;
    border-radius: 8px;
    overflow: hidden;
  }

  .featured-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .post-content {
    line-height: 1.8;
  }

  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-family: var(--font-display);
  }

  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .post-content :global(a) {
    color: var(--color-accent-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-content :global(a:hover) {
    color: var(--color-accent-copper);
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--color-accent-gold);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .post-content :global(code) {
    font-family: var(--font-mono);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .post-content :global(pre) {
    background: var(--color-bg-card);
    padding: 1rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    color: var(--color-accent-gold);
    text-decoration: none;
    font-family: var(--font-display);
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-accent-copper);
  }

  /* 手机端响应式布局 */
  @media (max-width: 768px) {
    .blog-post {
      padding: 0 1.25rem;
    }

    .post-header h1 {
      font-size: 1.75rem;
      line-height: 1.3;
    }

    .post-meta {
      font-size: 0.9rem;
      gap: 0.5rem;
    }

    .post-content {
      font-size: 1rem;
      line-height: 1.75;
    }

    .post-content :global(h2) {
      font-size: 1.4rem;
    }

    .post-content :global(h3) {
      font-size: 1.2rem;
    }

    .post-content :global(pre) {
      padding: 0.75rem;
      font-size: 0.85rem;
      margin-left: -0.5rem;
      margin-right: -0.5rem;
      border-radius: 0;
    }

    .post-content :global(img) {
      margin: 1rem -0.5rem;
      max-width: calc(100% + 1rem);
      border-radius: 0;
    }

    .tags {
      gap: 0.4rem;
    }

    .tag {
      font-size: 0.8rem;
      padding: 0.15rem 0.4rem;
    }
  }
</style>
