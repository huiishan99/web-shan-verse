---
import type { CollectionEntry } from 'astro:content';
import BlogTaxonomyPage from '../../../components/pages/BlogTaxonomyPage.astro';
import { defaultLocale } from '../../../i18n/config';
import { getDefaultBlogTaxonomyStaticPaths } from '../../../utils/blog';

export async function getStaticPaths() {
  return getDefaultBlogTaxonomyStaticPaths('tag');
}

type Props = {
  tag: string;
  posts: CollectionEntry<'blog'>[];
};

const { tag, posts } = Astro.props;
---

<BlogTaxonomyPage kind="tag" value={tag} posts={posts} lang={defaultLocale} />
