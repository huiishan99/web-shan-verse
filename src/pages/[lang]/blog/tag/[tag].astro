---
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogTaxonomyPage from '../../../../components/pages/BlogTaxonomyPage.astro';
import { translatedLocales, type Locale } from '../../../../i18n/config';
import { getTaxonomySlug, isPostVisibleInLocale } from '../../../../utils/blog';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });

  return translatedLocales.flatMap((lang) => {
    const posts = allPosts.filter((post) => isPostVisibleInLocale(post, lang));
    const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))];

    return tags.map((tag) => ({
      params: { lang, tag: getTaxonomySlug(tag) },
      props: {
        tag,
        lang,
        posts: posts
          .filter((post) => post.data.tags?.includes(tag))
          .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
      },
    }));
  });
}

type Props = {
  tag: string;
  posts: CollectionEntry<'blog'>[];
  lang: Locale;
};

const { tag, posts, lang } = Astro.props;
---

<BlogTaxonomyPage kind="tag" value={tag} posts={posts} lang={lang} />
