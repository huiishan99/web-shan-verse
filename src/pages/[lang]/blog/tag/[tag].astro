---
import type { CollectionEntry } from 'astro:content';
import BlogTaxonomyPage from '../../../../components/pages/BlogTaxonomyPage.astro';
import type { Locale } from '../../../../i18n/config';
import { getLocalizedBlogTaxonomyStaticPaths } from '../../../../utils/blog';

export async function getStaticPaths() {
  return getLocalizedBlogTaxonomyStaticPaths('tag');
}

type Props = {
  tag: string;
  posts: CollectionEntry<'blog'>[];
  lang: Locale;
};

const { tag, posts, lang } = Astro.props;
---

<BlogTaxonomyPage kind="tag" value={tag} posts={posts} lang={lang} />
