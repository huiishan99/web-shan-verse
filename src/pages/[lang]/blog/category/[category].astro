---
import type { CollectionEntry } from 'astro:content';
import BlogTaxonomyPage from '../../../../components/pages/BlogTaxonomyPage.astro';
import type { Locale } from '../../../../i18n/config';
import { getLocalizedBlogTaxonomyStaticPaths } from '../../../../utils/blog';

export async function getStaticPaths() {
  return getLocalizedBlogTaxonomyStaticPaths('category');
}

type Props = {
  category: string;
  posts: CollectionEntry<'blog'>[];
  lang: Locale;
};

const { category, posts, lang } = Astro.props;
---

<BlogTaxonomyPage kind="category" value={category} posts={posts} lang={lang} />
