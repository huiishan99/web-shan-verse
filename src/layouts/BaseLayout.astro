---
import { ClientRouter } from 'astro:transitions';
import StarField from '../components/StarField.astro';
import CustomCursor from '../components/CustomCursor.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import SiteStats from '../components/SiteStats.astro';
import { defaultLocale, localeNames, localeShortNames, locales, localizePath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

export interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
}

const { 
  title = 'SHAN-VERSE', 
  description,
  lang = defaultLocale,
} = Astro.props;

const t = useTranslations(lang);
const metaDescription = description ?? t.meta.description;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const pageTitle = title === 'SHAN-VERSE' ? title : `${title} | SHAN-VERSE`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const previewImage = new URL('/images/header_galaxy.jpg', siteUrl).toString();
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={metaDescription}>
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:site_name" content="SHAN-VERSE">
  <meta property="og:type" content="website">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={metaDescription}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={previewImage}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={metaDescription}>
  <meta name="twitter:image" content={previewImage}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Crimson+Pro:ital,wght@0,300;0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&family=LXGW+WenKai+TC&family=LXGW+WenKai&display=swap" rel="stylesheet">
  
  <title>{pageTitle}</title>
  <ClientRouter fallback="swap" />
</head>
<body>
  <!-- 互动式星空背景 -->
  <StarField />
  
  <!-- 自定义鼠标 + 星星粒子 -->
  <CustomCursor />
  <MusicPlayer />
  
  <div class="page-wrapper">
    <slot name="header">
      <header class="site-header">
        <div class="container">
          <nav class="nav">
            <a href={localizePath('/', lang)} class="logo">
              <span class="logo-symbol">✧</span>
              <span class="logo-text">SHAN-VERSE</span>
              <span class="logo-symbol">✧</span>
            </a>
            <ul class="nav-links">
              <li><a href={localizePath('/about', lang)}>{t.nav.about}</a></li>
              <li><a href={localizePath('/projects', lang)}>{t.nav.projects}</a></li>
              <li><a href={localizePath('/timeline', lang)}>{t.nav.timeline}</a></li>
              <li><a href={localizePath('/blog', lang)}>{t.nav.blog}</a></li>
            </ul>
            <div class="language-switcher" aria-label={t.nav.languageSwitcher}>
              {locales.map((locale) => (
                <a
                  href={localizePath(currentPath, locale)}
                  class:list={['language-link', { 'is-active': locale === lang }]}
                  aria-label={localeNames[locale]}
                  aria-current={locale === lang ? 'page' : undefined}
                  lang={locale}
                  title={localeNames[locale]}
                >
                  {localeShortNames[locale]}
                </a>
              ))}
            </div>
          </nav>
        </div>
      </header>
    </slot>
    
    <main class="main-content">
      <slot />
    </main>
    
    <footer class="site-footer">
      <div class="container">
        <div class="divider">
          <span class="divider-icon">⚙</span>
        </div>
        <div class="footer-content">
          <p class="footer-text">
            <span class="brass">◈</span> 
            {t.footer.crafted} · © 2024-2026 Lai HuiShan
            <span class="brass">◈</span>
          </p>
          <div class="footer-links">
            <a href="https://github.com/huiishan99" target="_blank" rel="noopener">GitHub</a>
            <span class="footer-sep">·</span>
            <a href="https://linkedin.com/in/laihuishan/" target="_blank" rel="noopener">LinkedIn</a>
            <span class="footer-sep">·</span>
            <a href="https://instagram.com/huii.shan.9/" target="_blank" rel="noopener">Instagram</a>
          </div>
          <SiteStats
            eyebrow={t.siteStats.eyebrow}
            title={t.siteStats.title}
            labels={t.siteStats}
          />
        </div>
      </div>
    </footer>
  </div>
</body>
</html>

<script>
  import { navigate } from 'astro:transitions/client';

  const globalWindow = window as typeof window & { __shanDelegatedNavigationReady?: boolean };

  if (!globalWindow.__shanDelegatedNavigationReady) {
    globalWindow.__shanDelegatedNavigationReady = true;

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const card = target.closest<HTMLElement>('[data-href]');
      if (!card) return;
      if (target.closest('a, button, input, select, textarea, label')) return;

      const href = card.dataset.href;
      if (!href) return;

      event.preventDefault();
      navigate(href);
    });
  }
</script>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation-duration: 120ms;
    animation-timing-function: ease-out;
  }

  :global(.starfield-interactive) {
    view-transition-name: none;
  }

  .page-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  
  .site-header {
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
    background: rgba(10, 10, 15, 0.8);
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-lg);
  }
  
  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text-primary);
    text-decoration: none;
    letter-spacing: 0.1em;
  }
  
  .logo:hover {
    color: var(--color-text-primary);
  }
  
  .logo-symbol {
    color: var(--color-brass);
    font-size: 0.875rem;
  }
  
  .nav-links {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin-left: auto;
  }
  
  .nav-links a {
    color: var(--color-text-secondary);
    font-size: 1rem;
    letter-spacing: 0.05em;
    padding: var(--space-xs) 0;
    position: relative;
  }
  
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-brass);
    transition: width 0.3s ease;
  }
  
  .nav-links a:hover {
    color: var(--color-text-primary);
  }

  .language-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.08rem;
    padding: 0.1rem;
    border: 1px solid rgba(201, 162, 39, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.025);
    opacity: 0.72;
    transition:
      opacity 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .language-switcher:hover,
  .language-switcher:focus-within {
    border-color: rgba(201, 162, 39, 0.22);
    background: rgba(255, 255, 255, 0.04);
    opacity: 1;
  }

  .language-link {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-width: 1.45rem;
    min-height: 1.25rem;
    padding: 0.08rem 0.3rem;
    border-radius: 999px;
    color: rgba(207, 205, 199, 0.52);
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.025em;
    line-height: 1.05;
    text-align: center;
    text-decoration: none;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .language-link:hover {
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.045);
  }

  .language-link.is-active {
    color: rgba(244, 238, 222, 0.92);
    background: rgba(201, 162, 39, 0.14);
  }

  .language-link[lang='zh'],
  .language-link[lang='ja'] {
    font-family: var(--font-cjk);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0;
  }
  
  .nav-links a:hover::after {
    width: 100%;
  }
  
  .main-content {
    flex: 1;
    padding: var(--space-xl) 0;
  }
  
  .site-footer {
    padding: var(--space-lg) 0;
    margin-top: auto;
  }
  
  .footer-content {
    text-align: center;
  }
  
  .footer-text {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  
  .footer-text .brass {
    color: var(--color-brass);
    opacity: 0.5;
  }
  
  .footer-links {
    margin-top: var(--space-sm);
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    font-size: 0.9rem;
  }
  
  .footer-links a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: #d4af37;
  }
  
  .footer-sep {
    color: var(--color-text-muted);
  }
  
  /* 移动端 */
  @media (max-width: 768px) {
    .nav {
      flex-direction: column;
      gap: var(--space-md);
    }
    
    .nav-links {
      gap: var(--space-md);
      margin-left: 0;
      flex-wrap: wrap;
      justify-content: center;
    }

    .language-switcher {
      align-self: center;
      margin-top: -0.15rem;
    }
  }
</style>
