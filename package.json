{
  "name": "shan-verse",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/project-links.test.mjs tests/site-stats.test.mjs",
    "check:links": "tsx scripts/check-project-links.mjs",
    "check:html": "node scripts/check-generated-html.mjs",
    "audit:prod": "npm audit --omit=dev",
    "verify": "npm run check && npm run lint && npm run test && npm run check:links && npm run build && npm run check:html && npm run audit:prod"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiishan99/web-blog.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/huiishan99/web-blog/issues"
  },
  "homepage": "https://shan-verse.com",
  "description": "Personal multilingual Astro site for essays, projects, timelines, and interactive experiments.",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.185.1",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.7.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "yaml-language-server": {
      "yaml": "2.9.0"
    }
  }
}
